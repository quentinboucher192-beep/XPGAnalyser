+          "un style, une ressource, un symbole, un en-t\xC3\xAAte rang\xC3\xA9s");
+    check(fold::addFolder(p, fold::List::Views, "Vide", &why), "un dossier vide existe tant qu'il est dans la liste");
+    // Le disque : format 19.
+    const auto files = serializeProject(p);
+    const FileReader reader = [&](const std::string& path, std::string& content) {
+        for (const auto& f : files)
+            if (f.path == path) { content.assign(f.data->begin(), f.data->end()); return true; }
+        return false;
+    };
+    const auto back = parseProject(reader);
+    check(static_cast<bool>(back), "le projet se relit");
+    if (back) {
+        check(back->views.size() == p.views.size() && back->view(p.views[4].id)->folder == "Cartes" && back->view(p.views[5].id)->folder == "Bandeaux",
+              "relus : le dossier des vues (symbole, en-t\xC3\xAAte)");
+        check(back->programs.scripts[0].folder == "Cycliques" && back->programs.types[0].folder == "Fours" && back->styles[0].folder == "Boutons"
+                  && back->assets.resources[0].folder == "Logos",
+              "relus : scripts, types, styles, ressources");
+        check(fold::allFolders(*back, fold::List::Views) == std::vector<std::string>{"Atelier", "Vide"}, "relus : les dossiers vides (Atelier, Vide)");
+        check(back->views[0].id == c, "relu : l'ordre des vues");
+    }
+    // Une commande le defait.
+    auto doc = std::make_shared<Document>();
+    doc->project = p;
+    core::CommandStack stack;
+    auto cmd = changeProject(doc, "Ranger", [&](Project& q) {
+        (void)fold::moveToFolder(q, fold::List::Views, {a, b}, "Atelier");
+        (void)fold::moveNear(q, fold::List::Views, {b}, c, false);
+    });
+    check(static_cast<bool>(cmd), "le rangement est une commande");
+    (void)stack.push(std::move(cmd));
+    check(doc->project.view(a)->folder == "Atelier" && doc->project.views[0].id == b, "faite : ranges, B en t\xC3\xAAte");
+    (void)stack.undo();
+    check(doc->project.view(a)->folder.empty() && doc->project.views[0].id == c && doc->project.views[1].id == a, "Ctrl+Z : tout revient (dossiers et ordre)");
+}
