+    check(lireTexte(dir / "sections" / "Matrice.st") == "(* matrice *)\nA := B;\nC := D;\n", "la section est revenue a V1");
+    if (auto c1 = ver::compare(*store, 1, 0)) check(c1->elements.empty(), "le disque est exactement V1");
+    // Un changement, puis restaurer V2 : "Avant restauration" d'abord.
+    ecrireTexte(dir / "sections" / "Matrice.st", "(* matrice *)\nA := B;\n");
+    auto back2 = ver::restore(*store, 2, "Quentin", "2026-09-26 12:20");
+    check(back2 && back2->has_value() && (*back2)->state == ver::State::BeforeRestore && (*back2)->number == 3,
+          "restaurer V2 apres un changement : V3 \"Avant restauration de V2\" d'abord");
+    check(lireTexte(dir / "sections" / "Matrice.st") == "(* matrice - revue *)\nA := B;\nC := D;\nE := F;\n", "la section de V2");
+
+    // Exporter en .zip, extraire dans un dossier.
+    const fs::path zip = fs::temp_directory_path() / "xpg_lot21_v1.zip";
+    fs::remove(zip);
+    check(static_cast<bool>(ver::exportZip(*store, 1, zip.string())) && lireTexte(zip).rfind("PK", 0) == 0, "V1 en .zip");
+    const fs::path out = fs::temp_directory_path() / "xpg_lot21_extrait";
+    fs::remove_all(out);
+    check(static_cast<bool>(ver::extract(*store, 1, out.string())) && lireTexte(out / "sections" / "Matrice.st") == "(* matrice *)\nA := B;\nC := D;\n"
+              && hmi::load(out.string()).has_value(),
+          "V1 extraite dans un dossier : un projet complet, son IHM se relit");
+    check(!ver::extract(*store, 1, out.string()), "extraire dans un dossier qui n'est pas vide : refuse");
+
+    // Supprimer V3 : ses objets orphelins s'en vont, les autres restent.
+    check(static_cast<bool>(ver::remove(*store, 3)) && store->versions.size() == 2 && !fs::exists(dir / "versions" / "V0003.txt"),
+          "supprimer V3");
+    if (auto f1 = ver::contentOf(*store, 1, "sections/Matrice.st")) check(*f1 == "(* matrice *)\nA := B;\nC := D;\n", "V1 se relit toujours");
