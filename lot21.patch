+std::size_t countIn(const Project& p, List list, std::string_view folder, bool deep) {
+    std::size_t n = 0;
+    for (const auto& i : items(p, list))
+        if (deep ? inside(i.folder, folder) : sameFolder(i.folder, folder)) ++n;
+    return n;
+}
