+    // La vue, objet par objet.
+    if (auto pa = ver::hmiOf(*store, 1); pa && !pa->views.empty()) {
+        const auto changes = ver::compareViews(pa->views[0], p.views[0]);
+        bool fill = false, added = false;
+        for (const auto& ch : changes) {
+            if (ch.change == ver::Change::Modified && ch.name == "Cadre")
+                for (const auto& pr : ch.props) fill = fill || pr == "Couleur de fond #2D3440 \xE2\x86\x92 #4A1F22";
