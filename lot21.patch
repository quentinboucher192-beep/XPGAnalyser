+    sym.role = "symbole";
+    p.views.push_back(sym);
+    View head = makeView(p, "Entete");
+    head.role = "entete";
+    p.views.push_back(head);
+    Script sc;
+    sc.id = p.allocate();
+    sc.name = "Demarrage";
+    sc.body = "x := 1;";
+    p.programs.scripts.push_back(sc);
+    HmiType ty;
+    ty.id = p.allocate();
+    ty.name = "T_Four";
+    p.programs.types.push_back(ty);
+    Style st;
+    st.id = p.allocate();
+    st.name = "Bouton_Vert";
+    p.styles.push_back(st);
+    Resource res;
+    res.id = p.allocate();
+    res.name = "logo.png";
+    res.format = "PNG";
+    p.assets.resources.push_back(res);
+    // Les messages : le participe accorde avec la liste (une vue rangee, des scripts ranges).
+    check(fold::agreed(fold::List::Views, 2, "rang\xC3\xA9") == "rang\xC3\xA9" "es"
+              && fold::agreed(fold::List::Resources, 1, "d\xC3\xA9plac\xC3\xA9") == "d\xC3\xA9plac\xC3\xA9" "e"
+              && fold::agreed(fold::List::Scripts, 3, "plac\xC3\xA9") == "plac\xC3\xA9s"
+              && fold::agreed(fold::List::Symbols, 1, "rang\xC3\xA9") == "rang\xC3\xA9",
+          "les messages s'accordent : vues rang\xC3\xA9" "es, ressource d\xC3\xA9plac\xC3\xA9" "e, scripts plac\xC3\xA9s, symbole rang\xC3\xA9");
+    const Id a = p.views[0].id, b = p.views[1].id, c = p.views[2].id, pp = p.views[3].id;
+
+    check(fold::listOfView(p.views[3]) == fold::List::Popups && fold::listOfView(p.views[4]) == fold::List::Symbols
+              && fold::listOfView(p.views[5]) == fold::List::Headers && fold::listOfView(p.views[0]) == fold::List::Views,
+          "la liste d'une vue suit son r\xC3\xB4le (popup, symbole, en-t\xC3\xAAte, vue)");
+    check(fold::items(p, fold::List::Views).size() == 3 && fold::items(p, fold::List::Popups).size() == 1, "les vues et les popups : deux listes");
+    std::string why;
+    check(fold::addFolder(p, fold::List::Views, "Ligne 1", &why) && fold::addFolder(p, fold::List::Views, "Ligne 1/Armoires", &why),
+          "deux dossiers (un dans l'autre)");
+    check(!fold::addFolder(p, fold::List::Views, "ligne 1", &why) && !why.empty(), "le m\xC3\xAAme nom (sans casse) : refus\xC3\xA9 (" + why + ")");
+    check(!fold::addFolder(p, fold::List::Views, "", &why), "un nom vide : refus\xC3\xA9");
+    check(fold::allFolders(p, fold::List::Popups).empty(), "les dossiers d'une liste ne sont pas ceux d'une autre");
+    check(fold::moveToFolder(p, fold::List::Views, {a, b, pp}, "Ligne 1/Armoires") == 2,
+          "ranger A et B (la popup n'est pas une vue : elle ne bouge pas)");
+    check(p.view(a)->folder == "Ligne 1/Armoires" && p.view(pp)->folder.empty(), "... A dans Ligne 1/Armoires, la popup \xC3\xA0 sa place");
+    check(fold::countIn(p, fold::List::Views, "Ligne 1", true) == 2 && fold::countIn(p, fold::List::Views, "Ligne 1", false) == 0,
+          "compter : 2 sous Ligne 1, 0 directement dedans");
+    check(fold::renameFolder(p, fold::List::Views, "Ligne 1", "Atelier", &why) && p.view(a)->folder == "Atelier/Armoires",
+          "renommer Ligne 1 en Atelier : ses vues et ses sous-dossiers suivent");
+    check(!fold::renameFolder(p, fold::List::Views, "Atelier", "Atelier/Armoires/X", &why), "un dossier ne va pas dans lui-m\xC3\xAAme");
+    check(fold::moveFolder(p, fold::List::Views, "Atelier/Armoires", "", &why) && p.view(b)->folder == "Armoires",
+          "d\xC3\xA9placer Armoires \xC3\xA0 la racine : ses vues suivent");
+    const auto all = fold::allFolders(p, fold::List::Views);
+    check(all == std::vector<std::string>{"Armoires", "Atelier"}, "les dossiers, tri\xC3\xA9s (Armoires, Atelier)");
+    // Reordonner : C avant A, dans le dossier de A.
+    check(fold::moveNear(p, fold::List::Views, {c}, a, false) && p.views[0].id == c && p.views[1].id == a && p.view(c)->folder == "Armoires",
+          "C plac\xC3\xA9" "e avant A, dans son dossier (l'ordre du projet change)");
+    check(!fold::moveNear(p, fold::List::Views, {a}, a, true), "pas avant ou apr\xC3\xA8s elle-m\xC3\xAAme");
+    check(p.views[3].id == pp && p.views[3].role == "popup", "les autres r\xC3\xB4les gardent leur place");
+    // Supprimer un dossier : ses elements remontent d'un cran.
+    check(fold::removeFolder(p, fold::List::Views, "Armoires") && p.view(a)->folder.empty() && p.view(c)->folder.empty(),
+          "supprimer Armoires : ses vues remontent \xC3\xA0 la racine");
+    // Les autres listes.
+    check(fold::addFolder(p, fold::List::Scripts, "Cycliques", &why) && fold::moveToFolder(p, fold::List::Scripts, {sc.id}, "Cycliques") == 1
+              && p.programs.scripts[0].folder == "Cycliques",
+          "un script rang\xC3\xA9 (Cycliques)");
+    check(fold::moveToFolder(p, fold::List::Types, {ty.id}, "Fours") == 1 && fold::allFolders(p, fold::List::Types) == std::vector<std::string>{"Fours"},
