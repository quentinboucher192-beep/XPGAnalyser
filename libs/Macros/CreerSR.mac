(* CreerSR

   UNE SOUS-ROUTINE N'A PAS DE PARAMETRES. C'est la chose a savoir avant tout
   le reste : on ne peut pas ecrire MaSR(a := 1, b => r). Les arguments et les
   retours passent par des VARIABLES CONVENUES, que l'appelant remplit avant
   l'appel et relit apres.

   Cette macro cree donc trois choses d'un coup : la sous-routine, ses
   variables d'entree, et ses variables de sortie - nommees de la meme maniere,
   pour qu'on voie a leur nom a quoi elles servent.

       MaSR_In_<nom>    ce que l'appelant remplit avant
       MaSR_Out_<nom>   ce qu'il relit apres

   La convention n'est pas jolie, elle est LISIBLE : six mois plus tard, un
   Ctrl+F sur MaSR_ donne toute l'interface de la sous-routine.

   #! summary = Crée une sous-routine et les variables convenues qui lui servent d'entrées et de sorties.
   #! version = 1.10
   #! changes 1.10 = Le formulaire : chaque question a son champ (le classeur par …, Ctrl+V ou en le glissant ; les tâches et les sections du projet ; des interrupteurs ; des choix à libellés), ses groupes, son aide et un libellé avec accents. Le code ne change pas. Les entrées et les sorties se donnent une par ligne.
   #! usage = UNE SOUS-ROUTINE N'A PAS DE PARAMETRES. C'est la chose a savoir avant tout le reste : on ne peut pas ecrire MaSR(a := 1, b => r). Les arguments et les retours passent par des VARIABLES CONVENUES, que l'appelant remplit avant l'appel et relit apres.
   #! usage = La convention est MaSR_In_<nom> pour ce que l'appelant pose, MaSR_Out_<nom> pour ce qu'il relit. Elle n'est pas jolie, elle est LISIBLE : six mois plus tard, un Ctrl+F sur MaSR_ donne toute l'interface de la sous-routine.
   #! usage = Si un nom de section existe deja SANS etre une sous-routine, la macro s'arrete. Une section tourne a chaque cycle, une SR seulement quand on l'appelle : les echanger changerait le programme.
   #! usage = Une macro se relance. C'est la regle de toutes celles-ci : relancee sur un projet ou elle a deja tourne, elle ne doit rien casser et rien dupliquer. C'est pour ca qu'elles testent avant de creer, et qu'elles disent "existe deja" au lieu de s'arreter.
   #! usage = Les questions arrivent par TOURS. Ask() enregistre une question, AskNow() les pose. Une macro coupe ses tours la ou une reponse decide des questions suivantes : demander les quatre noms de section quand on vient de repondre "une seule famille" remplirait l'ecran de champs qu'on laisserait vides.
   #! example = CreerSR : nom = Regul_Niveau, entrees = consigne:REAL, mesure:REAL, sorties = commande:REAL
   #! see = AppelerSR, EnsureSection, GenererModes
   #! param nom = Il préfixe ses variables : court se relit mieux.
   #! param nom = Le nom de la sous-routine. Il prefixe aussi toutes ses variables, donc un nom court se relit mieux : Regul_Niveau_In_consigne est deja long.
   #! param tache = Une SR n'y tourne pas seule : elle attend d'être appelée.
   #! param tache = La tache d'accueil, MAST en general. Une SR n'y tourne pas toute seule : elle attend d'etre appelee.
   #! param entrees = Une par ligne : nom:TYPE (consigne:REAL).
   #! param entrees = La liste des entrees, sous la forme nom:TYPE, separees par des virgules : consigne:REAL, mesure:REAL.
   #! param entrees = Les espaces autour sont retires. Un element sans deux-points est signale et saute - le reste de la liste est quand meme traite.
   #! param sorties = Une par ligne : nom:TYPE, relues après l'appel.
   #! param sorties = Meme forme que les entrees. Ce que la sous-routine pose et que l'appelant relit apres l'appel.
   #! categorie = Créer
   #! champ nom = nom
   #! libelle nom = Nom de la sous-routine
   #! champ tache = tache
   #! libelle tache = Tâche d'accueil
   #! champ entrees = liste facultatif
   #! libelle entrees = Entrées
   #! champ sorties = liste facultatif
   #! libelle sorties = Sorties
   #! exemple nom = {}_In_consigne, {}_Out_commande
   #! produit = une sous-routine vide et les variables d'entrée et de sortie convenues
   #! appliquer = Créer la sous-routine {nom}
*)

nom    := Ask('nom', 'Nom de la sous-routine', '');
tache  := Ask('tache', 'Tache', 'MAST');
AskNow();

entrees := Ask('entrees', 'Variables d entree, separees par des virgules (nom:type)', '');
sorties := Ask('sorties', 'Variables de sortie, meme forme', '');
AskNow();

IF nom = '' THEN
    Fail('aucun nom donne');
END_IF;

IF SectionExists(nom) THEN
    IF IsSubroutine(nom) THEN
        Log('la sous-routine ' + nom + ' existe deja');
    ELSE
        Fail(nom + ' existe deja, mais c est une SECTION, pas une sous-routine. '
             + 'Une section tourne a chaque cycle ; les remplacer l une par l autre '
             + 'changerait le programme.');
    END_IF;
ELSE
    AddSubroutine(nom, tache);
    Log('sous-routine ' + nom + ' creee');
END_IF;

(* Les variables. Une liste 'niveau:REAL, marche:BOOL' se decoupe ici : le
   langage n'a pas de tableau, donc on avance a la virgule. *)
FOR sens := 0 TO 1 DO
    IF sens = 0 THEN
        liste := entrees;
        prefixe := nom + '_In_';
    ELSE
        liste := sorties;
        prefixe := nom + '_Out_';
    END_IF;

    depart := 0;
    WHILE depart < LEN(liste) DO
        virgule := FIND(liste, ',', depart);
        IF virgule < 0 THEN
            morceau := MID(liste, depart);
            depart := LEN(liste);
        ELSE
            morceau := MID(liste, depart, virgule - depart);
            depart := virgule + 1;
        END_IF;

        deuxPoints := FIND(morceau, ':', 0);
        IF deuxPoints < 0 THEN
            IF LEN(morceau) > 0 THEN
                Warn('"' + morceau + '" : il manque le type, attendu nom:TYPE');
            END_IF;
        ELSE
            champ := MID(morceau, 0, deuxPoints);
            typeChamp := MID(morceau, deuxPoints + 1);
            (* Les espaces autour se retirent a la main : le langage n'a pas de
               TRIM, et ' niveau' n'est pas un nom de variable valide. *)
            WHILE LEN(champ) > 0 AND MID(champ, 0, 1) = ' ' DO
                champ := MID(champ, 1);
            END_WHILE;
            WHILE LEN(typeChamp) > 0 AND MID(typeChamp, 0, 1) = ' ' DO
                typeChamp := MID(typeChamp, 1);
            END_WHILE;

            IF champ = '' OR typeChamp = '' THEN
                Warn('"' + morceau + '" : nom ou type vide, ignore');
            ELSE
                complet := prefixe + champ;
                IF VariableExists(complet) THEN
                    Log(complet + ' existe deja');
                ELSE
                    AddVariable(complet, typeChamp, 'Global', '');
                    Log(complet + ' : ' + typeChamp);
                END_IF;
            END_IF;
        END_IF;
    END_WHILE;
END_FOR;
