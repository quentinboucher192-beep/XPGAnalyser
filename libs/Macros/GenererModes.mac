(* GenererModes

   Ecrit la section qui fait tourner les modes. Elle se lit en deux moitiees,
   et la separation est le coeur de l'affaire :

     DFB_MODE_MANAGER decide QUEL mode est actif. C'est de la donnee - une
     condition, une priorite, un temps minimum - et ca vit dans un DDT.

     CETTE SECTION decide CE QUI TOURNE dans chaque mode. C'est une suite de
     noms de sous-routines dans un ORDRE, et une suite ordonnee de noms ne se
     range pas dans un DDT. C'est du code, et il faut donc l'ecrire.

   Ce que la macro produit :

       GestionModes(Count := 4, CycleMs := 20, Def := Modes, ...);

       CASE Mode_Courant OF
           0:  Init_Systeme();
               Acquisition();
           1:  Acquisition();
               Production();
       END_CASE;

   Relancee, elle REECRIT la section entiere plutot que d'y ajouter : une
   section de modes a moitie ancienne et a moitie nouvelle est pire que les
   deux.

   #! summary = Génère la section qui fait tourner les modes de marche : l'appel du gestionnaire, puis le CASE des sous-routines.
   #! version = 1.10
   #! changes 1.10 = Le formulaire : chaque question a son champ (le classeur par …, Ctrl+V ou en le glissant ; les tâches et les sections du projet ; des interrupteurs ; des choix à libellés), ses groupes, son aide et un libellé avec accents. Le code ne change pas. Les sous-routines d'un mode se donnent une par ligne, choisies parmi celles du projet.
   #! changes 1.01 = Les appels de sous-routine s'ecrivent Nom(); - "Nom;" seul ne compilait pas. Le mode courant et le precedent naissent a -1, comme DFB_MODE_MANAGER le demande : a 0, il croyait le mode 0 deja en cours. La periode vaut Horloge.DtMs quand l'horloge existe. Nouvelles questions tache, modeRepli et forcePrio (les cles d ImporterControle) ; la section est rangee par RangerSections.
   #! usage = La section se lit en deux moities, et la separation est le coeur de l'affaire. DFB_MODE_MANAGER decide QUEL mode est actif : c'est de la donnee - une condition, une priorite, un temps minimum - et ca vit dans un DDT.
   #! usage = CETTE SECTION decide CE QUI TOURNE dans chaque mode : c'est une suite de noms de sous-routines dans un ORDRE, et une suite ordonnee de noms ne se range pas dans un DDT. C'est du code, et il faut donc l'ecrire.
   #! usage = RELANCEE, ELLE REECRIT LA SECTION ENTIERE plutot que d'y ajouter. Une section de modes a moitie ancienne et a moitie nouvelle est pire que les deux. Ce qui a ete ajoute a la main dans cette section sera perdu.
   #! usage = LES QUESTIONS PAR MODE N'APPARAISSENT PAS DANS CETTE LISTE. Leurs cles sont calculees dans une boucle (m0nom, m0sr, m1nom...), donc l'aide ne peut pas les nommer d'avance. Pour chaque mode, la macro demande son nom et la liste de ses sous-routines separees par des virgules, dans l'ordre d'appel.
   #! usage = Les conditions d'entree dans un mode se calculent AILLEURS et arrivent ici par <table>[i].Req.
   #! usage = Une macro se relance. C'est la regle de toutes celles-ci : relancee sur un projet ou elle a deja tourne, elle ne doit rien casser et rien dupliquer. C'est pour ca qu'elles testent avant de creer, et qu'elles disent "existe deja" au lieu de s'arreter.
   #! usage = Les questions arrivent par TOURS. Ask() enregistre une question, AskNow() les pose. Une macro coupe ses tours la ou une reponse decide des questions suivantes : demander les quatre noms de section quand on vient de repondre "une seule famille" remplirait l'ecran de champs qu'on laisserait vides.
   #! example = GestionModes(Count := 4, CycleMs := Horloge.DtMs, Def := Modes, ...);
   #! example = CASE Mode_Courant OF
   #! example = 0:  Init_Systeme();
   #! example = Acquisition();
   #! example = 1:  Acquisition();
   #! example = Production();
   #! example = END_CASE;
   #! usage = LE MODE COURANT NAIT A -1, et le precedent aussi : c'est ce qui fait choisir le premier mode sans attendre de temps minimum. Une variable deja la n'est pas retouchee - verifiez sa valeur initiale si elle vient d'ailleurs.
   #! usage = ImporterControle fait le meme travail depuis l'onglet Modes du classeur, conditions comprises. GenererModes est pour un projet sans classeur : les conditions (Req) restent a ecrire.
   #! see = CreerSR, AppelerSR, EnsureSection, ImporterControle, RangerSections
   #! param section = Écrasée à chaque exécution : n'y écris rien à la main.
   #! param section = La section generee. Elle est ECRASEE a chaque execution : n'y ecrivez rien a la main.
   #! param table = ARRAY[0..15] OF ST_MODE_Def ; créé s'il manque.
   #! param table = Le tableau ARRAY[0..15] OF ST_MODE_Def qui porte la definition des modes. Cree s'il n'existe pas. C'est la que se posent les conditions d'entree, les priorites et les temps minimum.
   #! param instance = L'instance de DFB_MODE_MANAGER ; créée si elle manque.
   #! param instance = Le nom de l'instance de DFB_MODE_MANAGER. Creee si elle n'existe pas.
   #! param courant = Un INT ; la macro crée aussi <courant>_Prec et <courant>_Ms.
   #! param courant = La variable INT qui porte le mode actif. La macro cree aussi <courant>_Prec et <courant>_Ms, que le gestionnaire remplit : le mode precedent, et depuis combien de temps on est dans celui-ci.
   #! param combien = Autant de fois « son nom » et « ses sous-routines » ci-dessous.
   #! param combien = Le nombre de modes, de 1 a 16. C'est aussi le nombre de tours de questions qui suivent : un par mode.
   #! param cycle = Ou Horloge.DtMs, proposé quand l'horloge existe.
   #! param cycle = La periode de la tache en ms, ou Horloge.DtMs (propose quand l'horloge existe : c'est le temps reel du cycle). Elle sert au gestionnaire a compter les temps. Une valeur fausse ici fausse tous les temporisateurs de modes.
   #! param tache = La tâche de la section des modes.
   #! param tache = La tache d'accueil de la section, MAST en general.
   #! param modeRepli = Le mode pris quand aucune condition n'est vraie.
   #! param modeRepli = Le mode pris quand aucune condition n'est vraie. -1 : aucun, le mode courant reste.
   #! param forcePrio = À partir de cette priorité, un mode passe malgré le temps minimum du mode en cours.
   #! param forcePrio = A partir de cette priorite, un mode passe malgre le temps minimum du mode en cours : un arret d'urgence n'attend pas.
   #! param m*nom = Ce que l'IHM affiche pour ce mode.
   #! param m*sr = Une par ligne, dans l'ordre d'appel.
   #! categorie = Générer
   #! champ section = section nouvelle
   #! libelle section = Section des modes
   #! champ tache = tache
   #! libelle tache = Tâche d'accueil
   #! champ table = nom
   #! libelle table = Tableau des modes
   #! champ instance = nom
   #! libelle instance = Instance du gestionnaire
   #! champ courant = nom
   #! libelle courant = Variable du mode courant
   #! champ combien = nombre 1..16
   #! libelle combien = Combien de modes
   #! champ cycle = texte
   #! libelle cycle = Période de la tâche, en ms
   #! champ modeRepli = nombre -1..15 : -1 aucun
   #! libelle modeRepli = Mode de repli
   #! champ forcePrio = nombre 0..32767
   #! libelle forcePrio = Priorité qui passe outre le temps minimum
   #! champ m*nom = nom
   #! libelle m*nom = Mode {} : son nom
   #! champ m*sr = liste sous-routine facultatif
   #! libelle m*sr = Mode {} : ses sous-routines
   #! groupe Le gestionnaire = section, tache, table, instance, courant, cycle
   #! groupe Les modes = combien, modeRepli, forcePrio
   #! groupe Chaque mode = m*nom, m*sr
   #! avance = table, instance, courant, cycle, forcePrio
   #! produit = la section des modes : l'appel de DFB_MODE_MANAGER, puis le CASE des sous-routines
   #! appliquer = Réécrire la section {section} entièrement
*)

defCycle := Setting('Periode (ms)');
IF defCycle = '' THEN defCycle := '20'; END_IF;
IF VariableExists('Horloge') THEN defCycle := 'Horloge.DtMs'; END_IF;

section  := Ask('section', 'Nom de la section des modes', 'Modes');
tache    := Ask('tache', 'Tache d accueil des sections', 'MAST');
table    := Ask('table', 'Nom du tableau de modes', 'Modes');
instance := Ask('instance', 'Nom de l instance du gestionnaire', 'GestionModes');
courant  := Ask('courant', 'Variable du mode courant', 'Mode_Courant');
combien  := AskNumber('combien', 'Combien de modes ?', 1, 16, '4');
cycle    := Ask('cycle', 'Periode de la tache, en ms (ou Horloge.DtMs)', defCycle);
repli    := AskNumber('modeRepli', 'Mode de repli quand aucune condition n est vraie (-1 : aucun)', -1, 15, '0');
prio     := AskNumber('forcePrio', 'Priorite qui passe outre le temps minimum', 0, 32767, '100');
AskNow();

n := REAL_TO_INT(combien);

(* Les noms et les appels, un tour de questions par mode. Poser les seize d'un
   coup quand on en veut quatre remplirait l'ecran de champs vides. *)
FOR m := 0 TO n - 1 DO
    cle := 'm' + DINT_TO_STRING(m);
    nomMode := Ask(cle + 'nom', 'Mode ' + DINT_TO_STRING(m) + ' : son nom',
                   'MODE' + DINT_TO_STRING(m));
    appels := Ask(cle + 'sr', 'Mode ' + DINT_TO_STRING(m)
                  + ' : sous-routines a appeler, dans l ordre, separees par des virgules', '');
END_FOR;
AskNow();

IF NOT TypeExists('ST_MODE_Def') AND LibHasItem('ST_MODE_Def') THEN
    LibImport('ST_MODE_Def');
END_IF;
IF NOT PouExists('DFB_MODE_MANAGER') AND LibHasItem('DFB_MODE_MANAGER') THEN
    LibImport('DFB_MODE_MANAGER');
END_IF;

IF NOT VariableExists(table) THEN
    AddVariable(table, 'ARRAY[0..15] OF ST_MODE_Def', 'Global', '');
END_IF;
IF NOT VariableExists(instance) THEN
    AddVariable(instance, 'DFB_MODE_MANAGER', 'Global', '');
END_IF;
(* -1 : DFB_MODE_MANAGER choisit alors le premier mode sans attendre de temps
   minimum. A 0, il croyait le mode 0 deja en cours. *)
IF NOT VariableExists(courant) THEN
    AddVariable(courant, 'INT', 'Global', '', '-1', 'le mode actif : -1 tant qu aucun n est choisi');
END_IF;
IF NOT VariableExists(courant + '_Prec') THEN
    AddVariable(courant + '_Prec', 'INT', 'Global', '', '-1', 'le mode d avant le dernier changement');
END_IF;
IF NOT VariableExists(courant + '_Ms') THEN
    AddVariable(courant + '_Ms', 'DINT', 'Global', '', '0', 'depuis combien de temps on est dans ce mode');
END_IF;

IF NOT SectionExists(section) THEN
    AddSection(section, tache, 'ST', '');
END_IF;

ClearSection(section);
AppendToSection(section, '(* Section generee par la macro GenererModes.');
AppendToSection(section, '   Les conditions d entree se calculent AILLEURS et');
AppendToSection(section, '   arrivent ici par ' + table + '[i].Req. *)');
AppendToSection(section, '');
AppendToSection(section, instance + '(Count := ' + DINT_TO_STRING(n)
    + ', CycleMs := ' + cycle + ', FallbackMode := ' + DINT_TO_STRING(REAL_TO_INT(repli))
    + ', ForcePriority := ' + DINT_TO_STRING(REAL_TO_INT(prio)) + ',');
AppendToSection(section, '    Def := ' + table
    + ', Current := ' + courant + ', PrevMode := ' + courant + '_Prec'
    + ', CurrentMs := ' + courant + '_Ms);');
AppendToSection(section, '');
AppendToSection(section, 'CASE ' + courant + ' OF');

vides := 0;
FOR m := 0 TO n - 1 DO
    cle := 'm' + DINT_TO_STRING(m);
    nomMode := Ask(cle + 'nom', '', 'MODE' + DINT_TO_STRING(m));
    appels := Ask(cle + 'sr', '', '');

    AppendToSection(section, '    ' + DINT_TO_STRING(m) + ':  (* ' + nomMode + ' *)');

    depart := 0;
    poses := 0;
    WHILE depart < LEN(appels) DO
        virgule := FIND(appels, ',', depart);
        IF virgule < 0 THEN
            sr := MID(appels, depart);
            depart := LEN(appels);
        ELSE
            sr := MID(appels, depart, virgule - depart);
            depart := virgule + 1;
        END_IF;
        WHILE LEN(sr) > 0 AND MID(sr, 0, 1) = ' ' DO
            sr := MID(sr, 1);
        END_WHILE;

        IF sr <> '' THEN
            IF NOT SectionExists(sr) THEN
                (* Ecrite quand meme, et signalee : refuser tout le mode parce
                   qu'une SR n est pas encore creee obligerait a les creer dans
                   un ordre impose. *)
                Warn('mode ' + nomMode + ' : la sous-routine ' + sr
                     + ' n existe pas encore');
            ELSIF NOT IsSubroutine(sr) THEN
                Warn('mode ' + nomMode + ' : ' + sr + ' est une SECTION. Elle tourne '
                     + 'deja a chaque cycle, l appeler ici la ferait tourner deux fois.');
            END_IF;
            (* un appel de SR : Nom(); - "Nom;" seul ne compile pas *)
            AppendToSection(section, '        ' + sr + '();');
            poses := poses + 1;
        END_IF;
    END_WHILE;

    IF poses = 0 THEN
        AppendToSection(section, '        ;   (* rien a faire dans ce mode *)');
        vides := vides + 1;
    END_IF;
END_FOR;

AppendToSection(section, 'END_CASE;');

IF vides > 0 THEN
    Warn(DINT_TO_STRING(vides) + ' mode(s) n appellent aucune sous-routine.');
END_IF;
RunMacro('RangerSections');
Log('section ' + section + ' generee pour ' + DINT_TO_STRING(n) + ' mode(s)');
