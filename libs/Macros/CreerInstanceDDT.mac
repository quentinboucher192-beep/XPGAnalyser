(* CreerInstanceDDT

   Une instance de DDT est une variable dont le type est un DDT. Le type doit
   donc exister AVANT : c'est pour ca que cette macro l'importe au besoin plutot
   que de laisser la creation echouer avec un message sur un type inconnu.

   #! summary = Déclare une variable d'un type dérivé, seule ou en tableau, en important le type au besoin.
   #! version = 1.10
   #! changes 1.10 = Le formulaire : chaque question a son champ (le classeur par …, Ctrl+V ou en le glissant ; les tâches et les sections du projet ; des interrupteurs ; des choix à libellés), ses groupes, son aide et un libellé avec accents. Le code ne change pas.
   #! usage = Une instance de DDT est une variable dont le type est un DDT. Le type doit donc exister AVANT. C'est pour ca que cette macro l'importe plutot que de laisser la creation echouer sur un message parlant d'un type inconnu.
   #! usage = Le tableau est la forme normale ici : les blocs de la bibliotheque traitent des tableaux d'equipements, pas des variables isolees.
   #! usage = Une macro se relance. C'est la regle de toutes celles-ci : relancee sur un projet ou elle a deja tourne, elle ne doit rien casser et rien dupliquer. C'est pour ca qu'elles testent avant de creer, et qu'elles disent "existe deja" au lieu de s'arreter.
   #! usage = Les questions arrivent par TOURS. Ask() enregistre une question, AskNow() les pose. Une macro coupe ses tours la ou une reponse decide des questions suivantes : demander les quatre noms de section quand on vient de repondre "une seule famille" remplirait l'ecran de champs qu'on laisserait vides.
   #! example = CreerInstanceDDT : type = ST_EQ_Motor, nom = Moteurs, tableau de 16
   #! see = CreerInstanceDFB, EnsureLibraryItem, CreerVariable
   #! param type = Du projet, ou de la bibliothèque : il est alors importé.
   #! param type = Le type derive : ST_IO_Ana, ST_EQ_Motor, ST_ALM_Def.
   #! param type = Absent du projet, il est importe de la bibliotheque. Absent des deux, la macro s'arrete en le disant.
   #! param nom = Toujours globale : l'IHM et plusieurs sections la lisent.
   #! param nom = Le nom de la variable creee. Elle est toujours GLOBALE : un tableau d'equipements est lu par l'IHM et par plusieurs sections.
   #! param combien = Un tableau doit avoir la taille qu'attend le bloc qui le traite.
   #! param combien = Une seule variable, ou un tableau.
   #! param combien = La taille du tableau doit correspondre a celle attendue par le bloc qui le traite : DFB_EQ_MOTOR travaille sur ARRAY[0..15]. Un tableau plus petit ne se branchera pas.
   #! param taille = Le tableau va de 0 à taille - 1.
   #! param taille = Le nombre d'elements, quand c'est un tableau. Le tableau va de 0 a taille-1.
   #! categorie = Créer
   #! champ type = ddt
   #! libelle type = Type dérivé
   #! champ nom = nom
   #! libelle nom = Nom de la variable
   #! champ combien = choix
   #! libelle combien = Une seule, ou un tableau
   #! champ taille = nombre 1..256
   #! libelle taille = Nombre d'éléments
   #! produit = une variable globale de ce type, seule ou en tableau ; le type importé au besoin
   #! appliquer = Créer {nom}
*)

type := Ask('type', 'Quel type derive ?', 'ST_IO_Ana');
nom  := Ask('nom', 'Nom de l instance', '');
combien := AskChoice('combien', 'Une seule ou un tableau ?', 'Une seule,Un tableau',
                     'Une seule');
AskNow();

IF combien = 'Un tableau' THEN
    taille := AskNumber('taille', 'Combien d elements ?', 1, 256, '8');
END_IF;

IF nom = '' THEN
    Fail('aucun nom donne');
END_IF;

IF NOT TypeExists(type) THEN
    IF LibHasItem(type) THEN
        Log('import du type ' + type);
        LibImport(type);
    ELSE
        Fail('le type ' + type + ' n existe pas et la bibliotheque ne le propose pas');
    END_IF;
END_IF;

IF VariableExists(nom) THEN
    Log(nom + ' existe deja');
ELSIF combien = 'Un tableau' THEN
    AddVariable(nom, 'ARRAY[0..' + DINT_TO_STRING(REAL_TO_INT(taille) - 1) + '] OF ' + type,
                'Global', '');
    Log(nom + ' : tableau de ' + DINT_TO_STRING(REAL_TO_INT(taille)) + ' ' + type);
ELSE
    AddVariable(nom, type, 'Global', '');
    Log(nom + ' : ' + type);
END_IF;
