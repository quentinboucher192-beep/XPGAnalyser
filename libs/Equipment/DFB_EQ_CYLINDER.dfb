# Derived function block, shared.
name = DFB_EQ_CYLINDER
version = 1.02
#! summary = Un verin : sortie, rentree, deux capteurs, monostable ou bistable.
#! usage = UNE INSTANCE TRAITE SEIZE EQUIPEMENTS, et cette taille est dans la signature
#! usage = du bloc : en changer touche toutes les instances de tous les projets qui
#! usage = l'ont importe. Seize suffit pour une station ; au-dela, on declare une
#! usage = deuxieme instance.
#! usage = Appeler une fois par cycle, apres les voies d'entree et avant les reports
#! usage = vers l'IHM : le bloc lit ce que les voies ont ecrit, et ecrit ce que les
#! usage = reports vont lire.
#! example = (* declarer : Verins : ARRAY[0..15] OF ST_EQ_Cylinder; *)
#! example = Verins[0].FdcExtended  := CarteDI_R0S4[10].Val;
#! example = Verins[0].FdcRetracted := CarteDI_R0S4[11].Val;
#! example = Verins[0].Monostable   := TRUE;
#! example = Verins[0].ExtendReq    := SortirPoussoir;   (* votre sequence *)
#! example = 
#! example = VER_Poste(Count := 8, CycleMs := 20, Eq := Verins);
#! example = 
#! example = CarteDO_R0S5[4].Val := Verins[0].CmdExtend;
#! see = ST_EQ_Cylinder
#! param Count = Combien d'equipements du tableau sont traites. Borne a 16. En mettre moins
#! param Count = ne fait pas gagner de memoire, seulement du temps de cycle.
#! param CycleMs = La periode de la tache, en ms. Un DDT ne peut pas contenir de temporisateur,
#! param CycleMs = donc tout le temps s'accumule depuis la : une valeur fausse ici fausse
#! param CycleMs = toutes les temporisations de tous les equipements du tableau. DINT et non
#! param CycleMs = INT - un INT de millisecondes deborde au bout de trente-trois secondes.
#! param CycleMs = Le mieux : DtMs de DFB_SYS_CLOCK, qui suit le temps reel de la tache.
#! param Eq = Le tableau des equipements, en InOut. Sa taille est figee a 16 : un InOut ne
#! param Eq = peut pas etre dimensionne a l'appel.
#! param FaultCount = Combien sont en defaut, recalcule a chaque cycle. De quoi allumer un voyant
#! param FaultCount = de synthese sans reparcourir le tableau.
#! param ReadyCount = Combien sont utilisables. FaultCount + ReadyCount n'est pas forcement egal a
#! param ReadyCount = Count : un equipement desactive n'est ni l'un ni l'autre.
#! changes 1.02 = LES COMPTEURS DE TEMPS NE DEBORDENT PLUS. Un DINT de millisecondes
#! changes 1.02 = devient negatif au bout de 24,8 jours ; ils plafonnent maintenant a
#! changes 1.02 = 2 000 000 000 ms (23 jours). StateMs repart a zero a chaque
#! changes 1.02 = changement d'etat (il comptait depuis la mise en route du bloc), et
#! changes 1.02 = l'etat est publie dans State. Demande le DDT en 1.01, qui porte les
#! changes 1.02 = nouveaux champs.
#! changes 1.01 = Count etait borne par le dernier INDICE (15) au lieu du nombre
#! changes 1.01 = d'equipements (16) : le dernier equipement du tableau n'etait jamais
#! changes 1.01 = traite.
#! changes 1.02 = Un acquittement redonne tout son delai a une nouvelle tentative : le
#! changes 1.02 = chrono du defaut repart de zero.

# Un verin: sortie, rentree, deux capteurs, monostable ou bistable.
# Une instance traite 16 equipements. Passer a une autre taille change
# la signature du bloc, donc toutes ses instances.

# name ; type ; scope ; initial ; comment
Count ; INT ; Input ; 16 ; combien d'equipements sont traites
CycleMs ; DINT ; Input ; 20 ; la periode de la tache en ms. Un DDT ne peut pas contenir de temporisateur
Eq ; ARRAY[0..15] OF ST_EQ_Cylinder ; InOut ;  ; les equipements
FaultCount ; INT ; Output ; 0 ; combien sont en defaut
ReadyCount ; INT ; Output ; 0 ; combien sont utilisables
i ; INT ; Local ; 0 ; 
n ; INT ; Local ; 0 ; 
LAST ; INT ; Local ; 15 ; dernier indice
ext ; BOOL ; Local ;  ; 
ret ; BOOL ; Local ;  ; 
allowed ; BOOL ; Local ;  ; 
st ; INT ; Local ; 0 ; l'etat de l'equipement, avant publication
MAXMS ; DINT ; Local ; 2000000000 ; plafond des compteurs de temps : 23 jours, sous la limite d'un DINT

<<<section Process ST>>>
n := Count;
IF n > LAST + 1 THEN n := LAST + 1; END_IF;
IF n < 0 THEN n := 0; END_IF;

FaultCount := 0;
ReadyCount := 0;

FOR i := 0 TO n - 1 DO

(* Ce qui est vrai de toute famille, ecrit une fois: l'acquittement sur front,
   la memorisation du defaut, le temps dans l'etat. *)
IF Eq[i].AckFault AND NOT Eq[i].PrevAck THEN
    Eq[i].FaultLatch := FALSE;
    Eq[i].FaultCode := 0;
    (* et redonne tout son delai a une nouvelle tentative : sans ca, le
       chrono du defaut continuait, et le defaut revenait des
       l'acquittement. *)
    Eq[i].TravelElapsed := 0;
END_IF;
Eq[i].PrevAck := Eq[i].AckFault;

IF NOT Eq[i].Enable THEN
    (* Desactive: aucune sortie, aucun defaut. Un equipement consigne ne doit
       pas remplir le journal d'alarmes pendant qu'on travaille dessus. *)
    Eq[i].Fault := FALSE;
    Eq[i].FaultCode := 0;
    Eq[i].FaultLatch := FALSE;
END_IF;

ext := Eq[i].ExtendReq;
ret := Eq[i].RetractReq;
IF Eq[i].ManMode THEN
    ext := Eq[i].ManExtendReq;
    ret := Eq[i].ManRetractReq;
END_IF;

IF ext AND ret THEN
    (* Les deux ensemble n'a pas de sens et ne doit surtout pas sortir les deux
       pilotes. La rentree gagne: c'est le repli sur d'un verin. *)
    Eq[i].FaultCode := 3;
    Eq[i].FaultLatch := TRUE;
    ext := FALSE;
END_IF;

IF Eq[i].FdcExtended AND Eq[i].FdcRetracted THEN
    Eq[i].FaultCode := 1;
    Eq[i].FaultLatch := TRUE;
END_IF;

Eq[i].Extended  := Eq[i].FdcExtended AND NOT Eq[i].FdcRetracted;
Eq[i].Retracted := Eq[i].FdcRetracted AND NOT Eq[i].FdcExtended;
Eq[i].Moving := (ext AND NOT Eq[i].Extended) OR (ret AND NOT Eq[i].Retracted);

IF Eq[i].Moving THEN
    IF Eq[i].TravelElapsed < MAXMS - CycleMs THEN
        Eq[i].TravelElapsed := Eq[i].TravelElapsed + CycleMs;
    ELSE
        Eq[i].TravelElapsed := MAXMS;
    END_IF;
    IF Eq[i].TravelElapsed > Eq[i].TravelMs THEN
        Eq[i].FaultCode := 2;
        Eq[i].FaultLatch := TRUE;
    END_IF;
ELSE
    Eq[i].TravelElapsed := 0;
END_IF;

allowed := Eq[i].Enable AND NOT Eq[i].FaultLatch;
Eq[i].CmdExtend := allowed AND ext;
IF Eq[i].Monostable THEN
    (* Un distributeur monostable n'a qu'un pilote: au repos il rentre tout
       seul. Commander une rentree serait commander un pilote qui n'existe pas. *)
    Eq[i].CmdRetract := FALSE;
ELSE
    Eq[i].CmdRetract := allowed AND ret;
END_IF;

IF Eq[i].Extended AND NOT Eq[i].PrevExtended THEN
    Eq[i].Starts := Eq[i].Starts + 1;
END_IF;
Eq[i].PrevExtended := Eq[i].Extended;


(* Fault est la copie PUBLIEE de FaultLatch, posee en fin de cycle.
   Les sorties, elles, se coupent sur FaultLatch - c'est-a-dire dans le meme
   cycle que le defaut. Les couper sur Fault laissait l'equipement commande un
   cycle de plus : vingt millisecondes pendant lesquelles une vanne reste
   pilotee alors qu'on vient de decouvrir qu'on ne sait pas ou elle est. *)

(* Le defaut est MEMORISE. Un thermique qui se rearme tout seul en refroidissant
   effacerait la trace de son declenchement, et personne ne saurait pourquoi la
   machine s'est arretee cette nuit-la. *)
(* Un equipement desactive ne publie pas de defaut, meme si la condition est
   toujours la. Le prologue efface la memorisation, mais le corps la repose au
   meme cycle : c'est ici qu'il faut le dire, une fois, plutot que d'entourer
   chaque famille d'un IF Enable. *)
Eq[i].Fault := Eq[i].FaultLatch AND Eq[i].Enable;
Eq[i].Ready := Eq[i].Enable AND NOT Eq[i].Fault;

(* L'ETAT PUBLIE, et le temps passe dedans. StateMs n'etait jamais remis a
   zero - il comptait depuis la mise en route du bloc - et debordait au bout de
   24,8 jours. Il repart maintenant a chaque changement d'etat, et plafonne. *)
IF NOT Eq[i].Enable THEN
    st := 0;
ELSIF Eq[i].Fault THEN
    st := 1;
ELSIF Eq[i].Moving THEN
    st := 3;
ELSE
    st := 2;
END_IF;
IF st <> Eq[i].PrevState THEN
    Eq[i].StateMs := 0;
    Eq[i].PrevState := st;
ELSIF Eq[i].StateMs < MAXMS - CycleMs THEN
    Eq[i].StateMs := Eq[i].StateMs + CycleMs;
ELSE
    Eq[i].StateMs := MAXMS;
END_IF;
Eq[i].State := st;

IF Eq[i].Fault THEN
    FaultCount := FaultCount + 1;
END_IF;
IF Eq[i].Ready THEN
    ReadyCount := ReadyCount + 1;
END_IF;

END_FOR;
<<<end>>>
