# Derived data type, shared.
name = ST_EQ_Motor
version = 1.01
#! summary = Un moteur a vitesse fixe : commande, retour, thermique, anti court-cycle.
#! usage = Le contrat commun a toutes les familles d'equipement :
#! usage = Enable a FALSE fige l'equipement - aucune sortie, aucun defaut. Un
#! usage = equipement consigne ne doit pas remplir le journal d'alarmes pendant
#! usage = qu'on travaille dessus.
#! usage = ManMode fait primer les commandes Man* sur l'automatisme.
#! usage = AckFault acquitte SUR FRONT MONTANT, et seulement si la condition a
#! usage = disparu.
#! usage = LE DEFAUT EST MEMORISE par FaultLatch. Un thermique qui se rearme tout
#! usage = seul en refroidissant effacerait la trace de son declenchement, et
#! usage = personne ne saurait pourquoi la machine s'est arretee cette nuit-la.
#! see = DFB_EQ_MOTOR
#! see = ST_EQ_Pump
#! see = ST_SEQ_Member
#! param Enable = FALSE fige l'equipement : aucune sortie, aucun defaut, et les compteurs
#! param Enable = cessent d'avancer. C'est l'etat d'une machine consignee.
#! param Fault = La copie PUBLIEE de FaultLatch, posee en fin de cycle. Les sorties, elles,
#! param Fault = se coupent sur FaultLatch - c'est-a-dire dans le MEME cycle que le defaut.
#! param Fault = Les couper sur Fault laisserait l'equipement pilote un cycle de plus :
#! param Fault = vingt millisecondes pendant lesquelles on le commande alors qu'on vient de
#! param Fault = decouvrir qu'on ne sait plus ou il en est.
#! param FaultCode = Le dernier code pose, 0 quand il n'y a rien. Voir la table de cette famille,
#! param FaultCode = en tete de fichier. Il n'est efface que par AckFault.
#! param Ready = Active et sans defaut. C'est ce qu'on cable sur Available d'une rotation :
#! param Ready = un equipement en defaut est alors saute, et il reprend son rang en revenant.
#! param Starts = Nombre de demarrages depuis le dernier Reset. Un compteur qui grimpe vite
#! param Starts = est la signature d'un court-cycle - voir MinOffMs quand la famille en a un.
#! param Thermal = TRUE quand le relais est SAIN. C'est un contact NF, et l'initialiser a FALSE
#! param Thermal = met l'equipement en defaut au demarrage - ce qui est le comportement sur.
#! param MinOffMs = Duree minimale a l'arret avant de pouvoir redemarrer. 0 desactive. Un moteur
#! param MinOffMs = redemarre trois fois par minute est un moteur qu'on remplace deux fois par
#! param MinOffMs = an.
#! param HasFbk = FALSE : pas de retour de marche. Running suit alors la commande, et les
#! param HasFbk = defauts 2 et 3 ne peuvent plus se produire - on ne detecte plus ni un
#! param HasFbk = contacteur qui ne colle pas, ni un contacteur colle.
#! param FbkMs = Delai tolere entre la commande et le retour. Il sert dans les DEUX sens :
#! param FbkMs = c'est aussi le temps qu'on laisse au retour pour retomber avant de crier au
#! param FbkMs = contacteur colle.
#! param Running = Commande ET retour. A distinguer de Run, qui n'est que la commande : c'est
#! param Running = Running qui fait avancer RunMs et Starts.
#! fault 1 = Le relais thermique a declenche. C'est un contact NF : Thermal a FALSE veut
#! fault 1 = dire DECLENCHE. Le lire a l'envers est l'erreur qui fait tourner une machine
#! fault 1 = avec sa protection ouverte, et rien ne la signale.
#! fault 2 = Pas de retour de marche au bout de FbkMs : le contacteur n'a pas colle.
#! fault 3 = Retour de marche alors que rien n'est commande : le contacteur est colle. Le
#! fault 3 = moteur tourne et personne ne l'a demande - c'est plus grave que l'inverse.
#! internal = PrevAck, FbkElapsed, OffElapsed, PrevRunning, RunFracMs, PrevState
#! param Fbk = Retour de marche : le contact auxiliaire du contacteur (KM). Sans
#! param Fbk = retour, HasFbk a FALSE.
#! changes 1.01 = AJOUTS EN FIN DE TYPE : RunS (temps de marche en secondes, sans
#! changes 1.01 = debordement), State (etat publie : 0 desactive, 1 defaut, 2 repos, 3
#! changes 1.01 = en service), et deux champs internes. RunMs et StateMs plafonnent a
#! changes 1.01 = 2 000 000 000 ms au lieu de devenir negatifs.
#! example = (* declarer :
#! example =    Moteurs : ARRAY[0..15] OF ST_EQ_Motor;
#! example =    DI : ARRAY[0..15] OF ST_IO_Dig;
#! example =    DQ : ARRAY[0..15] OF ST_IO_Dig; *)
#! example = (* la configuration, une fois *)
#! example = Moteurs[0].Name     := 'M201 agitateur';
#! example = Moteurs[0].FbkMs    := 2000;
#! example = Moteurs[0].MinOffMs := 30000;
#! example = (* les retours, AVANT l'appel de DFB_EQ_MOTOR *)
#! example = Moteurs[0].Fbk     := DI[0].Val;     (* contact auxiliaire KM *)
#! example = Moteurs[0].Thermal := DI[1].Val;     (* relais thermique, NF *)
#! example = (* la commande, APRES *)
#! example = DQ[0].Val := Moteurs[0].Run;
#! given = DI[1].Val := TRUE
#! expect = 1 : Moteurs[0].Thermal = TRUE
#! expect = 1 : Moteurs[0].Fbk = FALSE
#! expect = 1 : Moteurs[0].MinOffMs = 30000

# Un moteur a vitesse fixe: commande, retour, thermique, anti court-cycle.
#
# Codes de defaut (FaultCode):
# 1  le relais thermique a declenche
# 2  pas de retour de marche au bout de FbkMs: le contacteur n'a pas colle
# 3  retour de marche alors que rien n'est commande: contacteur colle

# name ; type ; scope ; initial ; comment
Name ; STRING[16] ; Member ;  ; ce que l'operateur lit
Enable ; BOOL ; Member ; TRUE ; FALSE fige l'equipement: aucune sortie, aucun defaut
ManMode ; BOOL ; Member ;  ; TRUE: les commandes manuelles priment sur l'automatisme
AckFault ; BOOL ; Member ;  ; front montant: acquitte le defaut s'il a disparu
PrevAck ; BOOL ; Member ;  ; runtime, ne pas ecrire
RunReq ; BOOL ; Member ;  ; demande de marche en automatique
ManRunReq ; BOOL ; Member ;  ; demande de marche en manuel
Fbk ; BOOL ; Member ;  ; retour de marche (contacteur, KM)
Thermal ; BOOL ; Member ;  ; TRUE quand le relais thermique est SAIN (contact NF)
Run ; BOOL ; Member ;  ; la sortie de commande
Running ; BOOL ; Member ;  ; commande ET retour
FbkMs ; DINT ; Member ; 2000 ; delai tolere entre la commande et le retour
FbkElapsed ; DINT ; Member ; 0 ; runtime
MinOffMs ; DINT ; Member ; 0 ; duree minimale a l'arret avant un redemarrage. 0 desactive
OffElapsed ; DINT ; Member ; 0 ; runtime
HasFbk ; BOOL ; Member ; TRUE ; FALSE: pas de retour, Running suit la commande
PrevRunning ; BOOL ; Member ;  ; runtime
Fault ; BOOL ; Member ;  ; un defaut est present
FaultCode ; INT ; Member ; 0 ; 0 aucun. Voir la table de la famille
FaultLatch ; BOOL ; Member ;  ; le defaut reste jusqu'a AckFault, meme s'il disparait
Ready ; BOOL ; Member ;  ; utilisable: active, sans defaut
RunMs ; DINT ; Member ; 0 ; temps de fonctionnement cumule, en ms, plafonne a 2 000 000 000 (555 h) : lire RunS
Starts ; UDINT ; Member ; 0 ; nombre de demarrages depuis le dernier Reset
StateMs ; DINT ; Member ; 0 ; temps dans l'etat courant (State), en ms, plafonne a 2 000 000 000
RunS ; UDINT ; Member ; 0 ; temps de fonctionnement cumule, en secondes : ne deborde pas avant 136 ans
RunFracMs ; DINT ; Member ; 0 ; runtime, ne pas ecrire : les millisecondes pas encore comptees dans RunS
State ; INT ; Member ; 0 ; etat publie : 0 desactive, 1 en defaut, 2 au repos, 3 en service
PrevState ; INT ; Member ; -1 ; runtime, ne pas ecrire
