# Derived function block, shared.
name = DFB_EQ_DRIVE
version = 1.02
#! summary = Un variateur : consigne, rampe, ecart, mots d'etat, sortie en points.
#! usage = UNE INSTANCE TRAITE SEIZE EQUIPEMENTS, et cette taille est dans la signature
#! usage = du bloc : en changer touche toutes les instances de tous les projets qui
#! usage = l'ont importe. Seize suffit pour une station ; au-dela, on declare une
#! usage = deuxieme instance.
#! usage = Appeler une fois par cycle, apres les voies d'entree et avant les reports
#! usage = vers l'IHM : le bloc lit ce que les voies ont ecrit, et ecrit ce que les
#! usage = reports vont lire.
#! usage = 
#! usage = LE BORNAGE PASSE AVANT LA RAMPE. Ramper vers une consigne hors plage ferait
#! usage = monter la vitesse jusqu'a la borne en y mettant le temps, ce qui masque
#! usage = l'erreur de consigne au lieu de la montrer.
#! example = (* declarer : Variateurs : ARRAY[0..15] OF ST_EQ_Drive; *)
#! example = Variateurs[0].DriveReady := MotEtatVariateur.0;
#! example = Variateurs[0].DriveFault := MotEtatVariateur.3;
#! example = Variateurs[0].SpeedFbk   := INT_TO_REAL(%IW0.12.0) / 100.0;
#! example = Variateurs[0].SpeedReq   := ConsigneRecette;
#! example = 
#! example = VAR_Ligne(Count := 2, CycleMs := 20, Eq := Variateurs);
#! example = 
#! example = %QW0.13.0 := Variateurs[0].RawOut;
#! see = ST_EQ_Drive
#! param Count = Combien d'equipements du tableau sont traites. Borne a 16. En mettre moins
#! param Count = ne fait pas gagner de memoire, seulement du temps de cycle.
#! param CycleMs = La periode de la tache, en ms. Un DDT ne peut pas contenir de temporisateur,
#! param CycleMs = donc tout le temps s'accumule depuis la : une valeur fausse ici fausse
#! param CycleMs = toutes les temporisations de tous les equipements du tableau. DINT et non
#! param CycleMs = INT - un INT de millisecondes deborde au bout de trente-trois secondes.
#! param CycleMs = Le mieux : DtMs de DFB_SYS_CLOCK, qui suit le temps reel de la tache.
#! param Eq = Le tableau des equipements, en InOut. Sa taille est figee a 16 : un InOut ne
#! param Eq = peut pas etre dimensionne a l'appel.
#! param FaultCount = Combien sont en defaut, recalcule a chaque cycle. De quoi allumer un voyant
#! param FaultCount = de synthese sans reparcourir le tableau.
#! param ReadyCount = Combien sont utilisables. FaultCount + ReadyCount n'est pas forcement egal a
#! param ReadyCount = Count : un equipement desactive n'est ni l'un ni l'autre.
#! changes 1.02 = LES COMPTEURS DE TEMPS NE DEBORDENT PLUS. Un DINT de millisecondes
#! changes 1.02 = devient negatif au bout de 24,8 jours ; ils plafonnent maintenant a
#! changes 1.02 = 2 000 000 000 ms (23 jours). StateMs repart a zero a chaque
#! changes 1.02 = changement d'etat (il comptait depuis la mise en route du bloc), et
#! changes 1.02 = l'etat est publie dans State. Demande le DDT en 1.01, qui porte les
#! changes 1.02 = nouveaux champs.
#! changes 1.02 = RunS compte le temps de marche en SECONDES, sans debordement avant
#! changes 1.02 = 136 ans ; RunMs plafonne a 555 heures. C'est RunS qu'il faut cabler
#! changes 1.02 = sur une rotation.
#! changes 1.02 = CORRECTION : Running n'etait jamais calcule (temps de marche,
#! changes 1.02 = demarrages et ecart jamais surveilles), et Reverse jamais lu.
#! changes 1.02 = Running = commande ET variateur pret sans defaut ; le sens arriere
#! changes 1.02 = sort sur RunRev.
#! changes 1.01 = Count etait borne par le dernier INDICE (15) au lieu du nombre
#! changes 1.01 = d'equipements (16) : le dernier equipement du tableau n'etait jamais
#! changes 1.01 = traite.
#! changes 1.02 = CORRECTION : un defaut detecte apres le calcul de la commande
#! changes 1.02 = (retour, marche a sec, debit, pression, ecart) coupe la sortie dans
#! changes 1.02 = le meme cycle, comme l'aide le promettait ; elle restait commandee
#! changes 1.02 = un cycle de plus.
#! changes 1.02 = Un acquittement redonne tout son delai a une nouvelle tentative : le
#! changes 1.02 = chrono du defaut repart de zero.

# Un variateur: consigne, rampe, ecart, mots d'etat, sortie en points.
# Une instance traite 16 equipements. Passer a une autre taille change
# la signature du bloc, donc toutes ses instances.

# name ; type ; scope ; initial ; comment
Count ; INT ; Input ; 16 ; combien d'equipements sont traites
CycleMs ; DINT ; Input ; 20 ; la periode de la tache en ms. Un DDT ne peut pas contenir de temporisateur
Eq ; ARRAY[0..15] OF ST_EQ_Drive ; InOut ;  ; les equipements
FaultCount ; INT ; Output ; 0 ; combien sont en defaut
ReadyCount ; INT ; Output ; 0 ; combien sont utilisables
i ; INT ; Local ; 0 ; 
n ; INT ; Local ; 0 ; 
LAST ; INT ; Local ; 15 ; dernier indice
req ; BOOL ; Local ;  ; 
target ; REAL ; Local ; 0.0 ; 
step ; REAL ; Local ; 0.0 ; 
span ; REAL ; Local ; 0.0 ; 
st ; INT ; Local ; 0 ; l'etat de l'equipement, avant publication
MAXMS ; DINT ; Local ; 2000000000 ; plafond des compteurs de temps : 23 jours, sous la limite d'un DINT

<<<section Process ST>>>
n := Count;
IF n > LAST + 1 THEN n := LAST + 1; END_IF;
IF n < 0 THEN n := 0; END_IF;

FaultCount := 0;
ReadyCount := 0;

FOR i := 0 TO n - 1 DO

(* Ce qui est vrai de toute famille, ecrit une fois: l'acquittement sur front,
   la memorisation du defaut, le temps dans l'etat. *)
IF Eq[i].AckFault AND NOT Eq[i].PrevAck THEN
    Eq[i].FaultLatch := FALSE;
    Eq[i].FaultCode := 0;
    (* et redonne tout son delai a une nouvelle tentative : sans ca, le
       chrono du defaut continuait, et le defaut revenait des
       l'acquittement. *)
    Eq[i].DevElapsed := 0;
END_IF;
Eq[i].PrevAck := Eq[i].AckFault;

IF NOT Eq[i].Enable THEN
    (* Desactive: aucune sortie, aucun defaut. Un equipement consigne ne doit
       pas remplir le journal d'alarmes pendant qu'on travaille dessus. *)
    Eq[i].Fault := FALSE;
    Eq[i].FaultCode := 0;
    Eq[i].FaultLatch := FALSE;
END_IF;

req := Eq[i].RunReq;
target := Eq[i].SpeedReq;
IF Eq[i].ManMode THEN
    req := Eq[i].ManRunReq;
    target := Eq[i].ManSpeedReq;
END_IF;

IF Eq[i].DriveFault THEN
    Eq[i].FaultCode := 1;
    Eq[i].FaultLatch := TRUE;
END_IF;
IF req AND NOT Eq[i].DriveReady THEN
    Eq[i].FaultCode := 2;
    Eq[i].FaultLatch := TRUE;
END_IF;

(* LE SENS : deux sorties, comme un convoyeur. Reverse etait declare et
   jamais lu - le variateur tournait toujours dans le meme sens. *)
Eq[i].Run    := Eq[i].Enable AND NOT Eq[i].FaultLatch AND req AND Eq[i].DriveReady
                AND NOT Eq[i].Reverse;
Eq[i].RunRev := Eq[i].Enable AND NOT Eq[i].FaultLatch AND req AND Eq[i].DriveReady
                AND Eq[i].Reverse;

(* EN MARCHE : commande, et le variateur pret et sans defaut. Running etait
   declare et jamais calcule - le temps de marche, les demarrages et la
   surveillance d'ecart ne s'activaient donc jamais. *)
Eq[i].Running := (Eq[i].Run OR Eq[i].RunRev) AND Eq[i].DriveReady AND NOT Eq[i].DriveFault;

(* Bornage avant rampe. Ramper vers une consigne hors plage ferait monter la
   vitesse jusqu'a la borne en y mettant le temps, ce qui masque l'erreur de
   consigne au lieu de la montrer. *)
IF target < Eq[i].SpeedMin THEN target := Eq[i].SpeedMin; END_IF;
IF target > Eq[i].SpeedMax THEN target := Eq[i].SpeedMax; END_IF;
IF NOT (Eq[i].Run OR Eq[i].RunRev) THEN
    target := Eq[i].SpeedMin;
END_IF;

IF Eq[i].RampMs > 0 AND CycleMs > 0 THEN
    step := (Eq[i].SpeedMax - Eq[i].SpeedMin) * DINT_TO_REAL(CycleMs)
          / DINT_TO_REAL(Eq[i].RampMs);
    IF Eq[i].Speed < target - step THEN
        Eq[i].Speed := Eq[i].Speed + step;
    ELSIF Eq[i].Speed > target + step THEN
        Eq[i].Speed := Eq[i].Speed - step;
    ELSE
        Eq[i].Speed := target;
    END_IF;
ELSE
    Eq[i].Speed := target;
END_IF;

(* La consigne en points, prete pour un %QW. Une plage nulle est une division
   par zero, qui arrete la tache: elle est signalee et la voie est sautee. *)
span := Eq[i].SpeedMax - Eq[i].SpeedMin;
IF ABS(span) < 1.0E-9 THEN
    Eq[i].RawOut := Eq[i].RawMin;
ELSE
    Eq[i].RawOut := Eq[i].RawMin
                  + REAL_TO_INT((Eq[i].Speed - Eq[i].SpeedMin)
                                * INT_TO_REAL(Eq[i].RawMax - Eq[i].RawMin) / span);
END_IF;

Eq[i].Deviation := Eq[i].Speed - Eq[i].SpeedFbk;
IF Eq[i].MaxDeviation > 0.0 AND Eq[i].Running THEN
    IF ABS(Eq[i].Deviation) > Eq[i].MaxDeviation THEN
        IF Eq[i].DevElapsed < MAXMS - CycleMs THEN
            Eq[i].DevElapsed := Eq[i].DevElapsed + CycleMs;
        ELSE
            Eq[i].DevElapsed := MAXMS;
        END_IF;
        IF Eq[i].DevElapsed > Eq[i].DevDelayMs THEN
            Eq[i].FaultCode := 3;
            Eq[i].FaultLatch := TRUE;
        END_IF;
    ELSE
        Eq[i].DevElapsed := 0;
    END_IF;
ELSE
    Eq[i].DevElapsed := 0;
END_IF;

IF Eq[i].Running AND NOT Eq[i].PrevRunning THEN
    Eq[i].Starts := Eq[i].Starts + 1;
END_IF;
IF Eq[i].Running THEN
    (* RunMs plafonne a 2 000 000 000 ms, soit 555 heures : au-dela il ne
       bouge plus, au lieu de devenir negatif. RunS compte les SECONDES et ne
       deborde pas avant 136 ans : c'est lui qu'il faut relayer a une rotation
       ou a l'IHM. *)
    IF Eq[i].RunMs < MAXMS - CycleMs THEN
        Eq[i].RunMs := Eq[i].RunMs + CycleMs;
    ELSE
        Eq[i].RunMs := MAXMS;
    END_IF;
    Eq[i].RunFracMs := Eq[i].RunFracMs + CycleMs;
    IF Eq[i].RunFracMs >= 1000 THEN
        Eq[i].RunS := Eq[i].RunS + DINT_TO_UDINT(Eq[i].RunFracMs / 1000);
        Eq[i].RunFracMs := Eq[i].RunFracMs MOD 1000;
    END_IF;
END_IF;
Eq[i].PrevRunning := Eq[i].Running;


(* Fault est la copie PUBLIEE de FaultLatch, posee en fin de cycle.
   Les sorties, elles, se coupent sur FaultLatch - c'est-a-dire dans le meme
   cycle que le defaut. Les couper sur Fault laissait l'equipement commande un
   cycle de plus : vingt millisecondes pendant lesquelles une vanne reste
   pilotee alors qu'on vient de decouvrir qu'on ne sait pas ou elle est. *)

(* Le defaut est MEMORISE. Un thermique qui se rearme tout seul en refroidissant
   effacerait la trace de son declenchement, et personne ne saurait pourquoi la
   machine s'est arretee cette nuit-la. *)
(* Un equipement desactive ne publie pas de defaut, meme si la condition est
   toujours la. Le prologue efface la memorisation, mais le corps la repose au
   meme cycle : c'est ici qu'il faut le dire, une fois, plutot que d'entourer
   chaque famille d'un IF Enable. *)
(* UN DEFAUT COUPE LA SORTIE DANS LE CYCLE MEME ou il apparait. Ceux qui se
   detectent APRES le calcul de la commande - retour absent, marche a sec,
   debit, pression, ecart - la laissaient un cycle de plus. *)
IF Eq[i].FaultLatch THEN
    Eq[i].Run := FALSE;
    Eq[i].RunRev := FALSE;
    Eq[i].Running := FALSE;
END_IF;

Eq[i].Fault := Eq[i].FaultLatch AND Eq[i].Enable;
Eq[i].Ready := Eq[i].Enable AND NOT Eq[i].Fault;

(* L'ETAT PUBLIE, et le temps passe dedans. StateMs n'etait jamais remis a
   zero - il comptait depuis la mise en route du bloc - et debordait au bout de
   24,8 jours. Il repart maintenant a chaque changement d'etat, et plafonne. *)
IF NOT Eq[i].Enable THEN
    st := 0;
ELSIF Eq[i].Fault THEN
    st := 1;
ELSIF Eq[i].Running THEN
    st := 3;
ELSE
    st := 2;
END_IF;
IF st <> Eq[i].PrevState THEN
    Eq[i].StateMs := 0;
    Eq[i].PrevState := st;
ELSIF Eq[i].StateMs < MAXMS - CycleMs THEN
    Eq[i].StateMs := Eq[i].StateMs + CycleMs;
ELSE
    Eq[i].StateMs := MAXMS;
END_IF;
Eq[i].State := st;

IF Eq[i].Fault THEN
    FaultCount := FaultCount + 1;
END_IF;
IF Eq[i].Ready THEN
    ReadyCount := ReadyCount + 1;
END_IF;

END_FOR;
<<<end>>>
