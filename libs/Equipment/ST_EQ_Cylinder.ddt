# Derived data type, shared.
name = ST_EQ_Cylinder
version = 1.01
#! summary = Un verin : sortie, rentree, deux capteurs, monostable ou bistable.
#! usage = Le contrat commun a toutes les familles d'equipement :
#! usage = Enable a FALSE fige l'equipement - aucune sortie, aucun defaut. Un
#! usage = equipement consigne ne doit pas remplir le journal d'alarmes pendant
#! usage = qu'on travaille dessus.
#! usage = ManMode fait primer les commandes Man* sur l'automatisme.
#! usage = AckFault acquitte SUR FRONT MONTANT, et seulement si la condition a
#! usage = disparu.
#! usage = LE DEFAUT EST MEMORISE par FaultLatch. Un thermique qui se rearme tout
#! usage = seul en refroidissant effacerait la trace de son declenchement, et
#! usage = personne ne saurait pourquoi la machine s'est arretee cette nuit-la.
#! see = DFB_EQ_CYLINDER
#! see = ST_EQ_Valve2
#! param Enable = FALSE fige l'equipement : aucune sortie, aucun defaut, et les compteurs
#! param Enable = cessent d'avancer. C'est l'etat d'une machine consignee.
#! param Fault = La copie PUBLIEE de FaultLatch, posee en fin de cycle. Les sorties, elles,
#! param Fault = se coupent sur FaultLatch - c'est-a-dire dans le MEME cycle que le defaut.
#! param Fault = Les couper sur Fault laisserait l'equipement pilote un cycle de plus :
#! param Fault = vingt millisecondes pendant lesquelles on le commande alors qu'on vient de
#! param Fault = decouvrir qu'on ne sait plus ou il en est.
#! param FaultCode = Le dernier code pose, 0 quand il n'y a rien. Voir la table de cette famille,
#! param FaultCode = en tete de fichier. Il n'est efface que par AckFault.
#! param Ready = Active et sans defaut. C'est ce qu'on cable sur Available d'une rotation :
#! param Ready = un equipement en defaut est alors saute, et il reprend son rang en revenant.
#! param Starts = Nombre de demarrages depuis le dernier Reset. Un compteur qui grimpe vite
#! param Starts = est la signature d'un court-cycle - voir MinOffMs quand la famille en a un.
#! param Monostable = TRUE : un seul pilote, le repos EST la rentree. CmdRetract reste alors a
#! param Monostable = FALSE en permanence - commander une rentree serait commander un pilote qui
#! param Monostable = n'existe pas.
#! param Extended = Capteur sorti actif ET capteur rentre inactif. Les deux a la fois donnent le
#! param Extended = defaut 1 et ni Extended ni Retracted.
#! param TravelMs = Temps de course tolere. Contrairement a une vanne, il est TOUJOURS surveille :
#! param TravelMs = un verin a toujours ses deux capteurs, ou il n'a rien a signaler.
#! fault 1 = Les deux capteurs actifs a la fois : un capteur est casse. Un verin ne peut
#! fault 1 = pas etre sorti et rentre en meme temps.
#! fault 2 = Pas arrive en butee au bout de TravelMs : blocage, ou fuite d'air.
#! fault 3 = Les deux sens demandes en meme temps. LA RENTREE GAGNE : c'est le repli sur
#! fault 3 = d'un verin, et c'est une decision, pas un hasard.
#! internal = PrevAck, TravelElapsed, PrevExtended, RunFracMs, PrevState
#! param ExtendReq = Demande de sortie, en automatique. Avec RetractReq en meme temps,
#! param ExtendReq = c'est le defaut 3 et la rentree gagne : le repli sur d'un verin.
#! param RetractReq = Demande de rentree, en automatique.
#! param ManExtendReq = Demande de sortie en manuel, suivie tant que ManMode est vrai.
#! param ManRetractReq = Demande de rentree en manuel.
#! param FdcExtended = Fin de course SORTI. Avec FdcRetracted en meme temps, c'est le
#! param FdcExtended = defaut 1 : un capteur est casse ou deregle.
#! param FdcRetracted = Fin de course RENTRE.
#! param CmdExtend = La sortie qui pilote la sortie du verin.
#! param CmdRetract = La sortie qui pilote la rentree. Toujours FALSE sur un
#! param CmdRetract = distributeur monostable (Monostable vrai) : il n'a qu'un pilote,
#! param CmdRetract = et rentre seul au repos.
#! param Retracted = Rentre : fin de course RENTRE seul.
#! param Moving = Un mouvement est demande et sa position pas encore atteinte. C'est
#! param Moving = ce qui fait avancer le chrono de manoeuvre (defaut 2 au-dela de
#! param Moving = TravelMs).
#! changes 1.01 = AJOUTS EN FIN DE TYPE : RunS (temps de marche en secondes, sans
#! changes 1.01 = debordement), State (etat publie : 0 desactive, 1 defaut, 2 repos, 3
#! changes 1.01 = en service), et deux champs internes. RunMs et StateMs plafonnent a
#! changes 1.01 = 2 000 000 000 ms au lieu de devenir negatifs.
#! example = (* declarer :
#! example =    Verins : ARRAY[0..15] OF ST_EQ_Cylinder;
#! example =    DI : ARRAY[0..15] OF ST_IO_Dig;
#! example =    DQ : ARRAY[0..15] OF ST_IO_Dig; *)
#! example = (* la configuration, une fois *)
#! example = Verins[0].Name       := 'V501 poussoir';
#! example = Verins[0].TravelMs   := 1500;
#! example = Verins[0].Monostable := TRUE;      (* distributeur a rappel par ressort *)
#! example = (* les fins de course, AVANT l'appel de DFB_EQ_CYLINDER *)
#! example = Verins[0].FdcExtended  := DI[0].Val;
#! example = Verins[0].FdcRetracted := DI[1].Val;
#! example = (* les bobines, APRES *)
#! example = DQ[0].Val := Verins[0].CmdExtend;
#! example = DQ[1].Val := Verins[0].CmdRetract;
#! given = DI[1].Val := TRUE
#! expect = 1 : Verins[0].FdcRetracted = TRUE
#! expect = 1 : Verins[0].Monostable = TRUE

# Un verin: sortie, rentree, deux capteurs, monostable ou bistable.
#
# Codes de defaut (FaultCode):
# 1  les deux capteurs actifs a la fois: un capteur est casse
# 2  pas arrive en butee au bout de TravelMs
# 3  les deux sens demandes en meme temps

# name ; type ; scope ; initial ; comment
Name ; STRING[16] ; Member ;  ; ce que l'operateur lit
Enable ; BOOL ; Member ; TRUE ; FALSE fige l'equipement: aucune sortie, aucun defaut
ManMode ; BOOL ; Member ;  ; TRUE: les commandes manuelles priment sur l'automatisme
AckFault ; BOOL ; Member ;  ; front montant: acquitte le defaut s'il a disparu
PrevAck ; BOOL ; Member ;  ; runtime, ne pas ecrire
ExtendReq ; BOOL ; Member ;  ; demande de sortie
RetractReq ; BOOL ; Member ;  ; demande de rentree
ManExtendReq ; BOOL ; Member ;  ; 
ManRetractReq ; BOOL ; Member ;  ; 
FdcExtended ; BOOL ; Member ;  ; capteur sorti
FdcRetracted ; BOOL ; Member ;  ; capteur rentre
CmdExtend ; BOOL ; Member ;  ; sortie
CmdRetract ; BOOL ; Member ;  ; sortie
Extended ; BOOL ; Member ;  ; 
Retracted ; BOOL ; Member ;  ; 
Moving ; BOOL ; Member ;  ; 
TravelMs ; DINT ; Member ; 3000 ; temps de course tolere
TravelElapsed ; DINT ; Member ; 0 ; runtime
Monostable ; BOOL ; Member ;  ; TRUE: un seul pilote, le repos est la rentree
PrevExtended ; BOOL ; Member ;  ; runtime
Fault ; BOOL ; Member ;  ; un defaut est present
FaultCode ; INT ; Member ; 0 ; 0 aucun. Voir la table de la famille
FaultLatch ; BOOL ; Member ;  ; le defaut reste jusqu'a AckFault, meme s'il disparait
Ready ; BOOL ; Member ;  ; utilisable: active, sans defaut
RunMs ; DINT ; Member ; 0 ; temps de fonctionnement cumule, en ms, plafonne a 2 000 000 000 (555 h) : lire RunS
Starts ; UDINT ; Member ; 0 ; nombre de demarrages depuis le dernier Reset
StateMs ; DINT ; Member ; 0 ; temps dans l'etat courant (State), en ms, plafonne a 2 000 000 000
RunS ; UDINT ; Member ; 0 ; temps de fonctionnement cumule, en secondes : ne deborde pas avant 136 ans
RunFracMs ; DINT ; Member ; 0 ; runtime, ne pas ecrire : les millisecondes pas encore comptees dans RunS
State ; INT ; Member ; 0 ; etat publie : 0 desactive, 1 en defaut, 2 au repos, 3 en service
PrevState ; INT ; Member ; -1 ; runtime, ne pas ecrire
