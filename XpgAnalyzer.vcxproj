  <PropertyGroup>
    <!-- Lot API 8 : SDL3 est fourni dans l'archive (third_party\SDL3). Sans condition :
         une variable d'environnement SDL3_DIR (souvent posee pour CMake, vers un autre
         dossier) ne le detourne pas. Une autre SDL3 : msbuild /p:SDL3_DIR=dossier. -->
    <SDL3_DIR>$(ProjectDir)third_party\SDL3</SDL3_DIR>
    <!-- 1.12.0 : deux applications, un seul projet. XpgEdition = API (par defaut) ou IHM
         (msbuild /p:XpgEdition=IHM ; build.bat compile les deux) : XpgAnalyzer-API.exe et
         XpgAnalyzer-IHM.exe, cote a cote dans build\<Configuration>, chacun ses .obj. -->
    <XpgEdition Condition="'$(XpgEdition)'==''">API</XpgEdition>
    <OutDir>$(ProjectDir)build\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\obj\$(Configuration)-$(XpgEdition)\</IntDir>
    <TargetName>XpgAnalyzer-$(XpgEdition)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)third_party;$(SDL3_DIR)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        NOMINMAX and WIN32_LEAN_AND_MEAN stop <windows.h> from defining min/max
        and dragging in rpcndr.h (which defines `small`). platform/Geometry.hpp
        also guards against all three, so the headers work either way.
      -->
      <!--
        XPG_EDITION (lot 21) : le lot des sources. Il change la ligne de
        commande de chaque .cpp : Visual Studio les recompile donc tous une
        fois, et aucun .obj compile avec un ancien en-tete (HmiModel.hpp)
        ne reste. Au prochain lot, 22 : la meme chose.
      -->
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;XPG_WITH_SDL=1;XPG_HAVE_MINIZ=1;XPG_EDITION=25;XPG_EDITION_$(XpgEdition)=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <!-- 1.12.0 : les textes de la version (resources\windows\xpg_analyzer.rc) de chaque application. -->
    <ResourceCompile>
      <PreprocessorDefinitions>XPG_EDITION_$(XpgEdition);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(SDL3_DIR)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- 1.8.0 : page de code UTF-8, chemins longs, versions de Windows (voir le fichier). -->
    <Manifest>
      <AdditionalManifestFiles>$(ProjectDir)resources\windows\xpg_analyzer.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
    <!-- Lot API 8 : SDL3.dll a cote de l'executable (xcopy /D : seulement s'il est plus
         recent ; code 1 = rien a copier, ce n'est pas une erreur). -->
    <PostBuildEvent>
      <Message>bac\ et SDL3.dll vers $(OutDir)</Message>
      <Command>if exist "$(ProjectDir)bac\Armoire_Gaz\project.xpgproj" (xcopy /E /I /Y /D /Q "$(ProjectDir)bac" "$(OutDir)bac" &gt;NUL &amp; if errorlevel 2 exit /b 1)
xcopy /Y /D /Q "$(SDL3_DIR)\lib\x64\SDL3.dll" "$(OutDir)" &gt;NUL &amp; if errorlevel 2 (exit /b 1) else (exit /b 0)</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
