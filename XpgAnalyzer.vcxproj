  <!--
    Lot API 8 : SDL3 est fourni dans third_party\SDL3, en x64 seulement. Une autre
    plateforme, ou une archive extraite sans ce dossier : un message clair tout de
    suite, plutot que des centaines d'erreurs "SDL3/SDL.h introuvable".
  -->
  <Target Name="XpgVerifieSDL3" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="SDL3 fourni en x64 seulement : choisis la plateforme x64 (Plateformes de solution, dans la barre d'outils)." />
    <Error Condition="!Exists('$(SDL3_DIR)\include\SDL3\SDL.h') Or !Exists('$(SDL3_DIR)\lib\x64\SDL3.lib') Or !Exists('$(SDL3_DIR)\lib\x64\SDL3.dll')" Text="SDL3 introuvable dans $(SDL3_DIR) : il faut le dossier third_party\SDL3 de l'archive (include\SDL3, lib\x64\SDL3.lib, lib\x64\SDL3.dll)." />
  </Target>
</Project>