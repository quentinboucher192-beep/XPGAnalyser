// =============================================================================
//  resources/windows/xpg_license_admin_console.rc.in - 1.35.1 : l'icone (la cle) et la
//  version de XPG-License-Admin.exe (la console de l'editeur ; jamais livree). Pas de
//  manifeste : la console garde la page de code de son invite.
// =============================================================================
#include <winver.h>

1 ICON "@XPG_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "FileDescription",  "XPG License Admin, la console (editeur seulement)"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "XPG-License-Admin"
            VALUE "OriginalFilename", "XPG-License-Admin.exe"
            VALUE "ProductName",      "XPG License Manager Admin"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
