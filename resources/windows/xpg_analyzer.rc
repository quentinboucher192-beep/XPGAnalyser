// =============================================================================
//  resources/windows/xpg_analyzer.rc - l'icone et la version de
//  API-Studio.exe et de IHM-Studio.exe, pour le projet Visual Studio
//  (1.12.0 : XPG_EDITION_IHM, donne par XpgAnalyzer.vcxproj selon XpgEdition,
//  choisit les textes de IHM Studio ; sans lui, ceux de API Studio)
// -----------------------------------------------------------------------------
//  Avec CMake, c'est xpg_analyzer.rc.in qui sert (le chemin de l'icone y est
//  mis en absolu). Ici le chemin est relatif au dossier du projet (celui du
//  .vcxproj, a la racine de l'arbre : resources\logo\api_studio.ico, ihm_studio.ico). Un
//  projet ailleurs : ajoute le dossier resources\logo aux "Repertoires Include
//  supplementaires" des Ressources (Proprietes > Ressources > General).
// =============================================================================
#include <winver.h>

#ifdef XPG_EDITION_IHM
1 ICON "resources\\logo\\ihm_studio.ico"
#else
1 ICON "resources\\logo\\api_studio.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,12,0,0
 PRODUCTVERSION  1,12,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
#ifdef XPG_EDITION_IHM
            VALUE "FileDescription",  "IHM Studio"
            VALUE "InternalName",     "IHM-Studio"
            VALUE "OriginalFilename", "IHM-Studio.exe"
            VALUE "ProductName",      "IHM Studio"
#else
            VALUE "FileDescription",  "API Studio"
            VALUE "InternalName",     "API-Studio"
            VALUE "OriginalFilename", "API-Studio.exe"
            VALUE "ProductName",      "API Studio"
#endif
            VALUE "FileVersion",      "1.12.0"
            VALUE "ProductVersion",   "1.12.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
