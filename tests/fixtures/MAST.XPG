			</variables>
			<variables name="DEBUG_ACT1_SURP_B" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_ACT1_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_ACT2_SURP_B" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_ACT2_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_ACT3_SURP_B" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_ACT3_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_NOM_ETAPE_SURP_B" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_NOM_ETAPE_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT1_SURP_A" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION1_SURP[0]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT2_SURP_A" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION2_SURP[0]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT3_SURP_A" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION3_SURP[0]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSETAPE_SURP_A" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSETAPE_SURP[0]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT1_SURP_B" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION1_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT2_SURP_B" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION2_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSACT3_SURP_B" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSACTION3_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_TEMPSETAPE_SURP_B" typeName="DINT">
				<attribute name="EffectiveParameter" value="DEBUG_TEMPSETAPE_SURP[1]"></attribute>
			</variables>
			<variables name="DEBUG_TYPE_SURP_A" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_TYPE_SURP[1]"></attribute>
