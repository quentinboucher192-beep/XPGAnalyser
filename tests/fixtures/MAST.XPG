	<FBSource nameOfFBType="RTCDECODED" version="0.11" dateTime="dt#2026-06-22-21:51:19">
		<attribute name="TypeCodeCheckSumString" value="C0B0"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="FCAB"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="Enable" typeName="BOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Out" typeName="ST_RTCDECODED">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="Display" typeName="Display_NTPC"></variables>
			<variables name="Calcntpc" typeName="Calc_NTPC"></variables>
			<variables name="secOfDay" typeName="UDINT"></variables>
			<variables name="daysSince1980" typeName="UDINT"></variables>
			<variables name="remDays" typeName="UDINT"></variables>
			<variables name="y" typeName="INT"></variables>
			<variables name="m" typeName="INT"></variables>
			<variables name="dim" typeName="INT"></variables>
			<variables name="isLeap" typeName="BOOL"></variables>
			<variables name="lowOk" typeName="BOOL"></variables>
			<variables name="highOk" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="finished" typeName="BOOL"></variables>
			<variables name="msOfDay" typeName="UDINT"></variables>
			<variables name="msOfDayPrev" typeName="UDINT"></variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<STSource>IF NOT Enable THEN
RETURN;
END_IF;

RRTC_DT_MS(Display, Calcntpc, Out.Status);

lowOk := ((Out.Status AND 16#00FF) = 1);
highOk := (((Out.Status AND 16#FF00) / 256) = 1);
Out.ValidUtc := lowOk AND highOk;

(* ========================= *)
(* TEMPS DE BASE SAFE        *)
(* ========================= *)

Out.Millisecondes := Calcntpc.Fraction_Second;

IF Out.Millisecondes &lt; 0 THEN
Out.Millisecondes := 0;
ELSIF Out.Millisecondes &gt; 999 THEN
Out.Millisecondes := 999;
END_IF;

secOfDay := Calcntpc.Seconds MOD 86400;

msOfDay :=
(secOfDay * 1000) +
INT_TO_UDINT(Out.Millisecondes);

(* ========================= *)
(* HEURE / MIN / SEC         *)
(* ========================= *)

Out.Heures := UDINT_TO_INT(secOfDay / 3600);
Out.Minutes := UDINT_TO_INT((secOfDay MOD 3600) / 60);
Out.Secondes := UDINT_TO_INT(secOfDay MOD 60);

(* ========================= *)
(* DATE                      *)
(* ========================= *)

daysSince1980 := Calcntpc.Seconds / 86400;
remDays := daysSince1980;
y := 1980;

finished := FALSE;
WHILE NOT finished DO
isLeap := FALSE;


IF (y MOD 4 = 0) THEN
    IF (y MOD 100 &lt;&gt; 0) OR (y MOD 400 = 0) THEN
        isLeap := TRUE;
    END_IF;
END_IF;

IF remDays &gt;= INT_TO_UDINT(365 + BOOL_TO_INT(isLeap)) THEN
    remDays := remDays - INT_TO_UDINT(365 + BOOL_TO_INT(isLeap));
    y := y + 1;
ELSE
    finished := TRUE;
END_IF;


END_WHILE;

m := 1;
finished := FALSE;

WHILE NOT finished DO


dim := 31;

IF (m = 4) OR (m = 6) OR (m = 9) OR (m = 11) THEN
    dim := 30;

ELSIF m = 2 THEN

    isLeap := FALSE;

    IF (y MOD 4 = 0) THEN
        IF (y MOD 100 &lt;&gt; 0) OR (y MOD 400 = 0) THEN
            isLeap := TRUE;
        END_IF;
    END_IF;

    IF isLeap THEN
        dim := 29;
    ELSE
        dim := 28;
    END_IF;

END_IF;

IF remDays &gt;= INT_TO_UDINT(dim) THEN
    remDays := remDays - INT_TO_UDINT(dim);
    m := m + 1;
ELSE
    finished := TRUE;
END_IF;


END_WHILE;

Out.Annee := y;
Out.Mois := m;
Out.Jour := UDINT_TO_INT(remDays) + 1;

(* ========================= *)
(* CYCLE TIME                *)
(* ========================= *)

IF msOfDay &gt;= msOfDayPrev THEN
Out.CycleMs := msOfDay - msOfDayPrev;
ELSE
Out.CycleMs := (86400000 - msOfDayPrev) + msOfDay;
END_IF;

msOfDayPrev := msOfDay;

</STSource>
		</FBProgram>
	</FBSource>
</PGMExchangeFile>
