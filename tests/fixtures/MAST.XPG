	DEBUG_POMPAGE_0 := 0;
	DEBUG_HELIUM_0 := 0;
	DEBUG_CHGT := 0;
	DEBUG_DETOXAL_1 := 0;
	DEBUG_PURGE_1 := 0;
	DEBUG_POMPAGE_1 := 0;
	DEBUG_HELIUM_1 := 0;

	index_purge_B := 0;
	index_pompage_B := 0;
END_IF;

IF Acts_ChangementB[16].Out THEN
	Ctrl_PurgeB.Cmd.ModeReq := 0;
	DEBUG_PURGE_0 := 2;
