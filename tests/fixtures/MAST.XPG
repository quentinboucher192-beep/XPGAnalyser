		<publicLocalVariables>
			<variables name="index" typeName="INT"></variables>
			<variables name="flag_bouteille_vide" typeName="ARRAY[0..1] OF EBOOL"></variables>
			<variables name="timeout_atteintA" typeName="EBOOL"></variables>
			<variables name="Sorties_TOR16_STATES" typeName="ARRAY[0..1] OF DWORD"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="flag_bouteille_presque_vide" typeName="ARRAY[0..1] OF EBOOL"></variables>
			<variables name="TON_PRESQUE_VIDE_0" typeName="TON"></variables>
			<variables name="TON_PRESQUE_VIDE_1" typeName="TON"></variables>
			<variables name="TON_VIDE_0" typeName="TON"></variables>
			<variables name="TON_VIDE_1" typeName="TON"></variables>
			<variables name="ancien_index_utilise" typeName="INT"></variables>
			<variables name="configuree" typeName="EBOOL"></variables>
			<variables name="TON_BASCULEMENT" typeName="TON"></variables>
			<variables name="Steps_SurpA" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Trans_SurpA" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_SurpA" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="Gc_SurpressionA" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="InitDone_SurpA" typeName="EBOOL"></variables>
			<variables name="Steps_Surv" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Gc_Surveillance" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="InitDone_Surv" typeName="EBOOL"></variables>
			<variables name="Trans_Surv" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_Surv" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="Ctrl_SurpA" typeName="ST_GC_CTRL"></variables>
			<variables name="Ctrl_Surv" typeName="ST_GC_CTRL"></variables>
			<variables name="Builder" typeName="BUILDING"></variables>
			<variables name="Gc_SurpressionB" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="Steps_SurpB" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Trans_SurpB" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_SurpB" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="Ctrl_SurpB" typeName="ST_GC_CTRL"></variables>
			<variables name="timeout_atteintB" typeName="EBOOL"></variables>
			<variables name="InitDone_SurpB" typeName="EBOOL"></variables>
			<variables name="PasDeBasculementEnCours" typeName="BOOL"></variables>
			<variables name="PasDeChangementEnCours" typeName="EBOOL"></variables>
			<variables name="index_out" typeName="DINT"></variables>
			<variables name="cpt_reset" typeName="DINT"></variables>
			<variables name="Close" typeName="TOUTFERMER"></variables>
			<variables name="acquittements" typeName="ARRAY[0..1] OF EBOOL"></variables>
		</privateLocalVariables>
		<program>
			<identProgram name="Init" type="section" SectionOrder="1"></identProgram>
			<STSource>(* =========================================================
   CONFIGURATION - sélection des armoires
   ========================================================= *)
(* Si le système n'est pas configuré, on force l'index par défaut *)
IF NOT generalites.configuree THEN
    index_armoire_utilisee := generalites.index_depart;
END_IF;

(* Sauvegarde de l'ancien index utilisé (debug / traçabilité) *)
ancien_index_utilise := index_armoire_utilisee;

(* =========================================================
   ARMOIRE ACTIVE / INACTIVE
   ========================================================= *)
(* Détermination de l'armoire non utilisée (basculement binaire) *)
IF index_armoire_utilisee = 0 THEN
    index_armoire_non_utilisee := 1;
ELSE
    index_armoire_non_utilisee := 0;
END_IF;

(* =========================================================
   ETAT GLOBAL CONFIGURATION
   ========================================================= *)
configuree := generalites.configuree;
acquittements[0] := Acquit_A;
acquittements[1] := Acquit_B;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Distribution" type="section" SectionOrder="2"></identProgram>
			<STSource>for index := 0 to 1 do

	(* ---------------- ETAT ---------------- *)
	IF armoires[index].manu THEN
		armoires[index].etat := 10;
	ELSIF armoires[index].CycleSurpressionBit THEN
		armoires[index].etat := 11;
	ELSIF armoires[index].en_declenchement THEN
		armoires[index].etat := 2;
	ELSIF armoires[index].en_cours_de_chgt THEN
		armoires[index].etat := 6;
	ELSIF armoires[index].en_cours_de_basculement THEN
		armoires[index].etat := 5;
	ELSIF armoires[index].active THEN
		armoires[index].etat := 3;
	ELSIF NOT armoires[index].active THEN
		armoires[index].etat := 4;
	ELSIF armoires[index].physiquement_prete THEN
		armoires[index].etat := 1;
	ELSE
		armoires[index].etat := 0;
	END_IF;

	armoires[index].PoidsBouteille := REAL_TO_INT(armoires[index].ana.Balance.mes) - armoires[index].seuil_poids_utilise; 

	IF NOT(armoires[index].manu) THEN
		(* en déclenchement *)
		IF armoires[index].etat = 2 THEN
			armoires[index].sorties.V2.F0 := TRUE;
			armoires[index].sorties.V3.F0 := TRUE;
			armoires[index].sorties.V4.F0 := TRUE;
			armoires[index].sorties.V5.F0 := TRUE;
			armoires[index].sorties.V6.F0 := TRUE;
			armoires[index].sorties.V16.F0 := TRUE;
			armoires[index].sorties.V7.F0 := TRUE;
			armoires[index].sorties.VS.F0 := TRUE;
			armoires[index].sorties.V9.F0 := TRUE;
			armoires[index].sorties.VHE.F0 := TRUE;
			armoires[index].sorties.VBTE.F0 := TRUE;
			armoires[index].sorties.PPE.F0 := TRUE;
			armoires[index].sorties.V2.F1 := FALSE;
			armoires[index].sorties.V3.F1 := FALSE;
			armoires[index].sorties.V4.F1 := FALSE;
			armoires[index].sorties.V5.F1 := FALSE;
			armoires[index].sorties.V6.F1 := FALSE;
			armoires[index].sorties.V16.F1 := FALSE;
			armoires[index].sorties.V7.F1 := FALSE;
			armoires[index].sorties.VS.F1 := FALSE;
			armoires[index].sorties.V9.F1 := FALSE;
			armoires[index].sorties.VHE.F1 := FALSE;
			armoires[index].sorties.VBTE.F1 := FALSE;
			armoires[index].sorties.PPE.F1 := FALSE;
		(* actif : en distribution *)
		ELSIF armoires[index].etat = 3 THEN
			armoires[index].sorties.V5.F1 := TRUE;
			armoires[index].sorties.V5.F0 := FALSE;
			armoires[index].sorties.VBTE.F1 := TRUE;
			armoires[index].sorties.VBTE.F0 := FALSE;
			armoires[index].sorties.V6.F1 := TRUE;
			armoires[index].sorties.V6.F0 := FALSE;
			armoires[index].sorties.V16.F1 := TRUE;
			armoires[index].sorties.V16.F0 := FALSE;
		(* inactif : standby *)
		ELSIF armoires[index].etat = 4 THEN
			armoires[index].sorties.V2.F0 := TRUE;
			armoires[index].sorties.V3.F0 := TRUE;
			armoires[index].sorties.V4.F0 := TRUE;
			armoires[index].sorties.V5.F0 := TRUE;
			armoires[index].sorties.V6.F0 := TRUE;
			armoires[index].sorties.V16.F0 := TRUE;
			armoires[index].sorties.V7.F0 := TRUE;
			armoires[index].sorties.VS.F0 := TRUE;
			armoires[index].sorties.V9.F0 := TRUE;
			armoires[index].sorties.VHE.F0 := TRUE;
			armoires[index].sorties.VBTE.F0 := TRUE;
			armoires[index].sorties.PPE.F0 := TRUE;
			armoires[index].sorties.V2.F1 := FALSE;
			armoires[index].sorties.V3.F1 := FALSE;
			armoires[index].sorties.V4.F1 := FALSE;
			armoires[index].sorties.V5.F1 := FALSE;
			armoires[index].sorties.V6.F1 := FALSE;
			armoires[index].sorties.V16.F1 := FALSE;
			armoires[index].sorties.V7.F1 := FALSE;
			armoires[index].sorties.VS.F1 := FALSE;
			armoires[index].sorties.V9.F1 := FALSE;
			armoires[index].sorties.VHE.F1 := FALSE;
			armoires[index].sorties.VBTE.F1 := FALSE;
			armoires[index].sorties.PPE.F1 := FALSE;
		(* en basculement on maintient V6 V16 *)
		ELSIF armoires[index].etat = 5 THEN
			armoires[index].sorties.V5.F1 := FALSE;
			armoires[index].sorties.V5.F0 := TRUE;
			armoires[index].sorties.VBTE.F1 := FALSE;
			armoires[index].sorties.VBTE.F0 := TRUE;
			armoires[index].sorties.V6.F1 := TRUE;
			armoires[index].sorties.V6.F0 := FALSE;
			armoires[index].sorties.V16.F1 := TRUE;
			armoires[index].sorties.V16.F0 := FALSE;
		END_IF;
	END_IF;

	(* double enveloppe *)
	IF armoires[index].entrees.D1[0] THEN
		armoires[index].sorties.V6.F1 := FALSE;
		armoires[index].sorties.V6.F0 := TRUE;
	END_IF;
	IF armoires[index].entrees.D2[0] THEN
		armoires[index].sorties.V16.F1 := FALSE;
		armoires[index].sorties.V16.F0 := TRUE;
	END_IF;
	
	(* lignes *)
	IF generalites.nb_departs &lt; 2 THEN
		armoires[index].sorties.V16.F1 := FALSE;
		armoires[index].sorties.V16.F0 := TRUE;
	END_IF;

	(* vanne bouteille *)
	IF NOT(generalites.pres_vanne_bouteille) THEN
		armoires[index].sorties.VBTE.F1 := FALSE;
		armoires[index].sorties.VBTE.F0 := TRUE;
	END_IF;

	(* robinets *)
	IF NOT(generalites.pres_robinets) THEN
		armoires[index].sorties.VHE.F1 := FALSE;
		armoires[index].sorties.VHE.F0 := TRUE;
	END_IF;

end_for;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_Surveillance" type="section" SectionOrder="3"></identProgram>
			<STSource>Gc_Surveillance.Runtime.GC_MAX_STEPS := 28;
Gc_Surveillance.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_Surveillance.Runtime.GC_MAX_ACTIONS := 28;
Gc_Surveillance.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_Surveillance.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_Surveillance.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_Surv[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_Surv[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_Surv[2]); 

(* =========================
TRANSITIONS Surv
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=TRUE', 					_Trans:=Trans_Surv[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_Surv[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=SURV_X1.t&gt;=DLSURV', 			_Trans:=Trans_Surv[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_Surv[1]);
Builder(T:=2,Text:='id=2|s=2|d=0|c=TRUE', 					_Trans:=Trans_Surv[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_Surv[2]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=RAZ CPT|k=0|s=0', 				_Act:=Acts_Surv[0]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_Surv[0]);
Builder(T:=3,Text:='id=1|n=VERIF CPT|k=0|s=1', 				_Act:=Acts_Surv[1]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_Surv[1]);
Builder(T:=3,Text:='id=2|n=RAZ CPT|k=5|s=2', 				_Act:=Acts_Surv[2]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_Surv[2]);

Ctrl_Surv.Cmd.ForceStepFromId := -1;
Ctrl_Surv.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_Surv[0].EnableCond := TRUE;
Acts_Surv[1].EnableCond := TRUE;
Acts_Surv[2].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_Surv[0].Condition  := true;
Trans_Surv[1].Condition  := Steps_Surv[1].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURV) * 60.0 * 1000.0);     				
Trans_Surv[2].Condition  := true;

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_Surv.Cmd.Enable := configuree;
Ctrl_Surv.Cmd.ModeReq := 1;

Gc_Surveillance(
    Enable := Ctrl_Surv.Cmd.Enable,
    ModeReq := Ctrl_Surv.Cmd.ModeReq,
    FreezeReq := Ctrl_Surv.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_Surv.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_Surv.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_Surv.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_Surv.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_Surv.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_Surv.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_Surv.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_Surv.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_Surv.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_Surv,
    Transitions := Trans_Surv,
    Actions := Acts_Surv
);

(* Retour statut *)
Ctrl_Surv.Stat.Cycle := Gc_Surveillance.Runtime.Cycle;
Ctrl_Surv.Stat.Phase := Gc_Surveillance.Runtime.Phase;
Ctrl_Surv.Stat.Mode := Gc_Surveillance.Runtime.Mode;
Ctrl_Surv.Stat.ActiveStepCount := Gc_Surveillance.Debug.ActiveStepCount;
Ctrl_Surv.Stat.LastTransitionFiredId := Gc_Surveillance.Debug.LastTransitionFiredId;
Ctrl_Surv.Stat.ConfigFault := Gc_Surveillance.Debug.ConfigFault;
Ctrl_Surv.Stat.WatchdogDetected := Gc_Surveillance.Debug.WatchdogDetected;
Ctrl_Surv.Stat.NoActiveStepFault := Gc_Surveillance.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_Surv.Cmd.StepReq := FALSE;
Ctrl_Surv.Cmd.InitReq := FALSE;
Ctrl_Surv.Cmd.ResetInitialReq := FALSE;
Ctrl_Surv.Cmd.ResetAllReq := FALSE;
Ctrl_Surv.Cmd.ForceBackReq := FALSE;
Ctrl_Surv.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_SurpressionA" type="section" SectionOrder="4"></identProgram>
			<STSource>Gc_SurpressionA.Runtime.GC_MAX_STEPS := 28;
Gc_SurpressionA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_SurpressionA.Runtime.GC_MAX_ACTIONS := 28;
Gc_SurpressionA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_SurpressionA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_SurpressionA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_SurpA[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_SurpA[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_SurpA[2]);
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_SurpA[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_SurpA[4]);
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_SurpA[5]); 
Builder(T:=1,Text:='id=6|n=X10', 						_Step:=Steps_SurpA[6]);

(* =========================
TRANSITIONS SURP
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=PT3&lt;=SP3', 				_Trans:=Trans_SurpA[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=ARMOIRE EN DEFAUT', 			_Trans:=Trans_SurpA[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[1]);
Builder(T:=2,Text:='id=7|s=1|d=6|c=ARMOIRE PRETE', 				_Trans:=Trans_SurpA[7]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[7]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=PT3&lt;=SP3B OU TIMEOUT', 			_Trans:=Trans_SurpA[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=PT3&lt;=SP3B', 				_Trans:=Trans_SurpA[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[3]);
Builder(T:=2,Text:='id=4|s=3|d=5|c=TIMEOUT', 				_Trans:=Trans_SurpA[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[4]);
Builder(T:=2,Text:='id=5|s=4|d=0|c=TRUE', 					_Trans:=Trans_SurpA[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[5]);
Builder(T:=2,Text:='id=6|s=5|d=0|c=TRUE', 					_Trans:=Trans_SurpA[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[6]);
Builder(T:=2,Text:='id=8|s=6|d=0|c=FIN BASCULEMENT', 			_Trans:=Trans_SurpA[8]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpA[8]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=ATTENTE|k=0|s=0', 						_Act:=Acts_SurpA[0]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[0]);
Builder(T:=3,Text:='id=1|n=ATTENTE|k=0|s=1', 						_Act:=Acts_SurpA[1]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[1]);
Builder(T:=3,Text:='id=2|n=SET_TIMEOUT|k=2|s=2', 						_Act:=Acts_SurpA[2]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP3)*1000.0), 	_Act:=Acts_SurpA[2]);
Builder(T:=3,Text:='id=3|n=FV5|k=0|s=2', 							_Act:=Acts_SurpA[3]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[3]);
Builder(T:=3,Text:='id=4|n=OV7|k=11|s=2', 							_Act:=Acts_SurpA[4]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP1)*1000.0), 	_Act:=Acts_SurpA[4]);
Builder(T:=3,Text:='id=5|n=OVS|k=11|s=2', 							_Act:=Acts_SurpA[5]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP2)*1000.0), 	_Act:=Acts_SurpA[5]);
Builder(T:=3,Text:='id=6|n=DEFAUT|k=5|s=3', 						_Act:=Acts_SurpA[6]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[6]);
Builder(T:=3,Text:='id=7|n=PAS DE DEFAUT|k=5|s=3', 						_Act:=Acts_SurpA[7]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[7]);
Builder(T:=3,Text:='id=8|n=DEFORCAGE VS|k=11|s=4', 						_Act:=Acts_SurpA[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP4)*1000.0), 	_Act:=Acts_SurpA[8]);
Builder(T:=3,Text:='id=9|n=DEFORCAGE V7|k=11|s=4', 						_Act:=Acts_SurpA[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP5)*1000.0), 	_Act:=Acts_SurpA[9]);
Builder(T:=3,Text:='id=10|n=DEFORCAGE V5|k=5|s=4', 						_Act:=Acts_SurpA[10]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[10]);
Builder(T:=3,Text:='id=11|n=ATTENTE|k=0|s=5', 						_Act:=Acts_SurpA[11]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[11]);
Builder(T:=3,Text:='id=12|n=BASCULEMENT|k=1|s=6', 						_Act:=Acts_SurpA[12]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpA[12]);

Ctrl_SurpA.Cmd.ForceStepFromId := -1;
Ctrl_SurpA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_SurpA[0].EnableCond := TRUE;
Acts_SurpA[1].EnableCond := TRUE;
Acts_SurpA[2].EnableCond := not(timeout_atteintA);
Acts_SurpA[3].EnableCond := TRUE;
Acts_SurpA[4].EnableCond := armoires[0].ana.PT3.mes &gt;= INT_TO_REAL(config_utilisee.surpression.SP3H);
Acts_SurpA[5].EnableCond := Acts_SurpA[4].Started AND Acts_SurpA[4].Finished;
Acts_SurpA[6].EnableCond := timeout_atteintA;
Acts_SurpA[7].EnableCond := armoires[0].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B);
Acts_SurpA[8].EnableCond := TRUE;
Acts_SurpA[9].EnableCond := Acts_SurpA[8].Started AND Acts_SurpA[8].Finished;
Acts_SurpA[10].EnableCond := Acts_SurpA[9].Started AND Acts_SurpA[9].Finished;
Acts_SurpA[11].EnableCond := TRUE;
Acts_SurpA[12].EnableCond := armoires[1].prete;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_SurpA[0].Condition  := armoires[0].prete and armoires[0].ana.PT3.mes &gt;= INT_TO_REAL(config_utilisee.surpression.SP3);
Trans_SurpA[1].Condition  := not(armoires[1].prete) or armoires[1].manu;     				
Trans_SurpA[7].Condition  := armoires[1].prete and not(armoires[1].manu);
Trans_SurpA[2].Condition  := Steps_SurpA[2].ActiveTime &gt;= t#1s and ((armoires[0].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B) or timeout_atteintA) and (not(Acts_SurpA[4].Started) or (Acts_SurpA[4].Started and Acts_SurpA[4].Finished and Acts_SurpA[5].Finished)));
Trans_SurpA[3].Condition  := armoires[0].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B);
Trans_SurpA[4].Condition  := timeout_atteintA;
Trans_SurpA[5].Condition  := Steps_SurpA[4].ActiveTime &gt;= t#1s and (not(Acts_SurpA[8].Started) or (Acts_SurpA[8].Started and Acts_SurpA[8].Finished and Acts_SurpA[9].Finished));
Trans_SurpA[6].Condition  := Steps_SurpA[5].ActiveTime &gt;= t#1s and not(armoires[0].en_cours_de_basculement);
Trans_SurpA[8].Condition  := Steps_SurpA[6].ActiveTime &gt;= t#1s and not(armoires[0].en_cours_de_basculement);

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_SurpA.Cmd.Enable := configuree and not(armoires[0].manu) and not(armoires[0].en_cours_de_chgt) and not(armoires[0].retour_sur_chgt) and not(armoires[0].retour_sur_chgt_ap_decl);
Ctrl_SurpA.Cmd.ModeReq := 1;
IF NOT(Ctrl_SurpA.Cmd.Enable) THEN armoires[0].CycleSurpressionBit := FALSE; END_IF;

Gc_SurpressionA(
    Enable := Ctrl_SurpA.Cmd.Enable,
    ModeReq := Ctrl_SurpA.Cmd.ModeReq,
    FreezeReq := Ctrl_SurpA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_SurpA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_SurpA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_SurpA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_SurpA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_SurpA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_SurpA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_SurpA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_SurpA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_SurpA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_SurpA,
    Transitions := Trans_SurpA,
    Actions := Acts_SurpA
);

(* Retour statut *)
Ctrl_SurpA.Stat.Cycle := Gc_SurpressionA.Runtime.Cycle;
Ctrl_SurpA.Stat.Phase := Gc_SurpressionA.Runtime.Phase;
Ctrl_SurpA.Stat.Mode := Gc_SurpressionA.Runtime.Mode;
Ctrl_SurpA.Stat.ActiveStepCount := Gc_SurpressionA.Debug.ActiveStepCount;
Ctrl_SurpA.Stat.LastTransitionFiredId := Gc_SurpressionA.Debug.LastTransitionFiredId;
Ctrl_SurpA.Stat.ConfigFault := Gc_SurpressionA.Debug.ConfigFault;
Ctrl_SurpA.Stat.WatchdogDetected := Gc_SurpressionA.Debug.WatchdogDetected;
Ctrl_SurpA.Stat.NoActiveStepFault := Gc_SurpressionA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_SurpA.Cmd.StepReq := FALSE;
Ctrl_SurpA.Cmd.InitReq := FALSE;
Ctrl_SurpA.Cmd.ResetInitialReq := FALSE;
Ctrl_SurpA.Cmd.ResetAllReq := FALSE;
Ctrl_SurpA.Cmd.ForceBackReq := FALSE;
Ctrl_SurpA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_SurpressionB" type="section" SectionOrder="5"></identProgram>
			<STSource>Gc_SurpressionB.Runtime.GC_MAX_STEPS := 28;
Gc_SurpressionB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_SurpressionB.Runtime.GC_MAX_ACTIONS := 28;
Gc_SurpressionB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_SurpressionB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_SurpressionB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_SurpB[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_SurpB[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_SurpB[2]);
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_SurpB[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_SurpB[4]);
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_SurpB[5]); 
Builder(T:=1,Text:='id=6|n=X10', 						_Step:=Steps_SurpB[6]);

(* =========================
TRANSITIONS SURP
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=PT3&lt;=SP3', 				_Trans:=Trans_SurpB[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=ARMOIRE EN DEFAUT', 			_Trans:=Trans_SurpB[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[1]);
Builder(T:=2,Text:='id=7|s=1|d=6|c=ARMOIRE PRETE', 				_Trans:=Trans_SurpB[7]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[7]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=PT3&lt;=SP3B OU TIMEOUT', 			_Trans:=Trans_SurpB[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=PT3&lt;=SP3B', 				_Trans:=Trans_SurpB[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[3]);
Builder(T:=2,Text:='id=4|s=3|d=5|c=TIMEOUT', 				_Trans:=Trans_SurpB[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[4]);
Builder(T:=2,Text:='id=5|s=4|d=0|c=TRUE', 					_Trans:=Trans_SurpB[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[5]);
Builder(T:=2,Text:='id=6|s=5|d=0|c=TRUE', 					_Trans:=Trans_SurpB[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[6]);
Builder(T:=2,Text:='id=8|s=6|d=0|c=FIN BASCULEMENT', 			_Trans:=Trans_SurpB[8]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_SurpB[8]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=ATTENTE|k=0|s=0', 						_Act:=Acts_SurpB[0]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[0]);
Builder(T:=3,Text:='id=1|n=ATTENTE|k=0|s=1', 						_Act:=Acts_SurpB[1]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[1]);
Builder(T:=3,Text:='id=2|n=SET_TIMEOUT|k=2|s=2', 						_Act:=Acts_SurpB[2]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP3)*1000.0), 	_Act:=Acts_SurpB[2]);
Builder(T:=3,Text:='id=3|n=FV5|k=0|s=2', 							_Act:=Acts_SurpB[3]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[3]);
Builder(T:=3,Text:='id=4|n=OV7|k=11|s=2', 							_Act:=Acts_SurpB[4]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP1)*1000.0), 	_Act:=Acts_SurpB[4]);
Builder(T:=3,Text:='id=5|n=OVS|k=11|s=2', 							_Act:=Acts_SurpB[5]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP2)*1000.0), 	_Act:=Acts_SurpB[5]);
Builder(T:=3,Text:='id=6|n=DEFAUT|k=5|s=3', 						_Act:=Acts_SurpB[6]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[6]);
Builder(T:=3,Text:='id=7|n=PAS DE DEFAUT|k=5|s=3', 						_Act:=Acts_SurpB[7]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[7]);
Builder(T:=3,Text:='id=8|n=DEFORCAGE VS|k=11|s=4', 						_Act:=Acts_SurpB[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP4)*1000.0), 	_Act:=Acts_SurpB[8]);
Builder(T:=3,Text:='id=9|n=DEFORCAGE V7|k=11|s=4', 						_Act:=Acts_SurpB[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.surpression.DLSURP5)*1000.0), 	_Act:=Acts_SurpB[9]);
Builder(T:=3,Text:='id=10|n=DEFORCAGE V5|k=5|s=4', 						_Act:=Acts_SurpB[10]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[10]);
Builder(T:=3,Text:='id=11|n=ATTENTE|k=0|s=5', 						_Act:=Acts_SurpB[11]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[11]);
Builder(T:=3,Text:='id=12|n=BASCULEMENT|k=1|s=6', 						_Act:=Acts_SurpB[12]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_SurpB[12]);

Ctrl_SurpB.Cmd.ForceStepFromId := -1;
Ctrl_SurpB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_SurpB[0].EnableCond := TRUE;
Acts_SurpB[1].EnableCond := TRUE;
Acts_SurpB[2].EnableCond := not(timeout_atteintB);
Acts_SurpB[3].EnableCond := TRUE;
Acts_SurpB[4].EnableCond := armoires[1].ana.PT3.mes &gt;= INT_TO_REAL(config_utilisee.surpression.SP3H);
Acts_SurpB[5].EnableCond := Acts_SurpB[4].Started AND Acts_SurpB[4].Finished;
Acts_SurpB[6].EnableCond := timeout_atteintB;
Acts_SurpB[7].EnableCond := armoires[1].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B);
Acts_SurpB[8].EnableCond := TRUE;
Acts_SurpB[9].EnableCond := Acts_SurpB[8].Started AND Acts_SurpB[8].Finished;
Acts_SurpB[10].EnableCond := Acts_SurpB[9].Started AND Acts_SurpB[9].Finished;
Acts_SurpB[11].EnableCond := TRUE;
Acts_SurpB[12].EnableCond := armoires[0].prete;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_SurpB[0].Condition  := armoires[1].prete and armoires[1].ana.PT3.mes &gt;= INT_TO_REAL(config_utilisee.surpression.SP3);
Trans_SurpB[1].Condition  := not(armoires[0].prete) or armoires[0].manu;     				
Trans_SurpB[7].Condition  := armoires[0].prete and not(armoires[0].manu);
Trans_SurpB[2].Condition  := Steps_SurpB[2].ActiveTime &gt;= t#1s and ((armoires[1].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B) or timeout_atteintB) and (not(Acts_SurpB[4].Started) or (Acts_SurpB[4].Started and Acts_SurpB[4].Finished and Acts_SurpB[5].Finished)));
Trans_SurpB[3].Condition  := armoires[1].ana.PT3.mes &lt;= INT_TO_REAL(config_utilisee.surpression.SP3B);
Trans_SurpB[4].Condition  := timeout_atteintB;
Trans_SurpB[5].Condition  := Steps_SurpB[4].ActiveTime &gt;= t#1s and (not(Acts_SurpB[8].Started) or (Acts_SurpB[8].Started and Acts_SurpB[8].Finished and Acts_SurpB[9].Finished));
Trans_SurpB[6].Condition  := Steps_SurpB[5].ActiveTime &gt;= t#1s and not(armoires[1].en_cours_de_basculement);
Trans_SurpB[8].Condition  := Steps_SurpB[6].ActiveTime &gt;= t#1s and not(armoires[1].en_cours_de_basculement);

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_SurpB.Cmd.Enable := configuree and not(armoires[1].manu) and not(armoires[1].en_cours_de_chgt) and not(armoires[1].retour_sur_chgt) and not(armoires[1].retour_sur_chgt_ap_decl);
Ctrl_SurpB.Cmd.ModeReq := 1;
IF NOT(Ctrl_SurpB.Cmd.Enable) THEN armoires[1].CycleSurpressionBit := FALSE; END_IF;

Gc_SurpressionB(
    Enable := Ctrl_SurpB.Cmd.Enable,
    ModeReq := Ctrl_SurpB.Cmd.ModeReq,
    FreezeReq := Ctrl_SurpB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_SurpB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_SurpB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_SurpB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_SurpB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_SurpB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_SurpB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_SurpB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_SurpB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_SurpB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_SurpB,
    Transitions := Trans_SurpB,
    Actions := Acts_SurpB
);

(* Retour statut *)
Ctrl_SurpB.Stat.Cycle := Gc_SurpressionB.Runtime.Cycle;
Ctrl_SurpB.Stat.Phase := Gc_SurpressionB.Runtime.Phase;
Ctrl_SurpB.Stat.Mode := Gc_SurpressionB.Runtime.Mode;
Ctrl_SurpB.Stat.ActiveStepCount := Gc_SurpressionB.Debug.ActiveStepCount;
Ctrl_SurpB.Stat.LastTransitionFiredId := Gc_SurpressionB.Debug.LastTransitionFiredId;
Ctrl_SurpB.Stat.ConfigFault := Gc_SurpressionB.Debug.ConfigFault;
Ctrl_SurpB.Stat.WatchdogDetected := Gc_SurpressionB.Debug.WatchdogDetected;
Ctrl_SurpB.Stat.NoActiveStepFault := Gc_SurpressionB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_SurpB.Cmd.StepReq := FALSE;
Ctrl_SurpB.Cmd.InitReq := FALSE;
Ctrl_SurpB.Cmd.ResetInitialReq := FALSE;
Ctrl_SurpB.Cmd.ResetAllReq := FALSE;
Ctrl_SurpB.Cmd.ForceBackReq := FALSE;
Ctrl_SurpB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_Surveillance_Actions" type="section" SectionOrder="6"></identProgram>
			<STSource>FOR index := 0 TO 1 DO

    (* ____________________________________________________________________ *)
    (* SURV_X0 *)
    IF Acts_Surv[0].Out THEN
        armoires[index].compteur_cycle_surpression := 0;
    END_IF;

    (* ____________________________________________________________________ *)
    (* SURV_X1 *)
    IF Acts_Surv[1].Out THEN
        IF armoires[index].compteur_cycle_surpression &gt;= config_utilisee.surpression.NBS
           AND NOT armoires[index].defs.surpression THEN

            armoires[index].defs.surpression := TRUE;
            armoires[index].compteur_cycle_surpression := 0;
        END_IF;
    END_IF;

    (* ____________________________________________________________________ *)
    (* SURV_X2 *)
    IF Acts_Surv[2].Out THEN
        armoires[index].compteur_cycle_surpression := 0;
    END_IF;

END_FOR;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_SurpressionA_Actions" type="section" SectionOrder="7"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* SURP_X0 *)
if Acts_SurpA[0].Out then
	timeout_atteintA := FALSE;
	armoires[0].CycleSurpressionBit := FALSE;
end_if;
(* ____________________________________________________________________ *)


(* ____________________________________________________________________ *)
(* SURP_X1 *)
if Acts_SurpA[1].Out then
	armoires[0].CycleSurpressionBit := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X2 *)
if Acts_SurpA[2].Out then
	timeout_atteintA := true;
end_if;

if Acts_SurpA[3].Out then
	armoires[0].sorties.V5.F1 := FALSE;
	armoires[0].sorties.V5.F0 := TRUE;
end_if;

if Acts_SurpA[4].Out then
	armoires[0].sorties.V7.F0 := FALSE;
	armoires[0].sorties.V7.F1 := TRUE;
end_if;

if Acts_SurpA[5].Out then
	armoires[0].sorties.VS.F0 := FALSE;
	armoires[0].sorties.VS.F1 := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X3 *)
if Acts_SurpA[6].Out then
	if (armoires[1].prete) then
		armoires[0].demande_basculement := TRUE;
	end_if;
	armoires[0].defs.surpression := TRUE;
end_if;

if Acts_SurpA[7].Out then
	armoires[0].compteur_cycle_surpression := armoires[0].compteur_cycle_surpression + 1;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X4 *)

if Acts_SurpA[8].Out then
	armoires[0].sorties.VS.F0 := TRUE;
	armoires[0].sorties.VS.F1 := FALSE;
end_if;

if Acts_SurpA[9].Out then
	armoires[0].sorties.V7.F0 := TRUE;
	armoires[0].sorties.V7.F1 := FALSE;
end_if;

if Acts_SurpA[10].Out then
	armoires[0].sorties.V5.F0 := FALSE;
	armoires[0].sorties.V5.F1 := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X5 *)


(* ____________________________________________________________________ *)
(* SURP_X10 *)
if Acts_SurpA[12].Out  then
	armoires[0].demande_basculement := TRUE;
	armoires[0].defs.surpression := TRUE;
end_if;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_SurpressionB_Actions" type="section" SectionOrder="8"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* SURP_X0 *)
if Acts_SurpB[0].Out then
	timeout_atteintB := FALSE;
	armoires[1].CycleSurpressionBit := FALSE;
end_if;
(* ____________________________________________________________________ *)


(* ____________________________________________________________________ *)
(* SURP_X1 *)
if Acts_SurpB[1].Out then
	armoires[1].CycleSurpressionBit := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X2 *)
if Acts_SurpB[2].Out then
	timeout_atteintB := true;
end_if;

if Acts_SurpB[3].Out then
	armoires[1].sorties.V5.F1 := FALSE;
	armoires[1].sorties.V5.F0 := TRUE;
end_if;

if Acts_SurpB[4].Out then
	armoires[1].sorties.V7.F0 := FALSE;
	armoires[1].sorties.V7.F1 := TRUE;
end_if;

if Acts_SurpB[5].Out then
	armoires[1].sorties.VS.F0 := FALSE;
	armoires[1].sorties.VS.F1 := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X3 *)
if Acts_SurpB[6].Out then
	if (armoires[0].prete) then
		armoires[1].demande_basculement := TRUE;
	end_if;
	armoires[1].defs.surpression := TRUE;
end_if;

if Acts_SurpB[7].Out then
	armoires[1].compteur_cycle_surpression := armoires[1].compteur_cycle_surpression + 1;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X4 *)

if Acts_SurpB[8].Out then
	armoires[1].sorties.VS.F0 := TRUE;
	armoires[1].sorties.VS.F1 := FALSE;
end_if;

if Acts_SurpB[9].Out then
	armoires[1].sorties.V7.F0 := TRUE;
	armoires[1].sorties.V7.F1 := FALSE;
end_if;

if Acts_SurpB[10].Out then
	armoires[1].sorties.V5.F0 := FALSE;
	armoires[1].sorties.V5.F1 := TRUE;
end_if;

(* ____________________________________________________________________ *)
(* SURP_X5 *)


(* ____________________________________________________________________ *)
(* SURP_X10 *)
if Acts_SurpB[12].Out  then
	armoires[1].demande_basculement := TRUE;
	armoires[1].defs.surpression := TRUE;
end_if;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Declenchement" type="section" SectionOrder="9"></identProgram>
			<STSource>for index := 0 to 1 do

	armoires[index].en_declenchement := false;	
	
	(* acquittement *)
	if (acquit or acquittements[index]) then
		if (armoires[index].ana.PT3.mes &lt; INT_TO_REAL(config_utilisee.surpression.SP3) and armoires[index].defs.surpression) then
			armoires[index].defs.surpression := false;
		end_if;

		if (not(armoires[index].entrees.fuite_gazbox) and armoires[index].defs.fuite_gazbox) then
			armoires[index].defs.fuite_gazbox := false;
		end_if;

		if (not(armoires[index].entrees.fuite_gazroom) and armoires[index].defs.fuite_gazroom) then
			armoires[index].defs.fuite_gazroom := false;
		end_if;

		if (not(armoires[index].entrees.extraction) and armoires[index].defs.manque_extraction) then
			armoires[index].defs.manque_extraction := false;
		end_if;

		if (not(armoires[index].entrees.manque_tension) and armoires[index].defs.manque_tension) then
			armoires[index].defs.manque_tension := false;
		end_if;
		
		if (not(armoires[index].entrees.porte) and armoires[index].defs.porte) then
			armoires[index].defs.porte := false;
		end_if;

		if (not(armoires[index].entrees.au) and armoires[index].defs.au) then
			armoires[index].defs.au := false;
		end_if;

		if (armoires[index].entrees.span_N2 and armoires[index].defs.span) then
			armoires[index].defs.span := false;
		end_if;

		if ((generalites.nb_departs &lt; 1 or not(armoires[index].entrees.D1[0])) and armoires[index].defs.env1) then
			armoires[index].defs.env1 := false;
		end_if;		
		
		if ((generalites.nb_departs &lt; 1 or not(armoires[index].entrees.D1[1])) and armoires[index].defs.env1B) then
			armoires[index].defs.env1B := false;
		end_if;

		if ((generalites.nb_departs &lt; 2 or not(armoires[index].entrees.D2[0])) and armoires[index].defs.env2) then
			armoires[index].defs.env2 := false;
		end_if;		
		
		if ((generalites.nb_departs &lt; 2 or not(armoires[index].entrees.D2[1])) and armoires[index].defs.env2B) then
			armoires[index].defs.env2B := false;
		end_if;

	end_if;
	
	if (armoires[index].entrees.fuite_gazbox) then armoires[index].defs.fuite_gazbox := true; end_if;
	if (armoires[index].entrees.fuite_gazroom) then armoires[index].defs.fuite_gazroom := true; end_if;
	if (armoires[index].entrees.extraction) then armoires[index].defs.manque_extraction := true; end_if;
	if (armoires[index].entrees.manque_tension) then armoires[index].defs.manque_tension := true; end_if;
	if (armoires[index].entrees.au) then armoires[index].defs.au := true; end_if;
	if (armoires[index].entrees.D1[0] and generalites.nb_departs &gt;= 1) then armoires[index].defs.env1 := true; end_if;
	if (armoires[index].entrees.D1[1] and generalites.nb_departs &gt;= 1) then armoires[index].defs.env1B := true; end_if;
	if (armoires[index].entrees.D2[0] and generalites.nb_departs &gt;= 2) then armoires[index].defs.env2 := true; end_if;
	if (armoires[index].entrees.D2[1] and generalites.nb_departs &gt;= 2) then armoires[index].defs.env2B := true; end_if;
	if (not(armoires[index].entrees.span_N2)) then armoires[index].defs.span := true; end_if;
	if (armoires[index].entrees.porte) then armoires[index].defs.porte := true; end_if;
	
	(* basculement *)
	if (armoires[index].defs.surpression and not(armoires[index].en_cours_de_chgt) or
		armoires[index].defs.fuite_gazbox or 
		armoires[index].defs.fuite_gazroom or 
		armoires[index].defs.manque_extraction and not(armoires[index].en_cours_de_chgt) or
		armoires[index].defs.manque_tension or
		armoires[index].defs.porte and not(armoires[index].en_cours_de_chgt) or
		armoires[index].defs.env1 and generalites.nb_departs &lt; 2 or
		armoires[index].defs.env1 and armoires[index].defs.env2 and generalites.nb_departs &gt;= 2) then
			armoires[index].en_declenchement := true;
			if (armoires[index].en_declenchement and not(armoires[index].PrevDecl)) then
				if (armoires[index].en_cours_de_chgt) then
					armoires[index].en_cours_de_chgt := false;
					armoires[index].en_cours_de_chgt_avant := false;
					armoires[index].en_cours_de_chgt_apres := false;
					armoires[index].retour_sur_chgt_ap_decl := true;
				end_if;
			end_if;
	end_if;

	if (armoires[index].PrevDecl and not(armoires[index].en_declenchement)) then
		if (armoires[index].retour_sur_chgt_ap_decl) then
			armoires[index].en_cours_de_chgt := true;
			armoires[index].en_cours_de_chgt_avant := true;
			armoires[index].init_chgt := true;
		end_if;
	end_if;

	armoires[index].PrevDecl := armoires[index].en_declenchement; 
end_for;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Bouteilles_vides" type="section" SectionOrder="10"></identProgram>
			<STSource>for index := 0 to 1 do

	flag_bouteille_vide[index] := false;
	flag_bouteille_presque_vide[index] := false;	
	
	(* si basculement sur pression *)
	if not(armoires[index].en_cours_de_chgt) then
		if (generalites.conf_pression) then
		
			if (armoires[index].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.basc.SEUILPREAL1)) then
				flag_bouteille_presque_vide[index] := true;
			end_if;

			if (armoires[index].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.basc.SPBASC1)) then
				flag_bouteille_vide[index] := true;
			end_if;
		end_if;
	
		(* si basculement sur poids *)
		if (generalites.conf_poids) then
		
			if (armoires[index].PoidsBouteille &lt;= INT_TO_REAL(config_utilisee.basc.SEUILPREAL2)) then
				flag_bouteille_presque_vide[index] := true;
			end_if;

			if (armoires[index].PoidsBouteille &lt;= INT_TO_REAL(config_utilisee.basc.SPBASC2)) then
				flag_bouteille_vide[index] := true;
			end_if;
		end_if;
	end_if;

end_for;

TON_PRESQUE_VIDE_0 (IN := flag_bouteille_presque_vide[0] and not(armoires[0].Manu) and not(armoires[0].en_cours_de_chgt), PT := UDINT_TO_TIME(INT_TO_UDINT(config_utilisee.basc.DLBASC2) * 1000));
TON_PRESQUE_VIDE_1 (IN := flag_bouteille_presque_vide[1] and not(armoires[1].Manu) and not(armoires[1].en_cours_de_chgt), PT := UDINT_TO_TIME(INT_TO_UDINT(config_utilisee.basc.DLBASC2) * 1000));
TON_VIDE_0 (IN := flag_bouteille_vide[0] and not(armoires[0].Manu) and not(armoires[0].en_cours_de_chgt), PT := UDINT_TO_TIME(INT_TO_UDINT(config_utilisee.basc.DLBASC1) * 1000));
TON_VIDE_1 (IN := flag_bouteille_vide[1] and not(armoires[1].Manu) and not(armoires[1].en_cours_de_chgt), PT := UDINT_TO_TIME(INT_TO_UDINT(config_utilisee.basc.DLBASC1) * 1000));

if Acquit or acquittements[0] or acquittements[1] then
	if Acquit or acquittements[0] then
		armoires[0].bouteille_presque_vide := false; armoires[0].bouteille_vide := false;
	end_if;
	if Acquit or acquittements[1] then
		armoires[1].bouteille_presque_vide := false; armoires[1].bouteille_vide := false;
	end_if;
end_if;

if TON_PRESQUE_VIDE_0.Q then armoires[0].bouteille_presque_vide := true; end_if;
if TON_PRESQUE_VIDE_1.Q then armoires[1].bouteille_presque_vide := true; end_if;
if TON_VIDE_0.Q then armoires[0].bouteille_vide := true; end_if;
if TON_VIDE_1.Q then armoires[1].bouteille_vide := true; end_if;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Armoires_pretes" type="section" SectionOrder="11"></identProgram>
			<STSource>for index := 0 to 1 do

	(* informations spécifiques à chaque armoire *)
	armoires[index].prete := 	
				not(armoires[index].entrees.porte) and
				not(armoires[index].entrees.AU) and
			        (generalites.nb_departs &lt; 1 or not(armoires[index].entrees.D1[0])) and
			        (generalites.nb_departs &lt; 2 or (not(armoires[index].entrees.D1[0]) or not(armoires[index].entrees.D2[0]))) and
			        not(armoires[index].entrees.fuite_gazbox) and
				not(armoires[index].entrees.fuite_gazroom) and
				not(armoires[index].entrees.extraction) and
			        not(armoires[index].entrees.Manque_tension) and
				not(armoires[index].en_declenchement) and
				not(armoires[index].en_cours_de_chgt) and
				not(armoires[index].bouteille_vide) and
				generalites.configuree;

	armoires[index].physiquement_prete := 	
				not(armoires[index].entrees.porte) and
				not(armoires[index].entrees.AU) and
			        (generalites.nb_departs &lt; 1 or not(armoires[index].entrees.D1[0])) and
			        (generalites.nb_departs &lt; 2 or (not(armoires[index].entrees.D1[0]) or not(armoires[index].entrees.D2[0]))) and
			        not(armoires[index].entrees.fuite_gazbox) and
				not(armoires[index].entrees.fuite_gazroom) and
				not(armoires[index].entrees.extraction) and
			        not(armoires[index].entrees.Manque_tension) and
				not(armoires[index].en_declenchement) and
				generalites.configuree;

end_for;

PasDeBasculementEnCours := not(armoires[0].en_cours_de_basculement) and not(armoires[1].en_cours_de_basculement);
PasDeChangementEnCours := not(armoires[0].en_cours_de_chgt) and not(armoires[1].en_cours_de_chgt);
(* basculement A vers B *)
if (index_armoire_utilisee = 0) then
	if (not(armoires[0].prete) or armoires[0].manu or (armoires[0].demande_basculement and PasDeBasculementEnCours and PasDeChangementEnCours)) then
		if (armoires[1].prete and not(armoires[1].manu)) then
			if (armoires[0].demande_basculement) then
				armoires[0].demande_basculement := false;
			end_if;
			index_armoire_utilisee := 1;
		end_if;
	end_if;
end_if;

(* basculement B vers A *)
if (index_armoire_utilisee = 1) then
	if (not(armoires[1].prete) or armoires[1].manu or (armoires[1].demande_basculement and PasDeBasculementEnCours and PasDeChangementEnCours)) then
		if (armoires[0].prete and not(armoires[0].manu)) then
			if (armoires[1].demande_basculement) then
				armoires[1].demande_basculement := false;
			end_if;
			index_armoire_utilisee := 0;
		end_if;
	end_if;
end_if;

(* basculement sur bouteille vide *)
if (ancien_index_utilise &lt;&gt; index_armoire_utilisee) then
	armoires[ancien_index_utilise].en_cours_de_basculement := true;
end_if;

(* détection pour début changement de bouteille *)
for index := 0 to 1 do
	if PasDeChangementEnCours then
		if (not(armoires[index].prete) and armoires[index].physiquement_prete) and not(armoires[index].en_cours_de_chgt) and not(armoires[index].en_cours_de_chgt_avant) then
			armoires[index].en_cours_de_chgt := true;
			armoires[index].en_cours_de_chgt_avant := true;
		end_if;
	end_if;
end_for;

(* durée d'un basculement *) 
TON_BASCULEMENT (IN := not(PasDeBasculementEnCours), PT := t#5s);
if (TON_BASCULEMENT.Q) then
	IF armoires[0].en_cours_de_basculement THEN
		armoires[0].en_cours_de_basculement := false;
		Close(arm := armoires[0]);
	END_IF;
	IF armoires[1].en_cours_de_basculement THEN
		armoires[1].en_cours_de_basculement := false;
		Close(arm := armoires[1]);
	END_IF;
end_if;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Armoires_actives" type="section" SectionOrder="12"></identProgram>
			<STSource>FOR index := 0 TO 1 DO

    armoires[index].active := armoires[index].prete AND index_armoire_utilisee = index;

    IF armoires[index].active THEN
        armoires[index].CurrentTime := armoires[index].CurrentTime + UDINT_TO_TIME(CycleMs);
        
        armoires[index].CurrentTimeHours   := TIME_TO_UDINT(armoires[index].CurrentTime) / 3600000;
        armoires[index].CurrentTimeMinutes := (TIME_TO_UDINT(armoires[index].CurrentTime) MOD 3600000) / 60000;
    END_IF;

    IF reset_timer[index] THEN
        armoires[index].TotalTimeMs := 0;
    END_IF; 

    IF armoires[index].PrevActive AND NOT armoires[index].active THEN
        armoires[index].TotalTimeMs := armoires[index].TotalTimeMs + TIME_TO_UDINT(armoires[index].CurrentTime);
        armoires[index].CurrentTime := T#0ms;
        armoires[index].CurrentTimeHours := 0;
        armoires[index].CurrentTimeMinutes := 0;
    END_IF;

    armoires[index].TotalTimeHours := armoires[index].TotalTimeMs / 3600000;

    armoires[index].PrevActive := armoires[index].active;

END_FOR;

</STSource>
		</program>
		<program>
			<identProgram name="SFC_DEBUG" type="section" SectionOrder="13"></identProgram>
			<STSource>DEBUG_NOM_ETAPE_SURP_A := -1;
DEBUG_ACT1_SURP_A := -1;
DEBUG_ACT2_SURP_A := -1;
DEBUG_ACT3_SURP_A := -1;
DEBUG_TEMPSETAPE_SURP_A := -1;
DEBUG_TEMPSACT1_SURP_A := -1;
DEBUG_TEMPSACT2_SURP_A := -1;
DEBUG_TEMPSACT3_SURP_A := -1;
DEBUG_TYPE_SURP_A := -1;
if (armoires[0].CycleSurpressionBit) then

	(* avant changement de bouteille *)
	if (armoires[0].CycleSurpressionBit) then
	
		(* surpression *)
		if (Steps_SurpA[2].Active AND Gc_SurpressionA.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_A := 100;
			DEBUG_ACT1_SURP_A := 100;
			DEBUG_ACT2_SURP_A := 100;
			DEBUG_ACT3_SURP_A := 100;
			DEBUG_TEMPSETAPE_SURP_A := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpA[2].ActiveTime) / UDINT#1000);

			DEBUG_TEMPSACT2_SURP_A := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpA[4].TONElapsed) / UDINT#1000);
			IF Acts_SurpA[4].Finished THEN DEBUG_TEMPSACT2_SURP_A := -1; END_IF;
			DEBUG_TEMPSACT3_SURP_A := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpA[5].TONElapsed) / UDINT#1000);
			IF Acts_SurpA[5].Finished THEN DEBUG_TEMPSACT3_SURP_A := -1; END_IF;
			end_if;
		
		(* surpression *)
		if (Steps_SurpA[6].Active AND Gc_SurpressionA.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_A := 101;
			DEBUG_ACT1_SURP_A := 101;
			DEBUG_TEMPSETAPE_SURP_A := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpA[6].ActiveTime) / UDINT#1000);
		end_if;

		(* surpression *)
		if (Steps_SurpA[4].Active AND Gc_SurpressionA.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_A := 102;
			DEBUG_ACT1_SURP_A := 102;
			DEBUG_ACT2_SURP_A := 101;
			DEBUG_ACT3_SURP_A := 101;
			DEBUG_TEMPSETAPE_SURP_A := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpA[4].ActiveTime) / UDINT#1000);
		end_if;

	end_if;
end_if;

DEBUG_NOM_ETAPE_SURP_B := -1;
DEBUG_ACT1_SURP_B := -1;
DEBUG_ACT2_SURP_B := -1;
DEBUG_ACT3_SURP_B := -1;
DEBUG_TEMPSETAPE_SURP_B := -1;
DEBUG_TEMPSACT1_SURP_B := -1;
DEBUG_TEMPSACT2_SURP_B := -1;
DEBUG_TEMPSACT3_SURP_B := -1;
DEBUG_TYPE_SURP_B := -1;
if (armoires[1].CycleSurpressionBit) then

	(* avant changement de bouteille *)
	if (armoires[1].CycleSurpressionBit) then
	
		(* surpression *)
		if (Steps_SurpB[2].Active AND Gc_SurpressionB.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_B := 100;
			DEBUG_ACT1_SURP_B := 100;
			DEBUG_ACT2_SURP_B := 100;
			DEBUG_ACT3_SURP_B := 100;
			DEBUG_TEMPSETAPE_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpB[2].ActiveTime) / UDINT#1000);

			DEBUG_TEMPSACT2_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpB[4].TONElapsed) / UDINT#1000);
			IF Acts_SurpB[4].Finished THEN DEBUG_TEMPSACT2_SURP_B := -1; END_IF;
			DEBUG_TEMPSACT3_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpB[5].TONElapsed) / UDINT#1000);
			IF Acts_SurpB[5].Finished THEN DEBUG_TEMPSACT3_SURP_B := -1; END_IF;
			end_if;
		
		(* surpression *)
		if (Steps_SurpB[6].Active AND Gc_SurpressionB.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_B := 101;
			DEBUG_ACT1_SURP_B := 101;
			DEBUG_TEMPSETAPE_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpB[6].ActiveTime) / UDINT#1000);
		end_if;

		(* surpression *)
		if (Steps_SurpB[4].Active AND Gc_SurpressionB.ModeReqOut = 1) then
			DEBUG_NOM_ETAPE_SURP_B := 102;
			DEBUG_ACT1_SURP_B := 102;
			DEBUG_ACT2_SURP_B := 101;
			DEBUG_ACT3_SURP_B := 101;
			DEBUG_TEMPSETAPE_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Steps_SurpB[4].ActiveTime) / UDINT#1000);

			DEBUG_TEMPSACT1_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpB[8].TONElapsed) / UDINT#1000);
			IF Acts_SurpB[8].Finished THEN DEBUG_TEMPSACT1_SURP_B := -1; END_IF;
			DEBUG_TEMPSACT2_SURP_B := UDINT_TO_DINT(TIME_TO_UDINT(Acts_SurpB[9].TONElapsed) / UDINT#1000);
			IF Acts_SurpB[9].Finished THEN DEBUG_TEMPSACT2_SURP_B := -1; END_IF;
		end_if;

	end_if;
end_if;
</STSource>
		</program>
