			<variables name="Acts_ManuA" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="Ctrl_ManuA" typeName="ST_GC_CTRL"></variables>
			<variables name="InitDone_ManuA" typeName="EBOOL"></variables>
			<variables name="Autorise" typeName="BOOL"></variables>
			<variables name="i" typeName="DINT"></variables>
			<variables name="j" typeName="DINT"></variables>
			<variables name="WordConverter" typeName="WORD_TO_AREBOOL_INV"></variables>
			<variables name="Tempon" typeName="ARRAY[0..15] OF BOOL"></variables>
			<variables name="Close" typeName="TOUTFERMER"></variables>
			<variables name="cpt_test" typeName="DINT"></variables>
		</privateLocalVariables>
		<program>
			<identProgram name="Init" type="section" SectionOrder="1"></identProgram>
			<STSource>(* =========================================================
   ETAT GLOBAL CONFIGURATION
   ========================================================= *)
configuree := generalites.configuree;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Matrice" type="section" SectionOrder="2"></identProgram>
			<STSource>IF armoires[0].cmd_toggle_manu THEN
	armoires[0].manu := NOT(armoires[0].manu);
END_IF;
IF armoires[0].entrees.Auto_manu THEN 
	armoires[0].manu := TRUE;
END_IF;

armoires[0].sorties.Sorties_in[0] := armoires[0].sorties.V2.F1;
armoires[0].sorties.Sorties_in[1]:= armoires[0].sorties.V3.F1;
armoires[0].sorties.Sorties_in[2]:= armoires[0].sorties.V4.F1;
armoires[0].sorties.Sorties_in[3]:= armoires[0].sorties.V5.F1;
armoires[0].sorties.Sorties_in[4]:= armoires[0].sorties.VBTE.F1;
armoires[0].sorties.Sorties_in[5]:= armoires[0].sorties.V6.F1;
armoires[0].sorties.Sorties_in[6]:= armoires[0].sorties.V16.F1;
armoires[0].sorties.Sorties_in[7]:= armoires[0].sorties.V7.F1;
armoires[0].sorties.Sorties_in[8]:= armoires[0].sorties.VS.F1;
armoires[0].sorties.Sorties_in[9]:= armoires[0].sorties.V9.F1;
armoires[0].sorties.Sorties_in[10] := armoires[0].sorties.PPE.F1;
armoires[0].sorties.Sorties_in[11] := armoires[0].sorties.VHE.F1;
armoires[0].sorties.Sorties_in[12] := FALSE;
armoires[0].sorties.Sorties_in[13] := FALSE;
armoires[0].sorties.Sorties_in[14] := FALSE;
armoires[0].sorties.Sorties_in[15] := FALSE;

(* AFFECTATION DE LA MATRICE *)
WordConverter (In := 2#1011111110001111, Out =&gt; armoires[0].sorties.V2.Mat);
WordConverter (In := 2#0111111110011111, Out =&gt; armoires[0].sorties.V3.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.V4.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.V5.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.VBTE.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.V6.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.V16.Mat);
WordConverter (In := 2#1111111110011111, Out =&gt; armoires[0].sorties.V7.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[0].sorties.VS.Mat);
WordConverter (In := 2#0011111011101111, Out =&gt; armoires[0].sorties.V9.Mat);
WordConverter (In := 2#0011111011101111, Out =&gt; armoires[0].sorties.PPE.Mat);
WordConverter (In := 2#0111111110011111, Out =&gt; armoires[0].sorties.VHE.Mat);

armoires[0].sorties.Sorties_out := armoires[0].sorties.Sorties_in;

if (armoires[0].manu) then
	FOR i := 0 TO 15 DO
	
		Autorise := TRUE;
		CASE i OF
			0: Tempon := armoires[0].sorties.V2.Mat;
			1: Tempon := armoires[0].sorties.V3.Mat;
			2: Tempon := armoires[0].sorties.V4.Mat;
			3: Tempon := armoires[0].sorties.V5.Mat;
			4: Tempon := armoires[0].sorties.VBTE.Mat;
			5: Tempon := armoires[0].sorties.V6.Mat;
			6: Tempon := armoires[0].sorties.V16.Mat;
			7: Tempon := armoires[0].sorties.V7.Mat;
			8: Tempon := armoires[0].sorties.VS.Mat;
			9: Tempon := armoires[0].sorties.V9.Mat;
			10: Tempon := armoires[0].sorties.PPE.Mat;
			11: Tempon := armoires[0].sorties.VHE.Mat;
			ELSE WordConverter (In := 16#FFFF, Out =&gt; Tempon);
		END_CASE;
		
		FOR j := 0 TO 15 DO
			IF NOT(Tempon[j]) THEN
	        		(* bit 0_i = 0 *)
				(* bloquant *)
				IF armoires[0].sorties.Sorties_in[j] THEN
					(* bit 0_i = 1 *)
					(* vanne deja ouverte *)
					Autorise := FALSE;
				END_IF;
	    		END_IF;
		END_FOR;

		CASE i OF
			0: armoires[0].sorties.V2.Autorisee := Autorise;
			1: armoires[0].sorties.V3.Autorisee := Autorise;
			2: armoires[0].sorties.V4.Autorisee := Autorise;
			3: armoires[0].sorties.V5.Autorisee := Autorise;
			4: armoires[0].sorties.VBTE.Autorisee := Autorise;
			5: armoires[0].sorties.V6.Autorisee := Autorise;
			6: armoires[0].sorties.V16.Autorisee := Autorise;
			7: armoires[0].sorties.V7.Autorisee := Autorise;
			8: armoires[0].sorties.VS.Autorisee := Autorise;
			9: armoires[0].sorties.V9.Autorisee := Autorise;
			10: armoires[0].sorties.PPE.Autorisee := Autorise;
			11: armoires[0].sorties.VHE.Autorisee := Autorise;
		END_CASE;

	END_FOR;
end_if;

</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ManuA" type="section" SectionOrder="3"></identProgram>
			<STSource>Gc_ManuA.Runtime.GC_MAX_STEPS := 28;
Gc_ManuA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_ManuA.Runtime.GC_MAX_ACTIONS := 28;
Gc_ManuA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_ManuA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_ManuA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_ManuA[0]);
Builder(T:=1,Text:='id=1|n=X1', (* mode auto *)				_Step:=Steps_ManuA[1]); 
Builder(T:=1,Text:='id=2|n=X2', (* mode manu *)				_Step:=Steps_ManuA[2]);  

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=AUTO', 					_Trans:=Trans_ManuA[0]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuA[0]); 
Builder(T:=2,Text:='id=1|s=1|d=2|c=MANU', 					_Trans:=Trans_ManuA[1]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuA[1]); 
Builder(T:=2,Text:='id=2|s=2|d=0|c=AUTO', 					_Trans:=Trans_ManuA[2]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuA[2]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FEAUTO|k=5|s=1', 				_Act:=Acts_ManuA[0]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuA[0]);
Builder(T:=3,Text:='id=1|n=FEMANU|k=5|s=2', 				_Act:=Acts_ManuA[1]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuA[1]);
Builder(T:=3,Text:='id=2|n=ENMANU|k=0|s=2', 				_Act:=Acts_ManuA[2]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuA[2]);


Ctrl_ManuA.Cmd.ForceStepFromId := -1;
Ctrl_ManuA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_ManuA[0].EnableCond := TRUE;
Acts_ManuA[1].EnableCond := TRUE;
Acts_ManuA[2].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_ManuA[0].Condition  := not(armoires[0].manu);
Trans_ManuA[1].Condition  := armoires[0].manu;
Trans_ManuA[2].Condition  := not(armoires[0].manu);

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_ManuA.Cmd.Enable := configuree and not(modification_majeure);
Ctrl_ManuA.Cmd.ModeReq := 1;

Gc_ManuA(
    Enable := Ctrl_ManuA.Cmd.Enable,
    ModeReq := Ctrl_ManuA.Cmd.ModeReq,
    FreezeReq := Ctrl_ManuA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_ManuA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_ManuA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_ManuA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_ManuA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_ManuA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_ManuA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_ManuA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_ManuA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_ManuA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_ManuA,
    Transitions := Trans_ManuA,
    Actions := Acts_ManuA
);

(* Retour statut *)
Ctrl_ManuA.Stat.Cycle := Gc_ManuA.Runtime.Cycle;
Ctrl_ManuA.Stat.Phase := Gc_ManuA.Runtime.Phase;
Ctrl_ManuA.Stat.Mode := Gc_ManuA.Runtime.Mode;
Ctrl_ManuA.Stat.ActiveStepCount := Gc_ManuA.Debug.ActiveStepCount;
Ctrl_ManuA.Stat.LastTransitionFiredId := Gc_ManuA.Debug.LastTransitionFiredId;
Ctrl_ManuA.Stat.ConfigFault := Gc_ManuA.Debug.ConfigFault;
Ctrl_ManuA.Stat.WatchdogDetected := Gc_ManuA.Debug.WatchdogDetected;
Ctrl_ManuA.Stat.NoActiveStepFault := Gc_ManuA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_ManuA.Cmd.StepReq := FALSE;
Ctrl_ManuA.Cmd.InitReq := FALSE;
Ctrl_ManuA.Cmd.ResetInitialReq := FALSE;
Ctrl_ManuA.Cmd.ResetAllReq := FALSE;
Ctrl_ManuA.Cmd.ForceBackReq := FALSE;
Ctrl_ManuA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ManuA_Actions" type="section" SectionOrder="4"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* MANUA_X0 *)


(* ____________________________________________________________________ *)
(* MANUA_X1 *)
IF Acts_ManuA[0].Out THEN
	if (armoires[0].en_cours_de_chgt) then
		armoires[0].en_cours_de_chgt := false;
		armoires[0].en_cours_de_chgt_avant := false;
		armoires[0].en_cours_de_chgt_apres := false;
		armoires[0].retour_sur_chgt := true;
	end_if;
	if (armoires[1].prete and not(armoires[1].manu)) then
		armoires[0].demande_basculement := TRUE;
	end_if;
	Close(arm:=armoires[0]);
END_IF;

(* ____________________________________________________________________ *)
(* MANUA_X2 *)

IF Acts_ManuA[1].Out THEN
	if (armoires[0].retour_sur_chgt) then
		armoires[0].init_chgt := true;
	end_if;
END_IF;

IF Acts_ManuA[2].Out THEN
	if (manu_armoire_choisie) then
		if (manu_vanne_choisie = 10 and armoires[0].sorties.V2.Autorisee) then
			if (manu_ouv) then
				armoires[0].sorties.V2.F0 := FALSE;
				armoires[0].sorties.V2.F1 := TRUE;
				%M1002 := FALSE;
				%MW3010 := 0;
