			<variables name="Ctrl_HeliumAPB" typeName="ST_GC_CTRL"></variables>
			<variables name="Steps_HeliumAPB" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Trans_HeliumAPB" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_HeliumAPB" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="InitDone_HeliumAPB" typeName="EBOOL"></variables>
			<variables name="Gc_ManuB" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="Steps_ManuB" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Trans_ManuB" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_ManuB" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="Ctrl_ManuB" typeName="ST_GC_CTRL"></variables>
			<variables name="InitDone_ManuB" typeName="EBOOL"></variables>
			<variables name="Autorise" typeName="BOOL"></variables>
			<variables name="i" typeName="DINT"></variables>
			<variables name="j" typeName="DINT"></variables>
			<variables name="WordConverter" typeName="WORD_TO_AREBOOL_INV"></variables>
			<variables name="Tempon" typeName="ARRAY[0..15] OF BOOL"></variables>
			<variables name="Close" typeName="TOUTFERMER"></variables>
		</privateLocalVariables>
		<program>
			<identProgram name="Init" type="section" SectionOrder="1"></identProgram>
			<STSource>(* =========================================================
   ETAT GLOBAL CONFIGURATION
   ========================================================= *)
configuree := generalites.configuree;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="Matrice" type="section" SectionOrder="2"></identProgram>
			<STSource>IF armoires[1].cmd_toggle_manu THEN
	armoires[1].manu := NOT(armoires[1].manu);
END_IF;
IF armoires[1].entrees.Auto_manu THEN 
	armoires[1].manu := TRUE;
END_IF;

armoires[1].sorties.Sorties_in[0] := armoires[1].sorties.V2.F1;
armoires[1].sorties.Sorties_in[1]:= armoires[1].sorties.V3.F1;
armoires[1].sorties.Sorties_in[2]:= armoires[1].sorties.V4.F1;
armoires[1].sorties.Sorties_in[3]:= armoires[1].sorties.V5.F1;
armoires[1].sorties.Sorties_in[4]:= armoires[1].sorties.VBTE.F1;
armoires[1].sorties.Sorties_in[5]:= armoires[1].sorties.V6.F1;
armoires[1].sorties.Sorties_in[6]:= armoires[1].sorties.V16.F1;
armoires[1].sorties.Sorties_in[7]:= armoires[1].sorties.V7.F1;
armoires[1].sorties.Sorties_in[8]:= armoires[1].sorties.VS.F1;
armoires[1].sorties.Sorties_in[9]:= armoires[1].sorties.V9.F1;
armoires[1].sorties.Sorties_in[10] := armoires[1].sorties.PPE.F1;
armoires[1].sorties.Sorties_in[11] := armoires[1].sorties.VHE.F1;
armoires[1].sorties.Sorties_in[12] := FALSE;
armoires[1].sorties.Sorties_in[13] := FALSE;
armoires[1].sorties.Sorties_in[14] := FALSE;
armoires[1].sorties.Sorties_in[15] := FALSE;

(* AFFECTATION DE LA MATRICE *)
WordConverter (In := 2#1011111110001111, Out =&gt; armoires[1].sorties.V2.Mat);
WordConverter (In := 2#0111111110011111, Out =&gt; armoires[1].sorties.V3.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.V4.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.V5.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.VBTE.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.V6.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.V16.Mat);
WordConverter (In := 2#1111111110011111, Out =&gt; armoires[1].sorties.V7.Mat);
WordConverter (In := 2#1111111111111111, Out =&gt; armoires[1].sorties.VS.Mat);
WordConverter (In := 2#0011111011101111, Out =&gt; armoires[1].sorties.V9.Mat);
WordConverter (In := 2#0011111011101111, Out =&gt; armoires[1].sorties.PPE.Mat);
WordConverter (In := 2#0111111110011111, Out =&gt; armoires[1].sorties.VHE.Mat);

armoires[1].sorties.Sorties_out := armoires[1].sorties.Sorties_in;

if (armoires[1].manu) then
	FOR i := 0 TO 15 DO
	
		Autorise := TRUE;
		CASE i OF
			0: Tempon := armoires[1].sorties.V2.Mat;
			1: Tempon := armoires[1].sorties.V3.Mat;
			2: Tempon := armoires[1].sorties.V4.Mat;
			3: Tempon := armoires[1].sorties.V5.Mat;
			4: Tempon := armoires[1].sorties.VBTE.Mat;
			5: Tempon := armoires[1].sorties.V6.Mat;
			6: Tempon := armoires[1].sorties.V16.Mat;
			7: Tempon := armoires[1].sorties.V7.Mat;
			8: Tempon := armoires[1].sorties.VS.Mat;
			9: Tempon := armoires[1].sorties.V9.Mat;
			10: Tempon := armoires[1].sorties.PPE.Mat;
			11: Tempon := armoires[1].sorties.VHE.Mat;
			ELSE WordConverter (In := 16#FFFF, Out =&gt; Tempon);
		END_CASE;
		
		FOR j := 0 TO 15 DO
			IF NOT(Tempon[j]) THEN
	        		(* bit 0_i = 0 *)
				(* bloquant *)
				IF armoires[1].sorties.Sorties_in[j] THEN
					(* bit 0_i = 1 *)
					(* vanne deja ouverte *)
					Autorise := FALSE;
				END_IF;
	    		END_IF;
		END_FOR;

		CASE i OF
			0: armoires[1].sorties.V2.Autorisee := Autorise;
			1: armoires[1].sorties.V3.Autorisee := Autorise;
			2: armoires[1].sorties.V4.Autorisee := Autorise;
			3: armoires[1].sorties.V5.Autorisee := Autorise;
			4: armoires[1].sorties.VBTE.Autorisee := Autorise;
			5: armoires[1].sorties.V6.Autorisee := Autorise;
			6: armoires[1].sorties.V16.Autorisee := Autorise;
			7: armoires[1].sorties.V7.Autorisee := Autorise;
			8: armoires[1].sorties.VS.Autorisee := Autorise;
			9: armoires[1].sorties.V9.Autorisee := Autorise;
			10: armoires[1].sorties.PPE.Autorisee := Autorise;
			11: armoires[1].sorties.VHE.Autorisee := Autorise;
		END_CASE;

	END_FOR;
end_if;

</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ManuB" type="section" SectionOrder="3"></identProgram>
			<STSource>Gc_ManuB.Runtime.GC_MAX_STEPS := 28;
Gc_ManuB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_ManuB.Runtime.GC_MAX_ACTIONS := 28;
Gc_ManuB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_ManuB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_ManuB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_ManuB[0]);
Builder(T:=1,Text:='id=1|n=X1', (* mode auto *)				_Step:=Steps_ManuB[1]); 
Builder(T:=1,Text:='id=2|n=X2', (* mode manu *)				_Step:=Steps_ManuB[2]);  

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=AUTO', 					_Trans:=Trans_ManuB[0]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuB[0]); 
Builder(T:=2,Text:='id=1|s=1|d=2|c=MANU', 					_Trans:=Trans_ManuB[1]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuB[1]); 
Builder(T:=2,Text:='id=2|s=2|d=0|c=AUTO', 					_Trans:=Trans_ManuB[2]);
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ManuB[2]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FEAUTO|k=5|s=1', 				_Act:=Acts_ManuB[0]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuB[0]);
Builder(T:=3,Text:='id=1|n=FEMANU|k=5|s=2', 				_Act:=Acts_ManuB[1]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuB[1]);
Builder(T:=3,Text:='id=2|n=ENMANU|k=0|s=2', 				_Act:=Acts_ManuB[2]);
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ManuB[2]);


Ctrl_ManuB.Cmd.ForceStepFromId := -1;
Ctrl_ManuB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_ManuB[0].EnableCond := TRUE;
Acts_ManuB[1].EnableCond := TRUE;
Acts_ManuB[2].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_ManuB[0].Condition  := not(armoires[1].manu);
Trans_ManuB[1].Condition  := armoires[1].manu;
Trans_ManuB[2].Condition  := not(armoires[1].manu);

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_ManuB.Cmd.Enable := configuree;
Ctrl_ManuB.Cmd.ModeReq := 1;

Gc_ManuB(
    Enable := Ctrl_ManuB.Cmd.Enable,
    ModeReq := Ctrl_ManuB.Cmd.ModeReq,
    FreezeReq := Ctrl_ManuB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_ManuB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_ManuB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_ManuB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_ManuB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_ManuB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_ManuB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_ManuB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_ManuB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_ManuB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_ManuB,
    Transitions := Trans_ManuB,
    Actions := Acts_ManuB
);

(* Retour statut *)
Ctrl_ManuB.Stat.Cycle := Gc_ManuB.Runtime.Cycle;
Ctrl_ManuB.Stat.Phase := Gc_ManuB.Runtime.Phase;
Ctrl_ManuB.Stat.Mode := Gc_ManuB.Runtime.Mode;
Ctrl_ManuB.Stat.ActiveStepCount := Gc_ManuB.Debug.ActiveStepCount;
Ctrl_ManuB.Stat.LastTransitionFiredId := Gc_ManuB.Debug.LastTransitionFiredId;
Ctrl_ManuB.Stat.ConfigFault := Gc_ManuB.Debug.ConfigFault;
Ctrl_ManuB.Stat.WatchdogDetected := Gc_ManuB.Debug.WatchdogDetected;
Ctrl_ManuB.Stat.NoActiveStepFault := Gc_ManuB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_ManuB.Cmd.StepReq := FALSE;
Ctrl_ManuB.Cmd.InitReq := FALSE;
Ctrl_ManuB.Cmd.ResetInitialReq := FALSE;
Ctrl_ManuB.Cmd.ResetAllReq := FALSE;
Ctrl_ManuB.Cmd.ForceBackReq := FALSE;
Ctrl_ManuB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ManuB_Actions" type="section" SectionOrder="4"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* MANUB_X0 *)


(* ____________________________________________________________________ *)
(* MANUB_X1 *)
IF Acts_ManuB[0].Out THEN
	if (armoires[1].en_cours_de_chgt) then
		armoires[1].en_cours_de_chgt := false;
		armoires[1].en_cours_de_chgt_avant := false;
		armoires[1].en_cours_de_chgt_apres := false;
		armoires[1].retour_sur_chgt := true;
	end_if;
	if (armoires[0].prete and not(armoires[0].manu)) then
		armoires[1].demande_basculement := TRUE;
	end_if;
	Close(arm:=armoires[1]);
END_IF;
(* ____________________________________________________________________ *)
(* MANUB_X2 *)

IF Acts_ManuB[1].Out THEN
	if (armoires[1].retour_sur_chgt) then
		armoires[1].init_chgt := true;
	end_if;
END_IF;

IF Acts_ManuB[2].Out THEN
	if (manu_armoire_choisie) then
		if (manu_vanne_choisie = 10 and armoires[1].sorties.V2.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V2.F0 := FALSE;
				armoires[1].sorties.V2.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V2.F1 := FALSE;
				armoires[1].sorties.V2.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 11 and armoires[1].sorties.V3.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V3.F0 := FALSE;
				armoires[1].sorties.V3.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V3.F1 := FALSE;
				armoires[1].sorties.V3.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 12 and armoires[1].sorties.V4.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V4.F0 := FALSE;
				armoires[1].sorties.V4.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V4.F1 := FALSE;
				armoires[1].sorties.V4.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 13 and armoires[1].sorties.V5.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V5.F0 := FALSE;
				armoires[1].sorties.V5.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V5.F1 := FALSE;
				armoires[1].sorties.V5.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 14 and armoires[1].sorties.VBTE.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.VBTE.F0 := FALSE;
				armoires[1].sorties.VBTE.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.VBTE.F1 := FALSE;
				armoires[1].sorties.VBTE.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 15 and armoires[1].sorties.V6.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V6.F0 := FALSE;
				armoires[1].sorties.V6.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V6.F1 := FALSE;
				armoires[1].sorties.V6.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 16 and armoires[1].sorties.V16.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V16.F0 := FALSE;
				armoires[1].sorties.V16.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V16.F1 := FALSE;
				armoires[1].sorties.V16.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 17 and armoires[1].sorties.V7.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V7.F0 := FALSE;
				armoires[1].sorties.V7.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V7.F1 := FALSE;
				armoires[1].sorties.V7.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 18 and armoires[1].sorties.VS.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.VS.F0 := FALSE;
				armoires[1].sorties.VS.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.VS.F1 := FALSE;
				armoires[1].sorties.VS.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 19 and armoires[1].sorties.V9.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.V9.F0 := FALSE;
				armoires[1].sorties.V9.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.V9.F1 := FALSE;
				armoires[1].sorties.V9.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 20 and armoires[1].sorties.PPE.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.PPE.F0 := FALSE;
				armoires[1].sorties.PPE.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.PPE.F1 := FALSE;
				armoires[1].sorties.PPE.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		elsif (manu_vanne_choisie = 21 and armoires[1].sorties.VHE.Autorisee) then
			if (manu_ouv) then
				armoires[1].sorties.VHE.F0 := FALSE;
				armoires[1].sorties.VHE.F1 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			elsif (manu_ferm) then
				armoires[1].sorties.VHE.F1 := FALSE;
				armoires[1].sorties.VHE.F0 := TRUE;
				%M1003 := FALSE;
				%MW3010 := 0;
			end_if;
		end_if;
	end_if;	
end_if;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ChangementB" type="section" SectionOrder="5"></identProgram>
			<STSource>Gc_ChangementB.Runtime.GC_MAX_STEPS := 28;
Gc_ChangementB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_ChangementB.Runtime.GC_MAX_ACTIONS := 28;
Gc_ChangementB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_ChangementB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_ChangementB.Runtime.GC_MAX_HIST := 8;

if (armoires[1].init_chgt) then
	armoires[1].init_chgt := false;
	armoires[1].en_cours_de_chgt := true;
	armoires[1].en_cours_de_chgt_avant := true;
	Ctrl_ChangementB.Cmd.ModeReq := 0;
	Ctrl_ChangementB.Cmd.InitReq := TRUE;
end_if;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_ChangementB[0]);
Builder(T:=1,Text:='id=1|n=X1', (* fermer toutes les vannes + valider *)	_Step:=Steps_ChangementB[1]); 
Builder(T:=1,Text:='id=2|n=X2', (* fin detoxal *)				_Step:=Steps_ChangementB[2]); 
Builder(T:=1,Text:='id=3|n=X3', (* fin purge *)				_Step:=Steps_ChangementB[3]); 
Builder(T:=1,Text:='id=4|n=X4', (* fin pompage *)				_Step:=Steps_ChangementB[4]); 
Builder(T:=1,Text:='id=5|n=X5', (* fin test helium *)			_Step:=Steps_ChangementB[5]); 
Builder(T:=1,Text:='id=6|n=X6', (* ouvrir V2 V4 + valider *)		_Step:=Steps_ChangementB[6]); 
Builder(T:=1,Text:='id=7|n=X7', (* fermer V2 V4 + valider *)		_Step:=Steps_ChangementB[7]); 
Builder(T:=1,Text:='id=8|n=X8', (* fin detoxal *)				_Step:=Steps_ChangementB[8]); 
Builder(T:=1,Text:='id=9|n=X9', (* fin purge *)				_Step:=Steps_ChangementB[9]); 
Builder(T:=1,Text:='id=10|n=X10', (* fin pompage *)				_Step:=Steps_ChangementB[10]); 
Builder(T:=1,Text:='id=11|n=X11', (* fin test helium *)			_Step:=Steps_ChangementB[11]); 
Builder(T:=1,Text:='id=12|n=X12', (* pression correcte + valider *)		_Step:=Steps_ChangementB[12]); 
Builder(T:=1,Text:='id=13|n=X13', (* pression incorrecte + valider *)	_Step:=Steps_ChangementB[13]); 

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=IHM', 					_Trans:=Trans_ChangementB[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=IHM', 					_Trans:=Trans_ChangementB[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[1]); 
Builder(T:=2,Text:='id=2|s=2|d=3|c=FDETOX', 				_Trans:=Trans_ChangementB[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=FPURGE', 				_Trans:=Trans_ChangementB[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[3]);
Builder(T:=2,Text:='id=4|s=4|d=5|c=FPOMPAGE', 				_Trans:=Trans_ChangementB[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[4]);
Builder(T:=2,Text:='id=5|s=5|d=6|c=FHELIUM', 				_Trans:=Trans_ChangementB[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[5]);
Builder(T:=2,Text:='id=6|s=6|d=7|c=IHM', 					_Trans:=Trans_ChangementB[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[6]);
Builder(T:=2,Text:='id=7|s=7|d=8|c=IHM', 					_Trans:=Trans_ChangementB[7]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[7]);
Builder(T:=2,Text:='id=8|s=8|d=9|c=FDETOX', 				_Trans:=Trans_ChangementB[8]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[8]);
Builder(T:=2,Text:='id=9|s=9|d=10|c=FPURGE', 				_Trans:=Trans_ChangementB[9]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[9]);
Builder(T:=2,Text:='id=10|s=10|d=11|c=FPOMPAGE', 				_Trans:=Trans_ChangementB[10]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[10]);
Builder(T:=2,Text:='id=11|s=11|d=12|c=PT1&lt;=SPV', 				_Trans:=Trans_ChangementB[11]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[11]);
Builder(T:=2,Text:='id=12|s=11|d=13|c=PT1&gt;SPV', 				_Trans:=Trans_ChangementB[12]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[12]);
Builder(T:=2,Text:='id=13|s=12|d=0|c=IHM', 					_Trans:=Trans_ChangementB[13]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[13]);
Builder(T:=2,Text:='id=14|s=13|d=7|c=IHM', 					_Trans:=Trans_ChangementB[14]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_ChangementB[14]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=RAZ|k=1|s=0', 					_Act:=Acts_ChangementB[0]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[0]);
Builder(T:=3,Text:='id=1|n=FTT|k=1|s=1', 					_Act:=Acts_ChangementB[1]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[1]);
Builder(T:=3,Text:='id=2|n=IDETOX|k=1|s=2', 				_Act:=Acts_ChangementB[2]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[2]);
Builder(T:=3,Text:='id=3|n=IPURGE|k=1|s=3', 				_Act:=Acts_ChangementB[3]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[3]);
Builder(T:=3,Text:='id=4|n=IPOMPAGE|k=1|s=4', 				_Act:=Acts_ChangementB[4]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[4]);
Builder(T:=3,Text:='id=5|n=IHELIUM|k=1|s=5', 				_Act:=Acts_ChangementB[5]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[5]);
Builder(T:=3,Text:='id=6|n=OV2V4|k=1|s=6', 					_Act:=Acts_ChangementB[6]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[6]);
Builder(T:=3,Text:='id=7|n=FV2V4|k=1|s=7', 					_Act:=Acts_ChangementB[7]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[7]);
Builder(T:=3,Text:='id=8|n=SEUILS|k=5|s=7', 				_Act:=Acts_ChangementB[8]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[8]);
Builder(T:=3,Text:='id=9|n=IDETOX|k=1|s=8', 				_Act:=Acts_ChangementB[9]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[9]);
Builder(T:=3,Text:='id=10|n=IPURGE|k=1|s=9', 				_Act:=Acts_ChangementB[10]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[10]);
Builder(T:=3,Text:='id=11|n=IPOMPAGE|k=1|s=10', 				_Act:=Acts_ChangementB[11]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[11]);
Builder(T:=3,Text:='id=12|n=IHELIUM|k=1|s=11', 				_Act:=Acts_ChangementB[12]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[12]);
Builder(T:=3,Text:='id=13|n=X12|k=0|s=12', 					_Act:=Acts_ChangementB[13]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[13]);
Builder(T:=3,Text:='id=14|n=X13|k=0|s=13', 					_Act:=Acts_ChangementB[14]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[14]);
Builder(T:=3,Text:='id=15|n=RDETOX|k=5|s=2', 				_Act:=Acts_ChangementB[15]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[15]);
Builder(T:=3,Text:='id=16|n=RPURGE|k=5|s=3', 				_Act:=Acts_ChangementB[16]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[16]);
Builder(T:=3,Text:='id=17|n=RPOMPAGE|k=5|s=4', 				_Act:=Acts_ChangementB[17]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[17]);
Builder(T:=3,Text:='id=18|n=RHELIUM|k=5|s=5', 				_Act:=Acts_ChangementB[18]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[18]);
Builder(T:=3,Text:='id=19|n=RDETOX|k=5|s=8', 				_Act:=Acts_ChangementB[19]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[19]);
Builder(T:=3,Text:='id=20|n=RPURGE|k=5|s=9', 				_Act:=Acts_ChangementB[20]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[20]);
Builder(T:=3,Text:='id=21|n=RPOMPAGE|k=5|s=10', 				_Act:=Acts_ChangementB[21]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[21]);
Builder(T:=3,Text:='id=22|n=RHELIUM|k=5|s=11', 				_Act:=Acts_ChangementB[22]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementB[22]);


Ctrl_ChangementB.Cmd.ForceStepFromId := -1;
Ctrl_ChangementB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_ChangementB[0].EnableCond := TRUE;
Acts_ChangementB[1].EnableCond := TRUE;
Acts_ChangementB[2].EnableCond := TRUE;
Acts_ChangementB[3].EnableCond := TRUE;
Acts_ChangementB[4].EnableCond := TRUE;
Acts_ChangementB[5].EnableCond := TRUE;
Acts_ChangementB[6].EnableCond := TRUE;
Acts_ChangementB[7].EnableCond := TRUE;
Acts_ChangementB[8].EnableCond := TRUE;
Acts_ChangementB[9].EnableCond := TRUE;
Acts_ChangementB[10].EnableCond := TRUE;
Acts_ChangementB[11].EnableCond := TRUE;
Acts_ChangementB[12].EnableCond := TRUE;
Acts_ChangementB[13].EnableCond := TRUE;
Acts_ChangementB[14].EnableCond := TRUE;
Acts_ChangementB[15].EnableCond := TRUE;
Acts_ChangementB[16].EnableCond := TRUE;
Acts_ChangementB[17].EnableCond := TRUE;
Acts_ChangementB[18].EnableCond := TRUE;
Acts_ChangementB[19].EnableCond := TRUE;
Acts_ChangementB[20].EnableCond := TRUE;
Acts_ChangementB[21].EnableCond := TRUE;
Acts_ChangementB[22].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_ChangementB[0].Condition  := armoires[1].en_cours_de_chgt AND armoires[1].en_cours_de_chgt_avant;
Trans_ChangementB[1].Condition  := chgt_valider[0] and not(armoires[1].retour_sur_chgt) and not(armoires[1].retour_sur_chgt_ap_decl);
Trans_ChangementB[2].Condition  := Steps_ChangementB[2].ActiveTime &gt;= t#1s AND Gc_DetoxalB.Finished OR NOT(generalites.pres_detoxal);
Trans_ChangementB[3].Condition  := Steps_ChangementB[3].ActiveTime &gt;= t#1s AND Gc_PurgeB.Finished;
Trans_ChangementB[4].Condition  := Steps_ChangementB[4].ActiveTime &gt;= t#1s AND Gc_PompageB.Finished;
Trans_ChangementB[5].Condition  := Steps_ChangementB[5].ActiveTime &gt;= t#1s AND Gc_HeliumAVB.Finished OR NOT(generalites.pres_robinets);
Trans_ChangementB[6].Condition  := chgt_valider[0];
Trans_ChangementB[7].Condition  := chgt_valider[0] OR NOT(generalites.conf_poids);
Trans_ChangementB[8].Condition  := Steps_ChangementB[8].ActiveTime &gt;= t#1s AND Gc_DetoxalB.Finished OR NOT(generalites.pres_detoxal);
Trans_ChangementB[9].Condition  := Steps_ChangementB[9].ActiveTime &gt;= t#1s AND Gc_PurgeB.Finished;
Trans_ChangementB[10].Condition  := Steps_ChangementB[10].ActiveTime &gt;= t#1s AND Gc_PompageB.Finished;
Trans_ChangementB[11].Condition  := (Steps_ChangementB[11].ActiveTime &gt;= t#1s AND Gc_HeliumAPB.Finished OR NOT(generalites.pres_robinets)) AND armoires[1].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.chgt.SPV);
Trans_ChangementB[12].Condition  := (Steps_ChangementB[11].ActiveTime &gt;= t#1s AND Gc_HeliumAPB.Finished OR NOT(generalites.pres_robinets)) AND armoires[1].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.chgt.SPV);
Trans_ChangementB[13].Condition  := chgt_valider[0] AND NOT(armoires[1].Entrees.Extraction);
Trans_ChangementB[14].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_ChangementB.Cmd.Enable := configuree and not(armoires[1].manu);
Ctrl_ChangementB.Cmd.ModeReq := 1;

Gc_ChangementB(
    Enable := Ctrl_ChangementB.Cmd.Enable,
    ModeReq := Ctrl_ChangementB.Cmd.ModeReq,
    FreezeReq := Ctrl_ChangementB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_ChangementB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_ChangementB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_ChangementB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_ChangementB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_ChangementB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_ChangementB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_ChangementB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_ChangementB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_ChangementB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_ChangementB,
    Transitions := Trans_ChangementB,
    Actions := Acts_ChangementB
);

(* Retour statut *)
Ctrl_ChangementB.Stat.Cycle := Gc_ChangementB.Runtime.Cycle;
Ctrl_ChangementB.Stat.Phase := Gc_ChangementB.Runtime.Phase;
Ctrl_ChangementB.Stat.Mode := Gc_ChangementB.Runtime.Mode;
Ctrl_ChangementB.Stat.ActiveStepCount := Gc_ChangementB.Debug.ActiveStepCount;
Ctrl_ChangementB.Stat.LastTransitionFiredId := Gc_ChangementB.Debug.LastTransitionFiredId;
Ctrl_ChangementB.Stat.ConfigFault := Gc_ChangementB.Debug.ConfigFault;
Ctrl_ChangementB.Stat.WatchdogDetected := Gc_ChangementB.Debug.WatchdogDetected;
Ctrl_ChangementB.Stat.NoActiveStepFault := Gc_ChangementB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_ChangementB.Cmd.StepReq := FALSE;
Ctrl_ChangementB.Cmd.InitReq := FALSE;
Ctrl_ChangementB.Cmd.ResetInitialReq := FALSE;
Ctrl_ChangementB.Cmd.ResetAllReq := FALSE;
Ctrl_ChangementB.Cmd.ForceBackReq := FALSE;
Ctrl_ChangementB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_DetoxalB" type="section" SectionOrder="6"></identProgram>
			<STSource>Gc_DetoxalB.Runtime.GC_MAX_STEPS := 28;
Gc_DetoxalB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_DetoxalB.Runtime.GC_MAX_ACTIONS := 28;
Gc_DetoxalB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_DetoxalB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_DetoxalB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_DetoxalB[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_DetoxalB[1]); 
Builder(T:=1,Text:='id=2|n=X2|f=1', 					_Step:=Steps_DetoxalB[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_DetoxalB[3]);

(* =========================
TRANSITIONS DETOX
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=DEBIT', 					_Trans:=Trans_DetoxalB[0]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[0]); 
Builder(T:=2,Text:='id=1|s=0|d=3|c=!DEBIT', 				_Trans:=Trans_DetoxalB[1]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[1]);
Builder(T:=2,Text:='id=2|s=1|d=2|c=PT1&lt;=SP', 				_Trans:=Trans_DetoxalB[2]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[2]);
Builder(T:=2,Text:='id=3|s=1|d=3|c=PT1&gt;SP', 				_Trans:=Trans_DetoxalB[3]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[3]);
Builder(T:=2,Text:='id=4|s=2|d=0|c=TRUE', 					_Trans:=Trans_DetoxalB[4]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[4]);
Builder(T:=2,Text:='id=5|s=3|d=0|c=IHM', 					_Trans:=Trans_DetoxalB[5]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalB[5]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=OV3V4|k=4|s=1', 							_Act:=Acts_DetoxalB[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.detoxal.DLDETOX)*1000.0), 		_Act:=Acts_DetoxalB[0]);
Builder(T:=3,Text:='id=1|n=FV3|k=1|s=2', 							_Act:=Acts_DetoxalB[1]);
Builder(T:=3,d:=t#0s,								 	_Act:=Acts_DetoxalB[1]);
Builder(T:=3,Text:='id=2|n=FV3V4|k=1|s=3', 							_Act:=Acts_DetoxalB[2]);
Builder(T:=3,d:=t#0s,								 	_Act:=Acts_DetoxalB[2]);  
	
Ctrl_DetoxalB.Cmd.ForceStepFromId := -1;
Ctrl_DetoxalB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_DetoxalB[0].EnableCond := TRUE;
Acts_DetoxalB[1].EnableCond := TRUE;
Acts_DetoxalB[2].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_DetoxalB[0].Condition := armoires[1].entrees.detoxal;
Trans_DetoxalB[1].Condition := NOT(armoires[1].entrees.detoxal);     				
Trans_DetoxalB[2].Condition := Steps_DetoxalB[1].ActiveTime &gt;= t#1s AND Acts_DetoxalB[0].Started AND Acts_DetoxalB[0].Finished AND armoires[1].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.detoxal.SPDETOX);
Trans_DetoxalB[3].Condition := Steps_DetoxalB[1].ActiveTime &gt;= t#1s AND Acts_DetoxalB[0].Started AND Acts_DetoxalB[0].Finished AND armoires[1].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.detoxal.SPDETOX);
Trans_DetoxalB[4].Condition := TRUE;
Trans_DetoxalB[5].Condition := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_DetoxalB.Cmd.ModeReq = 0 THEN Ctrl_DetoxalB.Cmd.ModeReq := 2; END_IF;
Ctrl_DetoxalB.Cmd.Enable := generalites.pres_detoxal and not(armoires[1].manu);

Gc_DetoxalB(
    Enable := Ctrl_DetoxalB.Cmd.Enable,
    ModeReq := Ctrl_DetoxalB.Cmd.ModeReq,
    FreezeReq := Ctrl_DetoxalB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_DetoxalB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_DetoxalB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_DetoxalB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_DetoxalB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_DetoxalB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_DetoxalB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_DetoxalB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_DetoxalB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_DetoxalB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_DetoxalB,
    Transitions := Trans_DetoxalB,
    Actions := Acts_DetoxalB
);

(* Retour statut *)
Ctrl_DetoxalB.Stat.Cycle := Gc_DetoxalB.Runtime.Cycle;
Ctrl_DetoxalB.Stat.Phase := Gc_DetoxalB.Runtime.Phase;
Ctrl_DetoxalB.Stat.Mode := Gc_DetoxalB.Runtime.Mode;
Ctrl_DetoxalB.Stat.ActiveStepCount := Gc_DetoxalB.Debug.ActiveStepCount;
Ctrl_DetoxalB.Stat.LastTransitionFiredId := Gc_DetoxalB.Debug.LastTransitionFiredId;
Ctrl_DetoxalB.Stat.ConfigFault := Gc_DetoxalB.Debug.ConfigFault;
Ctrl_DetoxalB.Stat.WatchdogDetected := Gc_DetoxalB.Debug.WatchdogDetected;
Ctrl_DetoxalB.Stat.NoActiveStepFault := Gc_DetoxalB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_DetoxalB.Cmd.StepReq := FALSE;
Ctrl_DetoxalB.Cmd.InitReq := FALSE;
Ctrl_DetoxalB.Cmd.ResetInitialReq := FALSE;
Ctrl_DetoxalB.Cmd.ResetAllReq := FALSE;
Ctrl_DetoxalB.Cmd.ForceBackReq := FALSE;
Ctrl_DetoxalB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_PompageB" type="section" SectionOrder="7"></identProgram>
			<STSource>Gc_PompageB.Runtime.GC_MAX_STEPS := 28;
Gc_PompageB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_PompageB.Runtime.GC_MAX_ACTIONS := 28;
Gc_PompageB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_PompageB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_PompageB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 								_Step:=Steps_PompageB[0]);
Builder(T:=1,Text:='id=1|n=X1', 									_Step:=Steps_PompageB[1]); 
Builder(T:=1,Text:='id=2|n=X2', 									_Step:=Steps_PompageB[2]); 
Builder(T:=1,Text:='id=3|n=X3', 									_Step:=Steps_PompageB[3]); 
Builder(T:=1,Text:='id=4|n=X4', 									_Step:=Steps_PompageB[4]); 
Builder(T:=1,Text:='id=5|n=X5', 									_Step:=Steps_PompageB[5]); 
Builder(T:=1,Text:='id=6|n=X6', 									_Step:=Steps_PompageB[6]); 
Builder(T:=1,Text:='id=7|n=X7', 									_Step:=Steps_PompageB[7]); 
Builder(T:=1,Text:='id=8|n=X8',									_Step:=Steps_PompageB[8]); 
Builder(T:=1,Text:='id=9|n=X9|f=1', 								_Step:=Steps_PompageB[9]); 
Builder(T:=1,Text:='id=10|n=X10', 									_Step:=Steps_PompageB[10]); 
Builder(T:=1,Text:='id=11|n=X11', 									_Step:=Steps_PompageB[11]); 
Builder(T:=1,Text:='id=12|n=X12', 									_Step:=Steps_PompageB[12]); 
Builder(T:=1,Text:='id=13|n=X13', 									_Step:=Steps_PompageB[13]); 

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=TRUE', 								_Trans:=Trans_PompageB[0]); 
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=PIRANI', 							_Trans:=Trans_PompageB[1]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP2)*1000.0), 	_Trans:=Trans_PompageB[1]); 
Builder(T:=2,Text:='id=2|s=1|d=10|c=!PIRANI', 							_Trans:=Trans_PompageB[2]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[2]);
Builder(T:=2,Text:='id=3|s=2|d=3|c=PIRANI', 							_Trans:=Trans_PompageB[3]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP4)*1000.0), 	_Trans:=Trans_PompageB[3]);
Builder(T:=2,Text:='id=4|s=2|d=10|c=!PIRANI', 							_Trans:=Trans_PompageB[4]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[4]);
Builder(T:=2,Text:='id=5|s=3|d=4|c=AP', 								_Trans:=Trans_PompageB[5]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[5]);
Builder(T:=2,Text:='id=6|s=3|d=5|c=!AP', 								_Trans:=Trans_PompageB[6]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[6]);
Builder(T:=2,Text:='id=7|s=4|d=5|c=PIRANI', 							_Trans:=Trans_PompageB[7]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[7]);
Builder(T:=2,Text:='id=8|s=4|d=11|c=!PIRANI', 							_Trans:=Trans_PompageB[8]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[8]);
Builder(T:=2,Text:='id=9|s=5|d=6|c=TRUE', 								_Trans:=Trans_PompageB[9]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[9]);
Builder(T:=2,Text:='id=10|s=6|d=7|c=PT1&gt;=SPPE6', 							_Trans:=Trans_PompageB[10]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP6)*1000.0), 	_Trans:=Trans_PompageB[10]);
Builder(T:=2,Text:='id=11|s=6|d=12|c=PT1&lt;SPPE6', 							_Trans:=Trans_PompageB[11]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[11]);
Builder(T:=2,Text:='id=12|s=7|d=8|c=PT1&lt;=SPPE5', 							_Trans:=Trans_PompageB[12]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[12]);
Builder(T:=2,Text:='id=13|s=7|d=13|c=PT1&gt;SPPE5', 							_Trans:=Trans_PompageB[13]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[13]);
Builder(T:=2,Text:='id=14|s=8|d=9|c=NB==', 								_Trans:=Trans_PompageB[14]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[14]);
Builder(T:=2,Text:='id=15|s=8|d=6|c=NB!=', 								_Trans:=Trans_PompageB[15]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[15]);
Builder(T:=2,Text:='id=16|s=9|d=0|c=TRUE', 								_Trans:=Trans_PompageB[16]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[16]);
Builder(T:=2,Text:='id=17|s=10|d=0|c=IHM', 								_Trans:=Trans_PompageB[17]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[17]);
Builder(T:=2,Text:='id=18|s=11|d=0|c=IHM', 								_Trans:=Trans_PompageB[18]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[18]);
Builder(T:=2,Text:='id=19|s=12|d=5|c=IHM', 								_Trans:=Trans_PompageB[19]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[19]);
Builder(T:=2,Text:='id=20|s=13|d=0|c=IHM', 								_Trans:=Trans_PompageB[20]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageB[20]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FTTOV4|k=4|s=1', 							_Act:=Acts_PompageB[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP1)*1000.0), 	_Act:=Acts_PompageB[0]);
Builder(T:=3,Text:='id=1|n=OPPE|k=11|s=1', 								_Act:=Acts_PompageB[1]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP1)*1000.0), 	_Act:=Acts_PompageB[1]);
Builder(T:=3,Text:='id=2|n=OV9|k=4|s=2', 								_Act:=Acts_PompageB[2]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP3)*1000.0), 	_Act:=Acts_PompageB[2]);
Builder(T:=3,Text:='id=3|n=FPPE|k=0|s=3', 								_Act:=Acts_PompageB[3]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[3]);
Builder(T:=3,Text:='id=4|n=NB=0|k=1|s=5', 								_Act:=Acts_PompageB[4]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[4]);
Builder(T:=3,Text:='id=5|n=NB=FV9OV4NB++|k=1|s=6', 							_Act:=Acts_PompageB[5]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[5]);
Builder(T:=3,Text:='id=6|n=OV2|k=4|s=6', 								_Act:=Acts_PompageB[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP6)*1000.0), 	_Act:=Acts_PompageB[6]);
Builder(T:=3,Text:='id=7|n=FV2|k=4|s=7', 								_Act:=Acts_PompageB[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP8)*1000.0), 	_Act:=Acts_PompageB[7]);
Builder(T:=3,Text:='id=8|n=OV9|k=11|s=7', 								_Act:=Acts_PompageB[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP9 + config_utilisee.pompage[index_pompage_B].DLP10)*1000.0), 	_Act:=Acts_PompageB[8]);
Builder(T:=3,Text:='id=9|n=FV9|k=4|s=8', 								_Act:=Acts_PompageB[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP11)*1000.0), 	_Act:=Acts_PompageB[9]);
Builder(T:=3,Text:='id=10|n=FV2V9PPE|k=1|s=9', 							_Act:=Acts_PompageB[10]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[10]);
Builder(T:=3,Text:='id=11|n=FTT|k=1|s=10', 								_Act:=Acts_PompageB[11]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[11]);
Builder(T:=3,Text:='id=12|n=FV9|k=4|s=11', 								_Act:=Acts_PompageB[12]);
Builder(T:=3,d:=t#1s, 										_Act:=Acts_PompageB[12]);
Builder(T:=3,Text:='id=13|n=OV2|k=0|s=11', 								_Act:=Acts_PompageB[13]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[13]);
Builder(T:=3,Text:='id=14|n=FTT|k=1|s=12', 								_Act:=Acts_PompageB[14]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[14]);
Builder(T:=3,Text:='id=15|n=FTT|k=1|s=13', 								_Act:=Acts_PompageB[15]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageB[15]);

Ctrl_PompageB.Cmd.ForceStepFromId := -1;
Ctrl_PompageB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_PompageB[0].EnableCond :=  TRUE;
Acts_PompageB[1].EnableCond :=  Acts_PompageB[0].Started AND Acts_PompageB[0].Finished;
Acts_PompageB[2].EnableCond :=  TRUE;
Acts_PompageB[3].EnableCond :=  TRUE;
Acts_PompageB[4].EnableCond :=  TRUE;
Acts_PompageB[5].EnableCond :=  TRUE;
Acts_PompageB[6].EnableCond :=  TRUE;
Acts_PompageB[7].EnableCond :=  TRUE;
Acts_PompageB[8].EnableCond :=  Acts_PompageB[7].Started AND Acts_PompageB[7].Finished;
Acts_PompageB[9].EnableCond :=  TRUE;
Acts_PompageB[10].EnableCond := TRUE;
Acts_PompageB[11].EnableCond := TRUE;
Acts_PompageB[12].EnableCond := TRUE;
Acts_PompageB[13].EnableCond := Acts_PompageB[12].Started AND Acts_PompageB[12].Finished;
Acts_PompageB[14].EnableCond := TRUE;
Acts_PompageB[15].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_PompageB[0].Condition  :=  TRUE;
Trans_PompageB[1].Condition  :=  Acts_PompageB[1].Started AND Acts_PompageB[1].Finished AND armoires[1].entrees.pirani;
Trans_PompageB[2].Condition  :=  Acts_PompageB[1].Started AND Acts_PompageB[1].Finished AND NOT(armoires[1].entrees.pirani);
Trans_PompageB[3].Condition  :=  Acts_PompageB[2].Started AND Acts_PompageB[2].Finished AND armoires[1].entrees.pirani;
Trans_PompageB[4].Condition  :=  Acts_PompageB[2].Started AND Acts_PompageB[2].Finished AND NOT(armoires[1].entrees.pirani);
Trans_PompageB[5].Condition  :=  armoires[1].en_cours_de_chgt_apres;
Trans_PompageB[6].Condition  :=  NOT(armoires[1].en_cours_de_chgt_apres);
Trans_PompageB[7].Condition  :=  Steps_PompageB[4].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP5)*1000.0) AND armoires[1].entrees.pirani;
Trans_PompageB[8].Condition  :=  Steps_PompageB[4].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_B].DLP5)*1000.0) AND NOT(armoires[1].entrees.pirani);
Trans_PompageB[9].Condition  :=  TRUE;
Trans_PompageB[10].Condition  := Acts_PompageB[6].Started AND Acts_PompageB[6].Finished AND armoires[1].ana.PT1.Mes &gt;= INT_TO_REAL(config_utilisee.pompage[index_purge_B].SPPE6);
Trans_PompageB[11].Condition  := Acts_PompageB[6].Started AND Acts_PompageB[6].Finished AND armoires[1].ana.PT1.Mes &lt; INT_TO_REAL(config_utilisee.pompage[index_purge_B].SPPE6);
Trans_PompageB[12].Condition  := Acts_PompageB[8].Started AND Acts_PompageB[8].Finished AND armoires[1].ana.PT1.Mes &lt;= INT_TO_REAL(config_utilisee.pompage[index_purge_B].SPPE5) AND armoires[1].entrees.pirani;
Trans_PompageB[13].Condition  := Acts_PompageB[8].Started AND Acts_PompageB[8].Finished AND NOT(armoires[1].ana.PT1.Mes &lt;= INT_TO_REAL(config_utilisee.pompage[index_purge_B].SPPE5) AND armoires[1].entrees.pirani);
Trans_PompageB[14].Condition  := Acts_PompageB[9].Started AND Acts_PompageB[9].Finished AND armoires[1].compteur_cycle_pompage &gt;= config_utilisee.pompage[index_pompage_B].NBPPE;
Trans_PompageB[15].Condition  := Acts_PompageB[9].Started AND Acts_PompageB[9].Finished AND armoires[1].compteur_cycle_pompage &lt; config_utilisee.pompage[index_pompage_B].NBPPE;
Trans_PompageB[16].Condition  := TRUE;
Trans_PompageB[17].Condition  := chgt_valider[0];
Trans_PompageB[18].Condition  := chgt_valider[0];
Trans_PompageB[19].Condition  := chgt_valider[0];
Trans_PompageB[20].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_PompageB.Cmd.ModeReq = 0 THEN Ctrl_PompageB.Cmd.ModeReq := 2; END_IF;
Ctrl_PompageB.Cmd.Enable := TRUE and not(armoires[1].manu);

Gc_PompageB(
    Enable := Ctrl_PompageB.Cmd.Enable,
    ModeReq := Ctrl_PompageB.Cmd.ModeReq,
    FreezeReq := Ctrl_PompageB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_PompageB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_PompageB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_PompageB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_PompageB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_PompageB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_PompageB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_PompageB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_PompageB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_PompageB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_PompageB,
    Transitions := Trans_PompageB,
    Actions := Acts_PompageB
);

(* Retour statut *)
Ctrl_PompageB.Stat.Cycle := Gc_PompageB.Runtime.Cycle;
Ctrl_PompageB.Stat.Phase := Gc_PompageB.Runtime.Phase;
Ctrl_PompageB.Stat.Mode := Gc_PompageB.Runtime.Mode;
Ctrl_PompageB.Stat.ActiveStepCount := Gc_PompageB.Debug.ActiveStepCount;
Ctrl_PompageB.Stat.LastTransitionFiredId := Gc_PompageB.Debug.LastTransitionFiredId;
Ctrl_PompageB.Stat.ConfigFault := Gc_PompageB.Debug.ConfigFault;
Ctrl_PompageB.Stat.WatchdogDetected := Gc_PompageB.Debug.WatchdogDetected;
Ctrl_PompageB.Stat.NoActiveStepFault := Gc_PompageB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_PompageB.Cmd.StepReq := FALSE;
Ctrl_PompageB.Cmd.InitReq := FALSE;
Ctrl_PompageB.Cmd.ResetInitialReq := FALSE;
Ctrl_PompageB.Cmd.ResetAllReq := FALSE;
Ctrl_PompageB.Cmd.ForceBackReq := FALSE;
Ctrl_PompageB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_PurgeB" type="section" SectionOrder="8"></identProgram>
			<STSource>Gc_PurgeB.Runtime.GC_MAX_STEPS := 28;
Gc_PurgeB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_PurgeB.Runtime.GC_MAX_ACTIONS := 28;
Gc_PurgeB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_PurgeB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_PurgeB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_PurgeB[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_PurgeB[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_PurgeB[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_PurgeB[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_PurgeB[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_PurgeB[5]); 
Builder(T:=1,Text:='id=6|n=X6', 						_Step:=Steps_PurgeB[6]); 
Builder(T:=1,Text:='id=7|n=X7', 						_Step:=Steps_PurgeB[7]); 
Builder(T:=1,Text:='id=8|n=X8|f=1',						_Step:=Steps_PurgeB[8]); 
Builder(T:=1,Text:='id=9|n=X9', 						_Step:=Steps_PurgeB[9]); 
Builder(T:=1,Text:='id=10|n=X10', 						_Step:=Steps_PurgeB[10]); 

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=2|c=N2', 							_Trans:=Trans_PurgeB[0]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[0]);
Builder(T:=2,Text:='id=1|s=0|d=1|c=!N2', 							_Trans:=Trans_PurgeB[1]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[1]); 
Builder(T:=2,Text:='id=2|s=1|d=2|c=N2+IHM', 						_Trans:=Trans_PurgeB[2]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[2]);
Builder(T:=2,Text:='id=3|s=2|d=3|c=PT1&lt;=SPUR4', 						_Trans:=Trans_PurgeB[3]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[3]);
Builder(T:=2,Text:='id=4|s=2|d=10|c=PT1&gt;SPUR4', 						_Trans:=Trans_PurgeB[4]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[4]);
Builder(T:=2,Text:='id=5|s=3|d=4|c=PT1&lt;=SPUR5', 						_Trans:=Trans_PurgeB[5]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[5]);
Builder(T:=2,Text:='id=6|s=3|d=10|c=PT1&gt;SPUR5', 						_Trans:=Trans_PurgeB[6]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[6]);
Builder(T:=2,Text:='id=7|s=4|d=5|c=TRUE', 							_Trans:=Trans_PurgeB[7]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[7]);
Builder(T:=2,Text:='id=8|s=5|d=6|c=PT1&lt;=SPUR6', 						_Trans:=Trans_PurgeB[8]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[8]);
Builder(T:=2,Text:='id=9|s=5|d=9|c=PT1&gt;SPUR6', 						_Trans:=Trans_PurgeB[9]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[9]);
Builder(T:=2,Text:='id=10|s=6|d=7|c=PT1&lt;=SPUR5', 						_Trans:=Trans_PurgeB[10]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[10]);
Builder(T:=2,Text:='id=11|s=6|d=10|c=PT1&gt;SPUR5', 						_Trans:=Trans_PurgeB[11]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[11]);
Builder(T:=2,Text:='id=12|s=7|d=8|c=NB==NBSURP', 						_Trans:=Trans_PurgeB[12]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[12]);
Builder(T:=2,Text:='id=13|s=7|d=5|c=NB!=NBSURP', 						_Trans:=Trans_PurgeB[13]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[13]);
Builder(T:=2,Text:='id=14|s=8|d=0|c=TRUE', 							_Trans:=Trans_PurgeB[14]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[14]);
Builder(T:=2,Text:='id=15|s=9|d=0|c=IHM', 							_Trans:=Trans_PurgeB[15]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[15]);
Builder(T:=2,Text:='id=16|s=10|d=0|c=IHM', 							_Trans:=Trans_PurgeB[16]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeB[16]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=OV7|k=4|s=2', 								_Act:=Acts_PurgeB[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL4)*1000.0), 	_Act:=Acts_PurgeB[0]);
Builder(T:=3,Text:='id=1|n=OV3V4|k=11|s=2', 							_Act:=Acts_PurgeB[1]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL5)*1000.0), 	_Act:=Acts_PurgeB[1]);
Builder(T:=3,Text:='id=2|n=FV3|k=4|s=4', 								_Act:=Acts_PurgeB[2]);
Builder(T:=3,d:=t#5s, 										_Act:=Acts_PurgeB[2]);
Builder(T:=3,Text:='id=3|n=OV2|k=4|s=5', 								_Act:=Acts_PurgeB[3]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL7)*1000.0),		_Act:=Acts_PurgeB[3]);
Builder(T:=3,Text:='id=4|n=NB++|k=1|s=5', 								_Act:=Acts_PurgeB[4]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeB[4]);
Builder(T:=3,Text:='id=5|n=ATT|k=4|s=6', 								_Act:=Acts_PurgeB[5]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL8)*1000.0),		_Act:=Acts_PurgeB[5]);
Builder(T:=3,Text:='id=6|n=FV2|k=11|s=6', 								_Act:=Acts_PurgeB[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL9)*1000.0),		_Act:=Acts_PurgeB[6]);
Builder(T:=3,Text:='id=7|n=OV3|k=11|s=6', 								_Act:=Acts_PurgeB[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL10)*1000.0),	_Act:=Acts_PurgeB[7]);
Builder(T:=3,Text:='id=8|n=ATT|k=4|s=7', 								_Act:=Acts_PurgeB[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL11)*1000.0),	_Act:=Acts_PurgeB[8]);
Builder(T:=3,Text:='id=9|n=FV3|k=11|s=7', 								_Act:=Acts_PurgeB[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL12)*1000.0),	_Act:=Acts_PurgeB[9]);
Builder(T:=3,Text:='id=10|n=FV7|k=0|s=8', 								_Act:=Acts_PurgeB[10]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeB[10]);
Builder(T:=3,Text:='id=11|n=FTT|k=0|s=9', 								_Act:=Acts_PurgeB[11]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeB[11]);
Builder(T:=3,Text:='id=12|n=FTT|k=0|s=10', 								_Act:=Acts_PurgeB[12]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeB[12]);

Ctrl_PurgeB.Cmd.ForceStepFromId := -1;
Ctrl_PurgeB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_PurgeB[0].EnableCond := TRUE;
Acts_PurgeB[1].EnableCond := Acts_PurgeB[0].Started AND Acts_PurgeB[0].Finished;
Acts_PurgeB[2].EnableCond := TRUE;
Acts_PurgeB[3].EnableCond := TRUE;
Acts_PurgeB[4].EnableCond := TRUE;
Acts_PurgeB[5].EnableCond := TRUE;
Acts_PurgeB[6].EnableCond := Acts_PurgeB[5].Started AND Acts_PurgeB[5].Finished;
Acts_PurgeB[7].EnableCond := Acts_PurgeB[6].Started AND Acts_PurgeB[6].Finished;
Acts_PurgeB[8].EnableCond := TRUE;
Acts_PurgeB[9].EnableCond := Acts_PurgeB[8].Started AND Acts_PurgeB[8].Finished;
Acts_PurgeB[10].EnableCond := TRUE;
Acts_PurgeB[11].EnableCond := TRUE;
Acts_PurgeB[12].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_PurgeB[0].Condition  := armoires[1].entrees.span_N2;
Trans_PurgeB[1].Condition  := NOT(armoires[1].entrees.span_N2);
Trans_PurgeB[2].Condition  := armoires[1].entrees.span_N2 and chgt_valider[0];
Trans_PurgeB[3].Condition  := Acts_PurgeB[1].Started AND Acts_PurgeB[1].Finished AND armoires[1].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR4);
Trans_PurgeB[4].Condition  := Acts_PurgeB[1].Started AND Acts_PurgeB[1].Finished AND armoires[1].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR4);
Trans_PurgeB[5].Condition  := Steps_PurgeB[3].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL6)*1000.0) AND armoires[1].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR5);
Trans_PurgeB[6].Condition  := Steps_PurgeB[3].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_B].DL6)*1000.0) AND armoires[1].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR5);
Trans_PurgeB[7].Condition  := Steps_PurgeB[4].ActiveTime &gt;= t#5s;
Trans_PurgeB[8].Condition  := Acts_PurgeB[3].Started AND Acts_PurgeB[3].Finished AND armoires[1].ana.PT1.mes &gt;= INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR6);
Trans_PurgeB[9].Condition  := Acts_PurgeB[3].Started AND Acts_PurgeB[3].Finished AND armoires[1].ana.PT1.mes &lt; INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR6);
Trans_PurgeB[10].Condition  := Acts_PurgeB[7].Started AND Acts_PurgeB[7].Finished AND armoires[1].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR5);
Trans_PurgeB[11].Condition  := Acts_PurgeB[7].Started AND Acts_PurgeB[7].Finished AND armoires[1].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_B].SPUR5);
Trans_PurgeB[12].Condition  := Acts_PurgeB[9].Started AND Acts_PurgeB[9].Finished AND armoires[1].compteur_cycle_purge &gt;= config_utilisee.purge[index_purge_B].NBPUR;
Trans_PurgeB[13].Condition  := Acts_PurgeB[9].Started AND Acts_PurgeB[9].Finished AND armoires[1].compteur_cycle_purge &lt; config_utilisee.purge[index_purge_B].NBPUR;
Trans_PurgeB[14].Condition  := TRUE;
Trans_PurgeB[15].Condition  := chgt_valider[0];
Trans_PurgeB[16].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_PurgeB.Cmd.ModeReq = 0 THEN Ctrl_PurgeB.Cmd.ModeReq := 2; END_IF;
Ctrl_PurgeB.Cmd.Enable := TRUE and not(armoires[1].manu);

Gc_PurgeB(
    Enable := Ctrl_PurgeB.Cmd.Enable,
    ModeReq := Ctrl_PurgeB.Cmd.ModeReq,
    FreezeReq := Ctrl_PurgeB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_PurgeB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_PurgeB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_PurgeB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_PurgeB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_PurgeB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_PurgeB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_PurgeB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_PurgeB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_PurgeB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_PurgeB,
    Transitions := Trans_PurgeB,
    Actions := Acts_PurgeB
);

(* Retour statut *)
Ctrl_PurgeB.Stat.Cycle := Gc_PurgeB.Runtime.Cycle;
Ctrl_PurgeB.Stat.Phase := Gc_PurgeB.Runtime.Phase;
Ctrl_PurgeB.Stat.Mode := Gc_PurgeB.Runtime.Mode;
Ctrl_PurgeB.Stat.ActiveStepCount := Gc_PurgeB.Debug.ActiveStepCount;
Ctrl_PurgeB.Stat.LastTransitionFiredId := Gc_PurgeB.Debug.LastTransitionFiredId;
Ctrl_PurgeB.Stat.ConfigFault := Gc_PurgeB.Debug.ConfigFault;
Ctrl_PurgeB.Stat.WatchdogDetected := Gc_PurgeB.Debug.WatchdogDetected;
Ctrl_PurgeB.Stat.NoActiveStepFault := Gc_PurgeB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_PurgeB.Cmd.StepReq := FALSE;
Ctrl_PurgeB.Cmd.InitReq := FALSE;
Ctrl_PurgeB.Cmd.ResetInitialReq := FALSE;
Ctrl_PurgeB.Cmd.ResetAllReq := FALSE;
Ctrl_PurgeB.Cmd.ForceBackReq := FALSE;
Ctrl_PurgeB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_HeliumAVB" type="section" SectionOrder="9"></identProgram>
			<STSource>Gc_HeliumAVB.Runtime.GC_MAX_STEPS := 28;
Gc_HeliumAVB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_HeliumAVB.Runtime.GC_MAX_ACTIONS := 28;
Gc_HeliumAVB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_HeliumAVB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_HeliumAVB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_HeliumAVB[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_HeliumAVB[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_HeliumAVB[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_HeliumAVB[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_HeliumAVB[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_HeliumAVB[5]);
Builder(T:=1,Text:='id=6|n=X6|f=1', 					_Step:=Steps_HeliumAVB[6]);

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=TRUE', 					_Trans:=Trans_HeliumAVB[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=IHM', 					_Trans:=Trans_HeliumAVB[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[1]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=IHM', 					_Trans:=Trans_HeliumAVB[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=FPURGE', 				_Trans:=Trans_HeliumAVB[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[3]); 
Builder(T:=2,Text:='id=4|s=4|d=5|c=FPOMPAGE', 				_Trans:=Trans_HeliumAVB[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[4]);
Builder(T:=2,Text:='id=5|s=5|d=6|c=IHM', 					_Trans:=Trans_HeliumAVB[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[5]);
Builder(T:=2,Text:='id=6|s=6|d=0|c=TRUE', 					_Trans:=Trans_HeliumAVB[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVB[6]);  

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FTTOV4VHE|k=0|s=1', 				_Act:=Acts_HeliumAVB[0]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[0]);
Builder(T:=3,Text:='id=1|n=FTT|k=0|s=2', 					_Act:=Acts_HeliumAVB[1]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[1]);
Builder(T:=3,Text:='id=2|n=IPURGE|k=1|s=3', 				_Act:=Acts_HeliumAVB[2]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[2]);
Builder(T:=3,Text:='id=3|n=RPURGE|k=5|s=3', 				_Act:=Acts_HeliumAVB[3]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[3]);
Builder(T:=3,Text:='id=4|n=IPOMPAGE|k=1|s=4', 				_Act:=Acts_HeliumAVB[4]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[4]);
Builder(T:=3,Text:='id=5|n=RPOMPAGE|k=5|s=4', 				_Act:=Acts_HeliumAVB[5]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVB[5]);

Ctrl_HeliumAVB.Cmd.ForceStepFromId := -1;
Ctrl_HeliumAVB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_HeliumAVB[0].EnableCond := TRUE;
Acts_HeliumAVB[1].EnableCond := TRUE;
Acts_HeliumAVB[2].EnableCond := TRUE;
Acts_HeliumAVB[3].EnableCond := TRUE;
Acts_HeliumAVB[4].EnableCond := TRUE;
Acts_HeliumAVB[5].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_HeliumAVB[0].Condition  := TRUE;
Trans_HeliumAVB[1].Condition  := chgt_valider[0];
Trans_HeliumAVB[2].Condition  := chgt_valider[0];
Trans_HeliumAVB[3].Condition  := Steps_HeliumAVB[3].ActiveTime &gt;= t#1s AND Gc_PurgeB.Finished;
Trans_HeliumAVB[4].Condition  := Steps_HeliumAVB[4].ActiveTime &gt;= t#1s AND Gc_PompageB.Finished;
Trans_HeliumAVB[5].Condition  := chgt_valider[0];
Trans_HeliumAVB[6].Condition  := TRUE;

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_HeliumAVB.Cmd.ModeReq = 0 THEN Ctrl_HeliumAVB.Cmd.ModeReq := 2; END_IF;
Ctrl_HeliumAVB.Cmd.Enable := TRUE and not(armoires[1].manu);

Gc_HeliumAVB(
    Enable := Ctrl_HeliumAVB.Cmd.Enable,
    ModeReq := Ctrl_HeliumAVB.Cmd.ModeReq,
    FreezeReq := Ctrl_HeliumAVB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_HeliumAVB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_HeliumAVB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_HeliumAVB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_HeliumAVB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_HeliumAVB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_HeliumAVB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_HeliumAVB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_HeliumAVB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_HeliumAVB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_HeliumAVB,
    Transitions := Trans_HeliumAVB,
    Actions := Acts_HeliumAVB
);

(* Retour statut *)
Ctrl_HeliumAVB.Stat.Cycle := Gc_HeliumAVB.Runtime.Cycle;
Ctrl_HeliumAVB.Stat.Phase := Gc_HeliumAVB.Runtime.Phase;
Ctrl_HeliumAVB.Stat.Mode := Gc_HeliumAVB.Runtime.Mode;
Ctrl_HeliumAVB.Stat.ActiveStepCount := Gc_HeliumAVB.Debug.ActiveStepCount;
Ctrl_HeliumAVB.Stat.LastTransitionFiredId := Gc_HeliumAVB.Debug.LastTransitionFiredId;
Ctrl_HeliumAVB.Stat.ConfigFault := Gc_HeliumAVB.Debug.ConfigFault;
Ctrl_HeliumAVB.Stat.WatchdogDetected := Gc_HeliumAVB.Debug.WatchdogDetected;
Ctrl_HeliumAVB.Stat.NoActiveStepFault := Gc_HeliumAVB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_HeliumAVB.Cmd.StepReq := FALSE;
Ctrl_HeliumAVB.Cmd.InitReq := FALSE;
Ctrl_HeliumAVB.Cmd.ResetInitialReq := FALSE;
Ctrl_HeliumAVB.Cmd.ResetAllReq := FALSE;
Ctrl_HeliumAVB.Cmd.ForceBackReq := FALSE;
Ctrl_HeliumAVB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_Helium_APB" type="section" SectionOrder="10"></identProgram>
			<STSource>Gc_HeliumAPB.Runtime.GC_MAX_STEPS := 28;
Gc_HeliumAPB.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_HeliumAPB.Runtime.GC_MAX_ACTIONS := 28;
Gc_HeliumAPB.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_HeliumAPB.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_HeliumAPB.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_HeliumAPB[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_HeliumAPB[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_HeliumAPB[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_HeliumAPB[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_HeliumAPB[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_HeliumAPB[5]);
Builder(T:=1,Text:='id=6|n=X6', 						_Step:=Steps_HeliumAPB[6]); 
Builder(T:=1,Text:='id=7|n=X7', 						_Step:=Steps_HeliumAPB[7]); 
Builder(T:=1,Text:='id=8|n=X8', 						_Step:=Steps_HeliumAPB[8]); 
Builder(T:=1,Text:='id=9|n=X9', 						_Step:=Steps_HeliumAPB[9]); 
Builder(T:=1,Text:='id=10|n=X10', 						_Step:=Steps_HeliumAPB[10]);
Builder(T:=1,Text:='id=11|n=X11', 						_Step:=Steps_HeliumAPB[11]);
Builder(T:=1,Text:='id=12|n=X12', 						_Step:=Steps_HeliumAPB[12]);
Builder(T:=1,Text:='id=13|n=X13|f=1', 					_Step:=Steps_HeliumAPB[13]);

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=IHM', 					_Trans:=Trans_HeliumAPB[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=FPURGE', 				_Trans:=Trans_HeliumAPB[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[1]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=FPOMPAGE', 				_Trans:=Trans_HeliumAPB[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=IHM', 					_Trans:=Trans_HeliumAPB[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[3]); 
Builder(T:=2,Text:='id=4|s=4|d=5|c=IHM', 					_Trans:=Trans_HeliumAPB[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[4]);
Builder(T:=2,Text:='id=5|s=5|d=6|c=TRUE', 					_Trans:=Trans_HeliumAPB[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[5]);
Builder(T:=2,Text:='id=6|s=6|d=7|c=IHM', 					_Trans:=Trans_HeliumAPB[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[6]); 
Builder(T:=2,Text:='id=7|s=6|d=5|c=!IHM', 					_Trans:=Trans_HeliumAPB[7]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[7]);
Builder(T:=2,Text:='id=8|s=7|d=8|c=!IHM', 					_Trans:=Trans_HeliumAPB[8]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[8]);
Builder(T:=2,Text:='id=9|s=7|d=4|c=IHM', 					_Trans:=Trans_HeliumAPB[9]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[9]);
Builder(T:=2,Text:='id=10|s=8|d=11|c=!IHM', 				_Trans:=Trans_HeliumAPB[10]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[10]);
Builder(T:=2,Text:='id=11|s=8|d=9|c=IHM', 					_Trans:=Trans_HeliumAPB[11]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[11]);
Builder(T:=2,Text:='id=12|s=9|d=10|c=FPURGE', 				_Trans:=Trans_HeliumAPB[12]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[12]);
Builder(T:=2,Text:='id=13|s=10|d=11|c=FPOMPAGE', 				_Trans:=Trans_HeliumAPB[13]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[13]);
Builder(T:=2,Text:='id=14|s=11|d=12|c=IHM', 				_Trans:=Trans_HeliumAPB[14]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[14]);
Builder(T:=2,Text:='id=15|s=12|d=13|c=IHM', 				_Trans:=Trans_HeliumAPB[15]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[15]);
Builder(T:=2,Text:='id=16|s=13|d=0|c=TRUE', 				_Trans:=Trans_HeliumAPB[16]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPB[16]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=IPURGE|k=1|s=1', 						_Act:=Acts_HeliumAPB[0]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[0]);
Builder(T:=3,Text:='id=1|n=RPURGE|k=5|s=1', 						_Act:=Acts_HeliumAPB[1]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[1]);
Builder(T:=3,Text:='id=2|n=IPOMPAGE|k=1|s=2', 						_Act:=Acts_HeliumAPB[2]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[2]);
Builder(T:=3,Text:='id=3|n=RPOMPAGE|k=5|s=2', 						_Act:=Acts_HeliumAPB[3]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[3]);
Builder(T:=3,Text:='id=4|n=FV2V4|k=4|s=4', 							_Act:=Acts_HeliumAPB[4]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE1)*1000.0), 		_Act:=Acts_HeliumAPB[4]);
Builder(T:=3,Text:='id=5|n=FVHE|k=1|s=5', 							_Act:=Acts_HeliumAPB[5]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[5]);
Builder(T:=3,Text:='id=6|n=OV7|k=4|s=6', 							_Act:=Acts_HeliumAPB[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE2)*1000.0), 		_Act:=Acts_HeliumAPB[6]);
Builder(T:=3,Text:='id=7|n=OV3V4|k=11|s=6', 						_Act:=Acts_HeliumAPB[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE3)*1000.0), 		_Act:=Acts_HeliumAPB[7]);
Builder(T:=3,Text:='id=8|n=FV3V4|k=11|s=6', 						_Act:=Acts_HeliumAPB[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE4)*1000.0), 		_Act:=Acts_HeliumAPB[8]);
Builder(T:=3,Text:='id=9|n=FV7|k=11|s=6', 							_Act:=Acts_HeliumAPB[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE5)*1000.0), 		_Act:=Acts_HeliumAPB[9]);
Builder(T:=3,Text:='id=10|n=OVHE|k=0|s=6', 							_Act:=Acts_HeliumAPB[10]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[10]);
Builder(T:=3,Text:='id=11|n=FVHE|k=1|s=7', 							_Act:=Acts_HeliumAPB[11]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[11]);
Builder(T:=3,Text:='id=12|n=IPURGE|k=1|s=9', 						_Act:=Acts_HeliumAPB[12]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[12]);
Builder(T:=3,Text:='id=13|n=RPURGE|k=5|s=9', 						_Act:=Acts_HeliumAPB[13]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[13]);
Builder(T:=3,Text:='id=14|n=IPOMPAGE|k=1|s=10', 						_Act:=Acts_HeliumAPB[14]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[14]);
Builder(T:=3,Text:='id=15|n=RPOMPAGE|k=5|s=10', 						_Act:=Acts_HeliumAPB[15]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPB[15]);

Ctrl_HeliumAPB.Cmd.ForceStepFromId := -1;
Ctrl_HeliumAPB.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_HeliumAPB[0].EnableCond := TRUE;
Acts_HeliumAPB[1].EnableCond := TRUE;
Acts_HeliumAPB[2].EnableCond := TRUE;
Acts_HeliumAPB[3].EnableCond := TRUE;
Acts_HeliumAPB[4].EnableCond := TRUE;
Acts_HeliumAPB[5].EnableCond := armoires[1].sorties.VHE.F1;
Acts_HeliumAPB[6].EnableCond := TRUE;
Acts_HeliumAPB[7].EnableCond := Acts_HeliumAPB[6].Started AND Acts_HeliumAPB[6].Finished;
Acts_HeliumAPB[8].EnableCond := Acts_HeliumAPB[7].Started AND Acts_HeliumAPB[7].Finished;
Acts_HeliumAPB[9].EnableCond := Acts_HeliumAPB[8].Started AND Acts_HeliumAPB[8].Finished;
Acts_HeliumAPB[10].EnableCond := Acts_HeliumAPB[9].Started AND Acts_HeliumAPB[9].Finished;
Acts_HeliumAPB[11].EnableCond := TRUE;
Acts_HeliumAPB[12].EnableCond := TRUE;
Acts_HeliumAPB[13].EnableCond := TRUE;
Acts_HeliumAPB[14].EnableCond := TRUE;
Acts_HeliumAPB[15].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_HeliumAPB[0].Condition  := chgt_valider[0];
Trans_HeliumAPB[1].Condition  := Steps_HeliumAPB[1].ActiveTime &gt;= t#1s AND Gc_PurgeB.Finished;
Trans_HeliumAPB[2].Condition  := Steps_HeliumAPB[2].ActiveTime &gt;= t#1s AND Gc_PompageB.Finished;
Trans_HeliumAPB[3].Condition  := chgt_valider[0];
Trans_HeliumAPB[4].Condition  := Acts_HeliumAPB[4].Started AND Acts_HeliumAPB[4].Finished AND chgt_valider[0];
Trans_HeliumAPB[5].Condition  := TRUE;
Trans_HeliumAPB[6].Condition  := Acts_HeliumAPB[9].Started AND Acts_HeliumAPB[9].Finished AND chgt_valider[0];
Trans_HeliumAPB[7].Condition  := Acts_HeliumAPB[9].Started AND Acts_HeliumAPB[9].Finished AND chgt_valider[1];
Trans_HeliumAPB[8].Condition  := chgt_valider[1];
Trans_HeliumAPB[9].Condition  := chgt_valider[0];
Trans_HeliumAPB[10].Condition  := chgt_valider[1];
Trans_HeliumAPB[11].Condition  := chgt_valider[0];
Trans_HeliumAPB[12].Condition  := Steps_HeliumAPB[9].ActiveTime &gt;= t#1s AND Gc_PurgeB.Finished;
Trans_HeliumAPB[13].Condition  := Steps_HeliumAPB[10].ActiveTime &gt;= t#1s AND Gc_PompageB.Finished;
Trans_HeliumAPB[14].Condition  := chgt_valider[0];
Trans_HeliumAPB[15].Condition  := chgt_valider[0];
Trans_HeliumAPB[16].Condition  := TRUE;

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_HeliumAPB.Cmd.ModeReq = 0 THEN Ctrl_HeliumAPB.Cmd.ModeReq := 2; END_IF;
Ctrl_HeliumAPB.Cmd.Enable := TRUE and not(armoires[1].manu);

Gc_HeliumAPB(
    Enable := Ctrl_HeliumAPB.Cmd.Enable,
    ModeReq := Ctrl_HeliumAPB.Cmd.ModeReq,
    FreezeReq := Ctrl_HeliumAPB.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_HeliumAPB.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_HeliumAPB.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_HeliumAPB.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_HeliumAPB.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_HeliumAPB.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_HeliumAPB.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_HeliumAPB.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_HeliumAPB.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_HeliumAPB.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_HeliumAPB,
    Transitions := Trans_HeliumAPB,
    Actions := Acts_HeliumAPB
);

(* Retour statut *)
Ctrl_HeliumAPB.Stat.Cycle := Gc_HeliumAPB.Runtime.Cycle;
Ctrl_HeliumAPB.Stat.Phase := Gc_HeliumAPB.Runtime.Phase;
Ctrl_HeliumAPB.Stat.Mode := Gc_HeliumAPB.Runtime.Mode;
Ctrl_HeliumAPB.Stat.ActiveStepCount := Gc_HeliumAPB.Debug.ActiveStepCount;
Ctrl_HeliumAPB.Stat.LastTransitionFiredId := Gc_HeliumAPB.Debug.LastTransitionFiredId;
Ctrl_HeliumAPB.Stat.ConfigFault := Gc_HeliumAPB.Debug.ConfigFault;
Ctrl_HeliumAPB.Stat.WatchdogDetected := Gc_HeliumAPB.Debug.WatchdogDetected;
Ctrl_HeliumAPB.Stat.NoActiveStepFault := Gc_HeliumAPB.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_HeliumAPB.Cmd.StepReq := FALSE;
Ctrl_HeliumAPB.Cmd.InitReq := FALSE;
Ctrl_HeliumAPB.Cmd.ResetInitialReq := FALSE;
Ctrl_HeliumAPB.Cmd.ResetAllReq := FALSE;
Ctrl_HeliumAPB.Cmd.ForceBackReq := FALSE;
Ctrl_HeliumAPB.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ChangementB_Actions" type="section" SectionOrder="11"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* CHGTB_X0 *)


(* ____________________________________________________________________ *)
(* CHGTB_X1 *)

IF Acts_ChangementB[1].Out THEN
	Close(arm:=armoires[1]);
	
	Ctrl_DetoxalB.Cmd.ModeReq := 0;
	Ctrl_DetoxalB.Cmd.InitReq := TRUE;
	Ctrl_PurgeB.Cmd.ModeReq := 0;
	Ctrl_PurgeB.Cmd.InitReq := TRUE;
	Ctrl_PompageB.Cmd.ModeReq := 0;
	Ctrl_PompageB.Cmd.InitReq := TRUE;
	Ctrl_HeliumAVB.Cmd.ModeReq := 0;
	Ctrl_HeliumAVB.Cmd.InitReq := TRUE;
	Ctrl_HeliumAPB.Cmd.ModeReq := 0;
	Ctrl_HeliumAPB.Cmd.InitReq := TRUE;

	DEBUG_DETOXAL_0 := 0;
	DEBUG_PURGE_0 := 0;
	DEBUG_POMPAGE_0 := 0;
	DEBUG_HELIUM_0 := 0;
	DEBUG_CHGT := 0;
	DEBUG_DETOXAL_1 := 0;
	DEBUG_PURGE_1 := 0;
	DEBUG_POMPAGE_1 := 0;
	DEBUG_HELIUM_1 := 0;

	index_purge_B := 0;
	index_pompage_B := 0;
	
	armoires[1].bouteille_presque_vide := false;
	armoires[1].bouteille_vide := false;
	if not(modification_majeure) and not(armoires[1].retour_sur_chgt) and not(armoires[1].retour_sur_chgt_ap_decl) then
		armoires[1].en_cours_de_chgt := false;
		armoires[1].en_cours_de_chgt_avant := false;
		armoires[1].en_cours_de_chgt_apres := false;
	end_if;
END_IF;

(* ____________________________________________________________________ *)
(* CHGTB_X2 *)

IF Acts_ChangementB[2].Out THEN
	InitDone_DetoxalB := FALSE;

	Ctrl_DetoxalB.Cmd.ModeReq := 1;
	Ctrl_DetoxalB.Cmd.InitReq := TRUE;
	Ctrl_PurgeB.Cmd.ModeReq := 0;
	Ctrl_PurgeB.Cmd.InitReq := TRUE;
	Ctrl_PompageB.Cmd.ModeReq := 0;
	Ctrl_PompageB.Cmd.InitReq := TRUE;
	Ctrl_HeliumAVB.Cmd.ModeReq := 0;
	Ctrl_HeliumAVB.Cmd.InitReq := TRUE;
	Ctrl_HeliumAPB.Cmd.ModeReq := 0;
	Ctrl_HeliumAPB.Cmd.InitReq := TRUE;

	DEBUG_DETOXAL_0 := 1;
	DEBUG_PURGE_0 := 0;
	DEBUG_POMPAGE_0 := 0;
	DEBUG_HELIUM_0 := 0;
	DEBUG_CHGT := 0;
	DEBUG_DETOXAL_1 := 0;
	DEBUG_PURGE_1 := 0;
	DEBUG_POMPAGE_1 := 0;
	DEBUG_HELIUM_1 := 0;

	index_purge_B := 0;
	index_pompage_B := 0;
END_IF;

IF Acts_ChangementB[15].Out THEN
	Ctrl_DetoxalB.Cmd.ModeReq := 0;
	DEBUG_DETOXAL_0 := 2;
END_IF;

(* ____________________________________________________________________ *)
