Builder(T:=3,Text:='id=20|n=RPURGE|k=5|s=9', 				_Act:=Acts_ChangementA[20]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementA[20]);
Builder(T:=3,Text:='id=21|n=RPOMPAGE|k=5|s=10', 				_Act:=Acts_ChangementA[21]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementA[21]);
Builder(T:=3,Text:='id=22|n=RHELIUM|k=5|s=11', 				_Act:=Acts_ChangementA[22]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_ChangementA[22]);


Ctrl_ChangementA.Cmd.ForceStepFromId := -1;
Ctrl_ChangementA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_ChangementA[0].EnableCond := TRUE;
Acts_ChangementA[1].EnableCond := TRUE;
Acts_ChangementA[2].EnableCond := TRUE;
Acts_ChangementA[3].EnableCond := TRUE;
Acts_ChangementA[4].EnableCond := TRUE;
Acts_ChangementA[5].EnableCond := TRUE;
Acts_ChangementA[6].EnableCond := TRUE;
Acts_ChangementA[7].EnableCond := TRUE;
Acts_ChangementA[8].EnableCond := TRUE;
Acts_ChangementA[9].EnableCond := TRUE;
Acts_ChangementA[10].EnableCond := TRUE;
Acts_ChangementA[11].EnableCond := TRUE;
Acts_ChangementA[12].EnableCond := TRUE;
Acts_ChangementA[13].EnableCond := TRUE;
Acts_ChangementA[14].EnableCond := TRUE;
Acts_ChangementA[15].EnableCond := TRUE;
Acts_ChangementA[16].EnableCond := TRUE;
Acts_ChangementA[17].EnableCond := TRUE;
Acts_ChangementA[18].EnableCond := TRUE;
Acts_ChangementA[19].EnableCond := TRUE;
Acts_ChangementA[20].EnableCond := TRUE;
Acts_ChangementA[21].EnableCond := TRUE;
Acts_ChangementA[22].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_ChangementA[0].Condition  := armoires[0].en_cours_de_chgt AND armoires[0].en_cours_de_chgt_avant;
Trans_ChangementA[1].Condition  := chgt_valider[0] and not(armoires[0].retour_sur_chgt) and not(armoires[0].retour_sur_chgt_ap_decl);
Trans_ChangementA[2].Condition  := Steps_ChangementA[2].ActiveTime &gt;= t#1s AND Gc_DetoxalA.Finished OR NOT(generalites.pres_detoxal);
Trans_ChangementA[3].Condition  := Steps_ChangementA[3].ActiveTime &gt;= t#1s AND Gc_PurgeA.Finished;
Trans_ChangementA[4].Condition  := Steps_ChangementA[4].ActiveTime &gt;= t#1s AND Gc_PompageA.Finished;
Trans_ChangementA[5].Condition  := Steps_ChangementA[5].ActiveTime &gt;= t#1s AND Gc_HeliumAVA.Finished OR NOT(generalites.pres_robinets);
Trans_ChangementA[6].Condition  := chgt_valider[0];
Trans_ChangementA[7].Condition  := chgt_valider[0] OR NOT(generalites.conf_poids);
Trans_ChangementA[8].Condition  := Steps_ChangementA[8].ActiveTime &gt;= t#1s AND Gc_DetoxalA.Finished OR NOT(generalites.pres_detoxal);
Trans_ChangementA[9].Condition  := Steps_ChangementA[9].ActiveTime &gt;= t#1s AND Gc_PurgeA.Finished;
Trans_ChangementA[10].Condition  := Steps_ChangementA[10].ActiveTime &gt;= t#1s AND Gc_PompageA.Finished;
Trans_ChangementA[11].Condition  := (Steps_ChangementA[11].ActiveTime &gt;= t#1s AND Gc_HeliumAPA.Finished OR NOT(generalites.pres_robinets)) AND armoires[0].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.chgt.SPV);
Trans_ChangementA[12].Condition  := (Steps_ChangementA[11].ActiveTime &gt;= t#1s AND Gc_HeliumAPA.Finished OR NOT(generalites.pres_robinets)) AND armoires[0].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.chgt.SPV);
Trans_ChangementA[13].Condition  := chgt_valider[0] AND NOT(armoires[0].Entrees.Extraction);
Trans_ChangementA[14].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

Ctrl_ChangementA.Cmd.Enable := configuree and not(armoires[0].manu);
Ctrl_ChangementA.Cmd.ModeReq := 1;

Gc_ChangementA(
    Enable := Ctrl_ChangementA.Cmd.Enable,
    ModeReq := Ctrl_ChangementA.Cmd.ModeReq,
    FreezeReq := Ctrl_ChangementA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_ChangementA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_ChangementA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_ChangementA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_ChangementA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_ChangementA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_ChangementA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_ChangementA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_ChangementA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_ChangementA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_ChangementA,
    Transitions := Trans_ChangementA,
    Actions := Acts_ChangementA
);

(* Retour statut *)
Ctrl_ChangementA.Stat.Cycle := Gc_ChangementA.Runtime.Cycle;
Ctrl_ChangementA.Stat.Phase := Gc_ChangementA.Runtime.Phase;
Ctrl_ChangementA.Stat.Mode := Gc_ChangementA.Runtime.Mode;
Ctrl_ChangementA.Stat.ActiveStepCount := Gc_ChangementA.Debug.ActiveStepCount;
Ctrl_ChangementA.Stat.LastTransitionFiredId := Gc_ChangementA.Debug.LastTransitionFiredId;
Ctrl_ChangementA.Stat.ConfigFault := Gc_ChangementA.Debug.ConfigFault;
Ctrl_ChangementA.Stat.WatchdogDetected := Gc_ChangementA.Debug.WatchdogDetected;
Ctrl_ChangementA.Stat.NoActiveStepFault := Gc_ChangementA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_ChangementA.Cmd.StepReq := FALSE;
Ctrl_ChangementA.Cmd.InitReq := FALSE;
Ctrl_ChangementA.Cmd.ResetInitialReq := FALSE;
Ctrl_ChangementA.Cmd.ResetAllReq := FALSE;
Ctrl_ChangementA.Cmd.ForceBackReq := FALSE;
Ctrl_ChangementA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_DetoxalA" type="section" SectionOrder="6"></identProgram>
			<STSource>Gc_DetoxalA.Runtime.GC_MAX_STEPS := 28;
Gc_DetoxalA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_DetoxalA.Runtime.GC_MAX_ACTIONS := 28;
Gc_DetoxalA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_DetoxalA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_DetoxalA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_DetoxalA[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_DetoxalA[1]); 
Builder(T:=1,Text:='id=2|n=X2|f=1', 					_Step:=Steps_DetoxalA[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_DetoxalA[3]);

(* =========================
TRANSITIONS DETOX
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=DEBIT', 					_Trans:=Trans_DetoxalA[0]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[0]); 
Builder(T:=2,Text:='id=1|s=0|d=3|c=!DEBIT', 				_Trans:=Trans_DetoxalA[1]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[1]);
Builder(T:=2,Text:='id=2|s=1|d=2|c=PT1&lt;=SP', 				_Trans:=Trans_DetoxalA[2]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[2]);
Builder(T:=2,Text:='id=3|s=1|d=3|c=PT1&gt;SP', 				_Trans:=Trans_DetoxalA[3]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[3]);
Builder(T:=2,Text:='id=4|s=2|d=0|c=TRUE', 					_Trans:=Trans_DetoxalA[4]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[4]);
Builder(T:=2,Text:='id=5|s=3|d=0|c=IHM', 					_Trans:=Trans_DetoxalA[5]);
Builder(T:=2,d:=t#0s,							_Trans:=Trans_DetoxalA[5]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=OV3V4|k=4|s=1', 							_Act:=Acts_DetoxalA[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.detoxal.DLDETOX)*1000.0), 		_Act:=Acts_DetoxalA[0]);
Builder(T:=3,Text:='id=1|n=FV3|k=1|s=2', 							_Act:=Acts_DetoxalA[1]);
Builder(T:=3,d:=t#0s,								 	_Act:=Acts_DetoxalA[1]);
Builder(T:=3,Text:='id=2|n=FV3V4|k=1|s=3', 							_Act:=Acts_DetoxalA[2]);
Builder(T:=3,d:=t#0s,								 	_Act:=Acts_DetoxalA[2]);  
	
Ctrl_DetoxalA.Cmd.ForceStepFromId := -1;
Ctrl_DetoxalA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_DetoxalA[0].EnableCond := TRUE;
Acts_DetoxalA[1].EnableCond := TRUE;
Acts_DetoxalA[2].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_DetoxalA[0].Condition := armoires[0].entrees.detoxal;
Trans_DetoxalA[1].Condition := NOT(armoires[0].entrees.detoxal);     				
Trans_DetoxalA[2].Condition := Steps_DetoxalA[1].ActiveTime &gt;= t#1s AND Acts_DetoxalA[0].Started AND Acts_DetoxalA[0].Finished AND armoires[0].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.detoxal.SPDETOX);
Trans_DetoxalA[3].Condition := Steps_DetoxalA[1].ActiveTime &gt;= t#1s AND Acts_DetoxalA[0].Started AND Acts_DetoxalA[0].Finished AND armoires[0].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.detoxal.SPDETOX);
Trans_DetoxalA[4].Condition := TRUE;
Trans_DetoxalA[5].Condition := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_DetoxalA.Cmd.ModeReq = 0 THEN Ctrl_DetoxalA.Cmd.ModeReq := 2; END_IF;
Ctrl_DetoxalA.Cmd.Enable := generalites.pres_detoxal and not(armoires[0].manu) and not(modification_majeure);

Gc_DetoxalA(
    Enable := Ctrl_DetoxalA.Cmd.Enable,
    ModeReq := Ctrl_DetoxalA.Cmd.ModeReq,
    FreezeReq := Ctrl_DetoxalA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_DetoxalA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_DetoxalA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_DetoxalA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_DetoxalA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_DetoxalA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_DetoxalA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_DetoxalA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_DetoxalA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_DetoxalA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_DetoxalA,
    Transitions := Trans_DetoxalA,
    Actions := Acts_DetoxalA
);

(* Retour statut *)
Ctrl_DetoxalA.Stat.Cycle := Gc_DetoxalA.Runtime.Cycle;
Ctrl_DetoxalA.Stat.Phase := Gc_DetoxalA.Runtime.Phase;
Ctrl_DetoxalA.Stat.Mode := Gc_DetoxalA.Runtime.Mode;
Ctrl_DetoxalA.Stat.ActiveStepCount := Gc_DetoxalA.Debug.ActiveStepCount;
Ctrl_DetoxalA.Stat.LastTransitionFiredId := Gc_DetoxalA.Debug.LastTransitionFiredId;
Ctrl_DetoxalA.Stat.ConfigFault := Gc_DetoxalA.Debug.ConfigFault;
Ctrl_DetoxalA.Stat.WatchdogDetected := Gc_DetoxalA.Debug.WatchdogDetected;
Ctrl_DetoxalA.Stat.NoActiveStepFault := Gc_DetoxalA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_DetoxalA.Cmd.StepReq := FALSE;
Ctrl_DetoxalA.Cmd.InitReq := FALSE;
Ctrl_DetoxalA.Cmd.ResetInitialReq := FALSE;
Ctrl_DetoxalA.Cmd.ResetAllReq := FALSE;
Ctrl_DetoxalA.Cmd.ForceBackReq := FALSE;
Ctrl_DetoxalA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_PompageA" type="section" SectionOrder="7"></identProgram>
			<STSource>Gc_PompageA.Runtime.GC_MAX_STEPS := 28;
Gc_PompageA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_PompageA.Runtime.GC_MAX_ACTIONS := 28;
Gc_PompageA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_PompageA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_PompageA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 								_Step:=Steps_PompageA[0]);
Builder(T:=1,Text:='id=1|n=X1', 									_Step:=Steps_PompageA[1]); 
Builder(T:=1,Text:='id=2|n=X2', 									_Step:=Steps_PompageA[2]); 
Builder(T:=1,Text:='id=3|n=X3', 									_Step:=Steps_PompageA[3]); 
Builder(T:=1,Text:='id=4|n=X4', 									_Step:=Steps_PompageA[4]); 
Builder(T:=1,Text:='id=5|n=X5', 									_Step:=Steps_PompageA[5]); 
Builder(T:=1,Text:='id=6|n=X6', 									_Step:=Steps_PompageA[6]); 
Builder(T:=1,Text:='id=7|n=X7', 									_Step:=Steps_PompageA[7]); 
Builder(T:=1,Text:='id=8|n=X8',									_Step:=Steps_PompageA[8]); 
Builder(T:=1,Text:='id=9|n=X9|f=1', 								_Step:=Steps_PompageA[9]); 
Builder(T:=1,Text:='id=10|n=X10', 									_Step:=Steps_PompageA[10]); 
Builder(T:=1,Text:='id=11|n=X11', 									_Step:=Steps_PompageA[11]); 
Builder(T:=1,Text:='id=12|n=X12', 									_Step:=Steps_PompageA[12]); 
Builder(T:=1,Text:='id=13|n=X13', 									_Step:=Steps_PompageA[13]); 

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=TRUE', 								_Trans:=Trans_PompageA[0]); 
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=PIRANI', 							_Trans:=Trans_PompageA[1]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP2)*1000.0), 	_Trans:=Trans_PompageA[1]); 
Builder(T:=2,Text:='id=2|s=1|d=10|c=!PIRANI', 							_Trans:=Trans_PompageA[2]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[2]);
Builder(T:=2,Text:='id=3|s=2|d=3|c=PIRANI', 							_Trans:=Trans_PompageA[3]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP4)*1000.0), 	_Trans:=Trans_PompageA[3]);
Builder(T:=2,Text:='id=4|s=2|d=10|c=!PIRANI', 							_Trans:=Trans_PompageA[4]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[4]);
Builder(T:=2,Text:='id=5|s=3|d=4|c=AP', 								_Trans:=Trans_PompageA[5]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[5]);
Builder(T:=2,Text:='id=6|s=3|d=5|c=!AP', 								_Trans:=Trans_PompageA[6]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[6]);
Builder(T:=2,Text:='id=7|s=4|d=5|c=PIRANI', 							_Trans:=Trans_PompageA[7]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[7]);
Builder(T:=2,Text:='id=8|s=4|d=11|c=!PIRANI', 							_Trans:=Trans_PompageA[8]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[8]);
Builder(T:=2,Text:='id=9|s=5|d=6|c=TRUE', 								_Trans:=Trans_PompageA[9]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[9]);
Builder(T:=2,Text:='id=10|s=6|d=7|c=PT1&gt;=SPPE6', 							_Trans:=Trans_PompageA[10]);
Builder(T:=2,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP6)*1000.0), 	_Trans:=Trans_PompageA[10]);
Builder(T:=2,Text:='id=11|s=6|d=12|c=PT1&lt;SPPE6', 							_Trans:=Trans_PompageA[11]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[11]);
Builder(T:=2,Text:='id=12|s=7|d=8|c=PT1&lt;=SPPE5', 							_Trans:=Trans_PompageA[12]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[12]);
Builder(T:=2,Text:='id=13|s=7|d=13|c=PT1&gt;SPPE5', 							_Trans:=Trans_PompageA[13]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[13]);
Builder(T:=2,Text:='id=14|s=8|d=9|c=NB==', 								_Trans:=Trans_PompageA[14]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[14]);
Builder(T:=2,Text:='id=15|s=8|d=6|c=NB!=', 								_Trans:=Trans_PompageA[15]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[15]);
Builder(T:=2,Text:='id=16|s=9|d=0|c=TRUE', 								_Trans:=Trans_PompageA[16]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[16]);
Builder(T:=2,Text:='id=17|s=10|d=0|c=IHM', 								_Trans:=Trans_PompageA[17]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[17]);
Builder(T:=2,Text:='id=18|s=11|d=0|c=IHM', 								_Trans:=Trans_PompageA[18]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[18]);
Builder(T:=2,Text:='id=19|s=12|d=5|c=IHM', 								_Trans:=Trans_PompageA[19]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[19]);
Builder(T:=2,Text:='id=20|s=13|d=0|c=IHM', 								_Trans:=Trans_PompageA[20]);
Builder(T:=2,d:=t#0s, 										_Trans:=Trans_PompageA[20]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FTTOV4|k=4|s=1', 							_Act:=Acts_PompageA[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP1)*1000.0), 	_Act:=Acts_PompageA[0]);
Builder(T:=3,Text:='id=1|n=OPPE|k=11|s=1', 								_Act:=Acts_PompageA[1]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP1)*1000.0), 	_Act:=Acts_PompageA[1]);
Builder(T:=3,Text:='id=2|n=OV9|k=4|s=2', 								_Act:=Acts_PompageA[2]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP3)*1000.0), 	_Act:=Acts_PompageA[2]);
Builder(T:=3,Text:='id=3|n=FPPE|k=0|s=3', 								_Act:=Acts_PompageA[3]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[3]);
Builder(T:=3,Text:='id=4|n=NB=0|k=1|s=5', 								_Act:=Acts_PompageA[4]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[4]);
Builder(T:=3,Text:='id=5|n=NB=FV9OV4NB++|k=1|s=6', 							_Act:=Acts_PompageA[5]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[5]);
Builder(T:=3,Text:='id=6|n=OV2|k=4|s=6', 								_Act:=Acts_PompageA[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP6)*1000.0), 	_Act:=Acts_PompageA[6]);
Builder(T:=3,Text:='id=7|n=FV2|k=4|s=7', 								_Act:=Acts_PompageA[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP8)*1000.0), 	_Act:=Acts_PompageA[7]);
Builder(T:=3,Text:='id=8|n=OV9|k=11|s=7', 								_Act:=Acts_PompageA[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP9 + config_utilisee.pompage[index_pompage_A].DLP10)*1000.0), 	_Act:=Acts_PompageA[8]);
Builder(T:=3,Text:='id=9|n=FV9|k=4|s=8', 								_Act:=Acts_PompageA[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP11)*1000.0), 	_Act:=Acts_PompageA[9]);
Builder(T:=3,Text:='id=10|n=FV2V9PPE|k=1|s=9', 							_Act:=Acts_PompageA[10]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[10]);
Builder(T:=3,Text:='id=11|n=FTT|k=1|s=10', 								_Act:=Acts_PompageA[11]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[11]);
Builder(T:=3,Text:='id=12|n=FV9|k=4|s=11', 								_Act:=Acts_PompageA[12]);
Builder(T:=3,d:=t#1s, 										_Act:=Acts_PompageA[12]);
Builder(T:=3,Text:='id=13|n=OV2|k=0|s=11', 								_Act:=Acts_PompageA[13]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[13]);
Builder(T:=3,Text:='id=14|n=FTT|k=1|s=12', 								_Act:=Acts_PompageA[14]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[14]);
Builder(T:=3,Text:='id=15|n=FTT|k=1|s=13', 								_Act:=Acts_PompageA[15]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PompageA[15]);

Ctrl_PompageA.Cmd.ForceStepFromId := -1;
Ctrl_PompageA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_PompageA[0].EnableCond :=  TRUE;
Acts_PompageA[1].EnableCond :=  Acts_PompageA[0].Started AND Acts_PompageA[0].Finished;
Acts_PompageA[2].EnableCond :=  TRUE;
Acts_PompageA[3].EnableCond :=  TRUE;
Acts_PompageA[4].EnableCond :=  TRUE;
Acts_PompageA[5].EnableCond :=  TRUE;
Acts_PompageA[6].EnableCond :=  TRUE;
Acts_PompageA[7].EnableCond :=  TRUE;
Acts_PompageA[8].EnableCond :=  Acts_PompageA[7].Started AND Acts_PompageA[7].Finished;
Acts_PompageA[9].EnableCond :=  TRUE;
Acts_PompageA[10].EnableCond := TRUE;
Acts_PompageA[11].EnableCond := TRUE;
Acts_PompageA[12].EnableCond := TRUE;
Acts_PompageA[13].EnableCond := Acts_PompageA[12].Started AND Acts_PompageA[12].Finished;
Acts_PompageA[14].EnableCond := TRUE;
Acts_PompageA[15].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_PompageA[0].Condition  :=  TRUE;
Trans_PompageA[1].Condition  :=  Acts_PompageA[1].Started AND Acts_PompageA[1].Finished AND armoires[0].entrees.pirani;
Trans_PompageA[2].Condition  :=  Acts_PompageA[1].Started AND Acts_PompageA[1].Finished AND NOT(armoires[0].entrees.pirani);
Trans_PompageA[3].Condition  :=  Acts_PompageA[2].Started AND Acts_PompageA[2].Finished AND armoires[0].entrees.pirani;
Trans_PompageA[4].Condition  :=  Acts_PompageA[2].Started AND Acts_PompageA[2].Finished AND NOT(armoires[0].entrees.pirani);
Trans_PompageA[5].Condition  :=  armoires[0].en_cours_de_chgt_apres;
Trans_PompageA[6].Condition  :=  NOT(armoires[0].en_cours_de_chgt_apres);
Trans_PompageA[7].Condition  :=  Steps_PompageA[4].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP5)*1000.0) AND armoires[0].entrees.pirani;
Trans_PompageA[8].Condition  :=  Steps_PompageA[4].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.pompage[index_pompage_A].DLP5)*1000.0) AND NOT(armoires[0].entrees.pirani);
Trans_PompageA[9].Condition  :=  TRUE;
Trans_PompageA[10].Condition  := Acts_PompageA[6].Started AND Acts_PompageA[6].Finished AND armoires[0].ana.PT1.Mes &gt;= INT_TO_REAL(config_utilisee.pompage[index_purge_A].SPPE6);
Trans_PompageA[11].Condition  := Acts_PompageA[6].Started AND Acts_PompageA[6].Finished AND armoires[0].ana.PT1.Mes &lt; INT_TO_REAL(config_utilisee.pompage[index_purge_A].SPPE6);
Trans_PompageA[12].Condition  := Acts_PompageA[8].Started AND Acts_PompageA[8].Finished AND armoires[0].ana.PT1.Mes &lt;= INT_TO_REAL(config_utilisee.pompage[index_purge_A].SPPE5) AND armoires[0].entrees.pirani;
Trans_PompageA[13].Condition  := Acts_PompageA[8].Started AND Acts_PompageA[8].Finished AND NOT(armoires[0].ana.PT1.Mes &lt;= INT_TO_REAL(config_utilisee.pompage[index_purge_A].SPPE5) AND armoires[0].entrees.pirani);
Trans_PompageA[14].Condition  := Acts_PompageA[9].Started AND Acts_PompageA[9].Finished AND armoires[0].compteur_cycle_pompage &gt;= config_utilisee.pompage[index_pompage_A].NBPPE;
Trans_PompageA[15].Condition  := Acts_PompageA[9].Started AND Acts_PompageA[9].Finished AND armoires[0].compteur_cycle_pompage &lt; config_utilisee.pompage[index_pompage_A].NBPPE;
Trans_PompageA[16].Condition  := TRUE;
Trans_PompageA[17].Condition  := chgt_valider[0];
Trans_PompageA[18].Condition  := chgt_valider[0];
Trans_PompageA[19].Condition  := chgt_valider[0];
Trans_PompageA[20].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_PompageA.Cmd.ModeReq = 0 THEN Ctrl_PompageA.Cmd.ModeReq := 2; END_IF;
Ctrl_PompageA.Cmd.Enable := TRUE and not(armoires[0].manu) and not(modification_majeure);

Gc_PompageA(
    Enable := Ctrl_PompageA.Cmd.Enable,
    ModeReq := Ctrl_PompageA.Cmd.ModeReq,
    FreezeReq := Ctrl_PompageA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_PompageA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_PompageA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_PompageA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_PompageA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_PompageA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_PompageA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_PompageA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_PompageA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_PompageA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_PompageA,
    Transitions := Trans_PompageA,
    Actions := Acts_PompageA
);

(* Retour statut *)
Ctrl_PompageA.Stat.Cycle := Gc_PompageA.Runtime.Cycle;
Ctrl_PompageA.Stat.Phase := Gc_PompageA.Runtime.Phase;
Ctrl_PompageA.Stat.Mode := Gc_PompageA.Runtime.Mode;
Ctrl_PompageA.Stat.ActiveStepCount := Gc_PompageA.Debug.ActiveStepCount;
Ctrl_PompageA.Stat.LastTransitionFiredId := Gc_PompageA.Debug.LastTransitionFiredId;
Ctrl_PompageA.Stat.ConfigFault := Gc_PompageA.Debug.ConfigFault;
Ctrl_PompageA.Stat.WatchdogDetected := Gc_PompageA.Debug.WatchdogDetected;
Ctrl_PompageA.Stat.NoActiveStepFault := Gc_PompageA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_PompageA.Cmd.StepReq := FALSE;
Ctrl_PompageA.Cmd.InitReq := FALSE;
Ctrl_PompageA.Cmd.ResetInitialReq := FALSE;
Ctrl_PompageA.Cmd.ResetAllReq := FALSE;
Ctrl_PompageA.Cmd.ForceBackReq := FALSE;
Ctrl_PompageA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_PurgeA" type="section" SectionOrder="8"></identProgram>
			<STSource>Gc_PurgeA.Runtime.GC_MAX_STEPS := 28;
Gc_PurgeA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_PurgeA.Runtime.GC_MAX_ACTIONS := 28;
Gc_PurgeA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_PurgeA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_PurgeA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_PurgeA[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_PurgeA[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_PurgeA[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_PurgeA[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_PurgeA[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_PurgeA[5]); 
Builder(T:=1,Text:='id=6|n=X6', 						_Step:=Steps_PurgeA[6]); 
Builder(T:=1,Text:='id=7|n=X7', 						_Step:=Steps_PurgeA[7]); 
Builder(T:=1,Text:='id=8|n=X8|f=1',						_Step:=Steps_PurgeA[8]); 
Builder(T:=1,Text:='id=9|n=X9', 						_Step:=Steps_PurgeA[9]); 
Builder(T:=1,Text:='id=10|n=X10', 						_Step:=Steps_PurgeA[10]); 

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=2|c=N2', 							_Trans:=Trans_PurgeA[0]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[0]);
Builder(T:=2,Text:='id=1|s=0|d=1|c=!N2', 							_Trans:=Trans_PurgeA[1]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[1]); 
Builder(T:=2,Text:='id=2|s=1|d=2|c=N2+IHM', 						_Trans:=Trans_PurgeA[2]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[2]);
Builder(T:=2,Text:='id=3|s=2|d=3|c=PT1&lt;=SPUR4', 						_Trans:=Trans_PurgeA[3]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[3]);
Builder(T:=2,Text:='id=4|s=2|d=10|c=PT1&gt;SPUR4', 						_Trans:=Trans_PurgeA[4]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[4]);
Builder(T:=2,Text:='id=5|s=3|d=4|c=PT1&lt;=SPUR5', 						_Trans:=Trans_PurgeA[5]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[5]);
Builder(T:=2,Text:='id=6|s=3|d=10|c=PT1&gt;SPUR5', 						_Trans:=Trans_PurgeA[6]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[6]);
Builder(T:=2,Text:='id=7|s=4|d=5|c=TRUE', 							_Trans:=Trans_PurgeA[7]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[7]);
Builder(T:=2,Text:='id=8|s=5|d=6|c=PT1&lt;=SPUR6', 						_Trans:=Trans_PurgeA[8]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[8]);
Builder(T:=2,Text:='id=9|s=5|d=9|c=PT1&gt;SPUR6', 						_Trans:=Trans_PurgeA[9]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[9]);
Builder(T:=2,Text:='id=10|s=6|d=7|c=PT1&lt;=SPUR5', 						_Trans:=Trans_PurgeA[10]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[10]);
Builder(T:=2,Text:='id=11|s=6|d=10|c=PT1&gt;SPUR5', 						_Trans:=Trans_PurgeA[11]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[11]);
Builder(T:=2,Text:='id=12|s=7|d=8|c=NB==NBSURP', 						_Trans:=Trans_PurgeA[12]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[12]);
Builder(T:=2,Text:='id=13|s=7|d=5|c=NB!=NBSURP', 						_Trans:=Trans_PurgeA[13]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[13]);
Builder(T:=2,Text:='id=14|s=8|d=0|c=TRUE', 							_Trans:=Trans_PurgeA[14]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[14]);
Builder(T:=2,Text:='id=15|s=9|d=0|c=IHM', 							_Trans:=Trans_PurgeA[15]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[15]);
Builder(T:=2,Text:='id=16|s=10|d=0|c=IHM', 							_Trans:=Trans_PurgeA[16]);
Builder(T:=2,d:=t#0s, 									_Trans:=Trans_PurgeA[16]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=OV7|k=4|s=2', 								_Act:=Acts_PurgeA[0]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL4)*1000.0), 	_Act:=Acts_PurgeA[0]);
Builder(T:=3,Text:='id=1|n=OV3V4|k=11|s=2', 							_Act:=Acts_PurgeA[1]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL5)*1000.0), 	_Act:=Acts_PurgeA[1]);
Builder(T:=3,Text:='id=2|n=FV3|k=4|s=4', 								_Act:=Acts_PurgeA[2]);
Builder(T:=3,d:=t#5s, 										_Act:=Acts_PurgeA[2]);
Builder(T:=3,Text:='id=3|n=OV2|k=4|s=5', 								_Act:=Acts_PurgeA[3]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL7)*1000.0),		_Act:=Acts_PurgeA[3]);
Builder(T:=3,Text:='id=4|n=NB++|k=1|s=5', 								_Act:=Acts_PurgeA[4]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeA[4]);
Builder(T:=3,Text:='id=5|n=ATT|k=4|s=6', 								_Act:=Acts_PurgeA[5]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL8)*1000.0),		_Act:=Acts_PurgeA[5]);
Builder(T:=3,Text:='id=6|n=FV2|k=11|s=6', 								_Act:=Acts_PurgeA[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL9)*1000.0),		_Act:=Acts_PurgeA[6]);
Builder(T:=3,Text:='id=7|n=OV3|k=11|s=6', 								_Act:=Acts_PurgeA[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL10)*1000.0),	_Act:=Acts_PurgeA[7]);
Builder(T:=3,Text:='id=8|n=ATT|k=4|s=7', 								_Act:=Acts_PurgeA[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL11)*1000.0),	_Act:=Acts_PurgeA[8]);
Builder(T:=3,Text:='id=9|n=FV3|k=11|s=7', 								_Act:=Acts_PurgeA[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL12)*1000.0),	_Act:=Acts_PurgeA[9]);
Builder(T:=3,Text:='id=10|n=FV7|k=0|s=8', 								_Act:=Acts_PurgeA[10]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeA[10]);
Builder(T:=3,Text:='id=11|n=FTT|k=0|s=9', 								_Act:=Acts_PurgeA[11]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeA[11]);
Builder(T:=3,Text:='id=12|n=FTT|k=0|s=10', 								_Act:=Acts_PurgeA[12]);
Builder(T:=3,d:=t#0s, 										_Act:=Acts_PurgeA[12]);

Ctrl_PurgeA.Cmd.ForceStepFromId := -1;
Ctrl_PurgeA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_PurgeA[0].EnableCond := TRUE;
Acts_PurgeA[1].EnableCond := Acts_PurgeA[0].Started AND Acts_PurgeA[0].Finished;
Acts_PurgeA[2].EnableCond := TRUE;
Acts_PurgeA[3].EnableCond := TRUE;
Acts_PurgeA[4].EnableCond := TRUE;
Acts_PurgeA[5].EnableCond := TRUE;
Acts_PurgeA[6].EnableCond := Acts_PurgeA[5].Started AND Acts_PurgeA[5].Finished;
Acts_PurgeA[7].EnableCond := Acts_PurgeA[6].Started AND Acts_PurgeA[6].Finished;
Acts_PurgeA[8].EnableCond := TRUE;
Acts_PurgeA[9].EnableCond := Acts_PurgeA[8].Started AND Acts_PurgeA[8].Finished;
Acts_PurgeA[10].EnableCond := TRUE;
Acts_PurgeA[11].EnableCond := TRUE;
Acts_PurgeA[12].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_PurgeA[0].Condition  := armoires[0].entrees.span_N2;
Trans_PurgeA[1].Condition  := NOT(armoires[0].entrees.span_N2);
Trans_PurgeA[2].Condition  := armoires[0].entrees.span_N2 and chgt_valider[0];
Trans_PurgeA[3].Condition  := Acts_PurgeA[1].Started AND Acts_PurgeA[1].Finished AND armoires[0].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR4);
Trans_PurgeA[4].Condition  := Acts_PurgeA[1].Started AND Acts_PurgeA[1].Finished AND armoires[0].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR4);
Trans_PurgeA[5].Condition  := Steps_PurgeA[3].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL6)*1000.0) AND armoires[0].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR5);
Trans_PurgeA[6].Condition  := Steps_PurgeA[3].ActiveTime &gt;= REAL_TO_TIME(INT_TO_REAL(config_utilisee.purge[index_purge_A].DL6)*1000.0) AND armoires[0].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR5);
Trans_PurgeA[7].Condition  := Steps_PurgeA[4].ActiveTime &gt;= t#5s;
Trans_PurgeA[8].Condition  := Acts_PurgeA[3].Started AND Acts_PurgeA[3].Finished AND armoires[0].ana.PT1.mes &gt;= INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR6);
Trans_PurgeA[9].Condition  := Acts_PurgeA[3].Started AND Acts_PurgeA[3].Finished AND armoires[0].ana.PT1.mes &lt; INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR6);
Trans_PurgeA[10].Condition  := Acts_PurgeA[7].Started AND Acts_PurgeA[7].Finished AND armoires[0].ana.PT1.mes &lt;= INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR5);
Trans_PurgeA[11].Condition  := Acts_PurgeA[7].Started AND Acts_PurgeA[7].Finished AND armoires[0].ana.PT1.mes &gt; INT_TO_REAL(config_utilisee.purge[index_purge_A].SPUR5);
Trans_PurgeA[12].Condition  := Acts_PurgeA[9].Started AND Acts_PurgeA[9].Finished AND armoires[0].compteur_cycle_purge &gt;= config_utilisee.purge[index_purge_A].NBPUR;
Trans_PurgeA[13].Condition  := Acts_PurgeA[9].Started AND Acts_PurgeA[9].Finished AND armoires[0].compteur_cycle_purge &lt; config_utilisee.purge[index_purge_A].NBPUR;
Trans_PurgeA[14].Condition  := TRUE;
Trans_PurgeA[15].Condition  := chgt_valider[0];
Trans_PurgeA[16].Condition  := chgt_valider[0];

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_PurgeA.Cmd.ModeReq = 0 THEN Ctrl_PurgeA.Cmd.ModeReq := 2; END_IF;
Ctrl_PurgeA.Cmd.Enable := TRUE and not(armoires[0].manu) and not(modification_majeure);

Gc_PurgeA(
    Enable := Ctrl_PurgeA.Cmd.Enable,
    ModeReq := Ctrl_PurgeA.Cmd.ModeReq,
    FreezeReq := Ctrl_PurgeA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_PurgeA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_PurgeA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_PurgeA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_PurgeA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_PurgeA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_PurgeA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_PurgeA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_PurgeA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_PurgeA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_PurgeA,
    Transitions := Trans_PurgeA,
    Actions := Acts_PurgeA
);

(* Retour statut *)
Ctrl_PurgeA.Stat.Cycle := Gc_PurgeA.Runtime.Cycle;
Ctrl_PurgeA.Stat.Phase := Gc_PurgeA.Runtime.Phase;
Ctrl_PurgeA.Stat.Mode := Gc_PurgeA.Runtime.Mode;
Ctrl_PurgeA.Stat.ActiveStepCount := Gc_PurgeA.Debug.ActiveStepCount;
Ctrl_PurgeA.Stat.LastTransitionFiredId := Gc_PurgeA.Debug.LastTransitionFiredId;
Ctrl_PurgeA.Stat.ConfigFault := Gc_PurgeA.Debug.ConfigFault;
Ctrl_PurgeA.Stat.WatchdogDetected := Gc_PurgeA.Debug.WatchdogDetected;
Ctrl_PurgeA.Stat.NoActiveStepFault := Gc_PurgeA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_PurgeA.Cmd.StepReq := FALSE;
Ctrl_PurgeA.Cmd.InitReq := FALSE;
Ctrl_PurgeA.Cmd.ResetInitialReq := FALSE;
Ctrl_PurgeA.Cmd.ResetAllReq := FALSE;
Ctrl_PurgeA.Cmd.ForceBackReq := FALSE;
Ctrl_PurgeA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_HeliumAVA" type="section" SectionOrder="9"></identProgram>
			<STSource>Gc_HeliumAVA.Runtime.GC_MAX_STEPS := 28;
Gc_HeliumAVA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_HeliumAVA.Runtime.GC_MAX_ACTIONS := 28;
Gc_HeliumAVA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_HeliumAVA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_HeliumAVA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_HeliumAVA[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_HeliumAVA[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_HeliumAVA[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_HeliumAVA[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_HeliumAVA[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_HeliumAVA[5]);
Builder(T:=1,Text:='id=6|n=X6|f=1', 					_Step:=Steps_HeliumAVA[6]);

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=TRUE', 					_Trans:=Trans_HeliumAVA[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=IHM', 					_Trans:=Trans_HeliumAVA[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[1]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=IHM', 					_Trans:=Trans_HeliumAVA[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=FPURGE', 				_Trans:=Trans_HeliumAVA[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[3]); 
Builder(T:=2,Text:='id=4|s=4|d=5|c=FPOMPAGE', 				_Trans:=Trans_HeliumAVA[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[4]);
Builder(T:=2,Text:='id=5|s=5|d=6|c=IHM', 					_Trans:=Trans_HeliumAVA[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[5]);
Builder(T:=2,Text:='id=6|s=6|d=0|c=TRUE', 					_Trans:=Trans_HeliumAVA[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAVA[6]);  

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=FTTOV4VHE|k=0|s=1', 				_Act:=Acts_HeliumAVA[0]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[0]);
Builder(T:=3,Text:='id=1|n=FTT|k=0|s=2', 					_Act:=Acts_HeliumAVA[1]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[1]);
Builder(T:=3,Text:='id=2|n=IPURGE|k=1|s=3', 				_Act:=Acts_HeliumAVA[2]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[2]);
Builder(T:=3,Text:='id=3|n=RPURGE|k=5|s=3', 				_Act:=Acts_HeliumAVA[3]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[3]);
Builder(T:=3,Text:='id=4|n=IPOMPAGE|k=1|s=4', 				_Act:=Acts_HeliumAVA[4]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[4]);
Builder(T:=3,Text:='id=5|n=RPOMPAGE|k=5|s=4', 				_Act:=Acts_HeliumAVA[5]); 
Builder(T:=3,d:=t#0s, 							_Act:=Acts_HeliumAVA[5]);

Ctrl_HeliumAVA.Cmd.ForceStepFromId := -1;
Ctrl_HeliumAVA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_HeliumAVA[0].EnableCond := TRUE;
Acts_HeliumAVA[1].EnableCond := TRUE;
Acts_HeliumAVA[2].EnableCond := TRUE;
Acts_HeliumAVA[3].EnableCond := TRUE;
Acts_HeliumAVA[4].EnableCond := TRUE;
Acts_HeliumAVA[5].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_HeliumAVA[0].Condition  := TRUE;
Trans_HeliumAVA[1].Condition  := chgt_valider[0];
Trans_HeliumAVA[2].Condition  := chgt_valider[0];
Trans_HeliumAVA[3].Condition  := Steps_HeliumAVA[3].ActiveTime &gt;= t#1s AND Gc_PurgeA.Finished;
Trans_HeliumAVA[4].Condition  := Steps_HeliumAVA[4].ActiveTime &gt;= t#1s AND Gc_PompageA.Finished;
Trans_HeliumAVA[5].Condition  := chgt_valider[0];
Trans_HeliumAVA[6].Condition  := TRUE;

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_HeliumAVA.Cmd.ModeReq = 0 THEN Ctrl_HeliumAVA.Cmd.ModeReq := 2; END_IF;
Ctrl_HeliumAVA.Cmd.Enable := TRUE and not(armoires[0].manu) and not(modification_majeure);

Gc_HeliumAVA(
    Enable := Ctrl_HeliumAVA.Cmd.Enable,
    ModeReq := Ctrl_HeliumAVA.Cmd.ModeReq,
    FreezeReq := Ctrl_HeliumAVA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_HeliumAVA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_HeliumAVA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_HeliumAVA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_HeliumAVA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_HeliumAVA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_HeliumAVA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_HeliumAVA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_HeliumAVA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_HeliumAVA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_HeliumAVA,
    Transitions := Trans_HeliumAVA,
    Actions := Acts_HeliumAVA
);

(* Retour statut *)
Ctrl_HeliumAVA.Stat.Cycle := Gc_HeliumAVA.Runtime.Cycle;
Ctrl_HeliumAVA.Stat.Phase := Gc_HeliumAVA.Runtime.Phase;
Ctrl_HeliumAVA.Stat.Mode := Gc_HeliumAVA.Runtime.Mode;
Ctrl_HeliumAVA.Stat.ActiveStepCount := Gc_HeliumAVA.Debug.ActiveStepCount;
Ctrl_HeliumAVA.Stat.LastTransitionFiredId := Gc_HeliumAVA.Debug.LastTransitionFiredId;
Ctrl_HeliumAVA.Stat.ConfigFault := Gc_HeliumAVA.Debug.ConfigFault;
Ctrl_HeliumAVA.Stat.WatchdogDetected := Gc_HeliumAVA.Debug.WatchdogDetected;
Ctrl_HeliumAVA.Stat.NoActiveStepFault := Gc_HeliumAVA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_HeliumAVA.Cmd.StepReq := FALSE;
Ctrl_HeliumAVA.Cmd.InitReq := FALSE;
Ctrl_HeliumAVA.Cmd.ResetInitialReq := FALSE;
Ctrl_HeliumAVA.Cmd.ResetAllReq := FALSE;
Ctrl_HeliumAVA.Cmd.ForceBackReq := FALSE;
Ctrl_HeliumAVA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_Helium_APA" type="section" SectionOrder="10"></identProgram>
			<STSource>Gc_HeliumAPA.Runtime.GC_MAX_STEPS := 28;
Gc_HeliumAPA.Runtime.GC_MAX_TRANSITIONS := 28;
Gc_HeliumAPA.Runtime.GC_MAX_ACTIONS := 28;
Gc_HeliumAPA.Runtime.GC_MAX_SRC_PER_TRANS := 3;
Gc_HeliumAPA.Runtime.GC_MAX_DST_PER_TRANS := 3;
Gc_HeliumAPA.Runtime.GC_MAX_HIST := 8;

(* =========================
STEPS
========================= *)

Builder(T:=1,Text:='id=0|n=X0|i=1', 					_Step:=Steps_HeliumAPA[0]);
Builder(T:=1,Text:='id=1|n=X1', 						_Step:=Steps_HeliumAPA[1]); 
Builder(T:=1,Text:='id=2|n=X2', 						_Step:=Steps_HeliumAPA[2]); 
Builder(T:=1,Text:='id=3|n=X3', 						_Step:=Steps_HeliumAPA[3]); 
Builder(T:=1,Text:='id=4|n=X4', 						_Step:=Steps_HeliumAPA[4]); 
Builder(T:=1,Text:='id=5|n=X5', 						_Step:=Steps_HeliumAPA[5]);
Builder(T:=1,Text:='id=6|n=X6', 						_Step:=Steps_HeliumAPA[6]); 
Builder(T:=1,Text:='id=7|n=X7', 						_Step:=Steps_HeliumAPA[7]); 
Builder(T:=1,Text:='id=8|n=X8', 						_Step:=Steps_HeliumAPA[8]); 
Builder(T:=1,Text:='id=9|n=X9', 						_Step:=Steps_HeliumAPA[9]); 
Builder(T:=1,Text:='id=10|n=X10', 						_Step:=Steps_HeliumAPA[10]);
Builder(T:=1,Text:='id=11|n=X11', 						_Step:=Steps_HeliumAPA[11]);
Builder(T:=1,Text:='id=12|n=X12', 						_Step:=Steps_HeliumAPA[12]);
Builder(T:=1,Text:='id=13|n=X13|f=1', 					_Step:=Steps_HeliumAPA[13]);

(* =========================
TRANSITIONS CHGT
========================= *)

Builder(T:=2,Text:='id=0|s=0|d=1|c=IHM', 					_Trans:=Trans_HeliumAPA[0]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[0]);
Builder(T:=2,Text:='id=1|s=1|d=2|c=FPURGE', 				_Trans:=Trans_HeliumAPA[1]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[1]);
Builder(T:=2,Text:='id=2|s=2|d=3|c=FPOMPAGE', 				_Trans:=Trans_HeliumAPA[2]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[2]);
Builder(T:=2,Text:='id=3|s=3|d=4|c=IHM', 					_Trans:=Trans_HeliumAPA[3]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[3]); 
Builder(T:=2,Text:='id=4|s=4|d=5|c=IHM', 					_Trans:=Trans_HeliumAPA[4]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[4]);
Builder(T:=2,Text:='id=5|s=5|d=6|c=TRUE', 					_Trans:=Trans_HeliumAPA[5]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[5]);
Builder(T:=2,Text:='id=6|s=6|d=7|c=IHM', 					_Trans:=Trans_HeliumAPA[6]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[6]); 
Builder(T:=2,Text:='id=7|s=6|d=5|c=!IHM', 					_Trans:=Trans_HeliumAPA[7]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[7]);
Builder(T:=2,Text:='id=8|s=7|d=8|c=!IHM', 					_Trans:=Trans_HeliumAPA[8]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[8]);
Builder(T:=2,Text:='id=9|s=7|d=4|c=IHM', 					_Trans:=Trans_HeliumAPA[9]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[9]);
Builder(T:=2,Text:='id=10|s=8|d=11|c=!IHM', 				_Trans:=Trans_HeliumAPA[10]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[10]);
Builder(T:=2,Text:='id=11|s=8|d=9|c=IHM', 					_Trans:=Trans_HeliumAPA[11]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[11]);
Builder(T:=2,Text:='id=12|s=9|d=10|c=FPURGE', 				_Trans:=Trans_HeliumAPA[12]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[12]);
Builder(T:=2,Text:='id=13|s=10|d=11|c=FPOMPAGE', 				_Trans:=Trans_HeliumAPA[13]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[13]);
Builder(T:=2,Text:='id=14|s=11|d=12|c=IHM', 				_Trans:=Trans_HeliumAPA[14]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[14]);
Builder(T:=2,Text:='id=15|s=12|d=13|c=IHM', 				_Trans:=Trans_HeliumAPA[15]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[15]);
Builder(T:=2,Text:='id=16|s=13|d=0|c=TRUE', 				_Trans:=Trans_HeliumAPA[16]); 
Builder(T:=2,d:=t#0s, 							_Trans:=Trans_HeliumAPA[16]);

(* =========================
ACTIONS
========================= *)

Builder(T:=3,Text:='id=0|n=IPURGE|k=1|s=1', 						_Act:=Acts_HeliumAPA[0]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[0]);
Builder(T:=3,Text:='id=1|n=RPURGE|k=5|s=1', 						_Act:=Acts_HeliumAPA[1]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[1]);
Builder(T:=3,Text:='id=2|n=IPOMPAGE|k=1|s=2', 						_Act:=Acts_HeliumAPA[2]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[2]);
Builder(T:=3,Text:='id=3|n=RPOMPAGE|k=5|s=2', 						_Act:=Acts_HeliumAPA[3]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[3]);
Builder(T:=3,Text:='id=4|n=FV2V4|k=4|s=4', 							_Act:=Acts_HeliumAPA[4]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE1)*1000.0), 		_Act:=Acts_HeliumAPA[4]);
Builder(T:=3,Text:='id=5|n=FVHE|k=1|s=5', 							_Act:=Acts_HeliumAPA[5]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[5]);
Builder(T:=3,Text:='id=6|n=OV7|k=4|s=6', 							_Act:=Acts_HeliumAPA[6]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE2)*1000.0), 		_Act:=Acts_HeliumAPA[6]);
Builder(T:=3,Text:='id=7|n=OV3V4|k=11|s=6', 						_Act:=Acts_HeliumAPA[7]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE3)*1000.0), 		_Act:=Acts_HeliumAPA[7]);
Builder(T:=3,Text:='id=8|n=FV3V4|k=11|s=6', 						_Act:=Acts_HeliumAPA[8]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE4)*1000.0), 		_Act:=Acts_HeliumAPA[8]);
Builder(T:=3,Text:='id=9|n=FV7|k=11|s=6', 							_Act:=Acts_HeliumAPA[9]);
Builder(T:=3,d:=REAL_TO_TIME(INT_TO_REAL(config_utilisee.helium.DLHE5)*1000.0), 		_Act:=Acts_HeliumAPA[9]);
Builder(T:=3,Text:='id=10|n=OVHE|k=0|s=6', 							_Act:=Acts_HeliumAPA[10]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[10]);
Builder(T:=3,Text:='id=11|n=FVHE|k=1|s=7', 							_Act:=Acts_HeliumAPA[11]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[11]);
Builder(T:=3,Text:='id=12|n=IPURGE|k=1|s=9', 						_Act:=Acts_HeliumAPA[12]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[12]);
Builder(T:=3,Text:='id=13|n=RPURGE|k=5|s=9', 						_Act:=Acts_HeliumAPA[13]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[13]);
Builder(T:=3,Text:='id=14|n=IPOMPAGE|k=1|s=10', 						_Act:=Acts_HeliumAPA[14]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[14]);
Builder(T:=3,Text:='id=15|n=RPOMPAGE|k=5|s=10', 						_Act:=Acts_HeliumAPA[15]); 
Builder(T:=3,d:=t#0s, 									_Act:=Acts_HeliumAPA[15]);

Ctrl_HeliumAPA.Cmd.ForceStepFromId := -1;
Ctrl_HeliumAPA.Cmd.ForceStepToId := -1;

(* =========================================================
   CONDITIONS ACTIONS
   ========================================================= *)

Acts_HeliumAPA[0].EnableCond := TRUE;
Acts_HeliumAPA[1].EnableCond := TRUE;
Acts_HeliumAPA[2].EnableCond := TRUE;
Acts_HeliumAPA[3].EnableCond := TRUE;
Acts_HeliumAPA[4].EnableCond := TRUE;
Acts_HeliumAPA[5].EnableCond := armoires[0].sorties.VHE.F1;
Acts_HeliumAPA[6].EnableCond := TRUE;
Acts_HeliumAPA[7].EnableCond := Acts_HeliumAPA[6].Started AND Acts_HeliumAPA[6].Finished;
Acts_HeliumAPA[8].EnableCond := Acts_HeliumAPA[7].Started AND Acts_HeliumAPA[7].Finished;
Acts_HeliumAPA[9].EnableCond := Acts_HeliumAPA[8].Started AND Acts_HeliumAPA[8].Finished;
Acts_HeliumAPA[10].EnableCond := Acts_HeliumAPA[9].Started AND Acts_HeliumAPA[9].Finished;
Acts_HeliumAPA[11].EnableCond := TRUE;
Acts_HeliumAPA[12].EnableCond := TRUE;
Acts_HeliumAPA[13].EnableCond := TRUE;
Acts_HeliumAPA[14].EnableCond := TRUE;
Acts_HeliumAPA[15].EnableCond := TRUE;

(* =========================================================
   CONDITIONS TRANSITIONS
   ========================================================= *)

Trans_HeliumAPA[0].Condition  := chgt_valider[0];
Trans_HeliumAPA[1].Condition  := Steps_HeliumAPA[1].ActiveTime &gt;= t#1s AND Gc_PurgeA.Finished;
Trans_HeliumAPA[2].Condition  := Steps_HeliumAPA[2].ActiveTime &gt;= t#1s AND Gc_PompageA.Finished;
Trans_HeliumAPA[3].Condition  := chgt_valider[0];
Trans_HeliumAPA[4].Condition  := Acts_HeliumAPA[4].Started AND Acts_HeliumAPA[4].Finished AND chgt_valider[0];
Trans_HeliumAPA[5].Condition  := TRUE;
Trans_HeliumAPA[6].Condition  := Acts_HeliumAPA[9].Started AND Acts_HeliumAPA[9].Finished AND chgt_valider[0];
Trans_HeliumAPA[7].Condition  := Acts_HeliumAPA[9].Started AND Acts_HeliumAPA[9].Finished AND chgt_valider[1];
Trans_HeliumAPA[8].Condition  := chgt_valider[1];
Trans_HeliumAPA[9].Condition  := chgt_valider[0];
Trans_HeliumAPA[10].Condition  := chgt_valider[1];
Trans_HeliumAPA[11].Condition  := chgt_valider[0];
Trans_HeliumAPA[12].Condition  := Steps_HeliumAPA[9].ActiveTime &gt;= t#1s AND Gc_PurgeA.Finished;
Trans_HeliumAPA[13].Condition  := Steps_HeliumAPA[10].ActiveTime &gt;= t#1s AND Gc_PompageA.Finished;
Trans_HeliumAPA[14].Condition  := chgt_valider[0];
Trans_HeliumAPA[15].Condition  := chgt_valider[0];
Trans_HeliumAPA[16].Condition  := TRUE;

(* =========================================================
   EXECUTION MOTEUR
   ========================================================= *)

IF Ctrl_HeliumAPA.Cmd.ModeReq = 0 THEN Ctrl_HeliumAPA.Cmd.ModeReq := 2; END_IF;
Ctrl_HeliumAPA.Cmd.Enable := TRUE and not(armoires[0].manu) and not(modification_majeure);

Gc_HeliumAPA(
    Enable := Ctrl_HeliumAPA.Cmd.Enable,
    ModeReq := Ctrl_HeliumAPA.Cmd.ModeReq,
    FreezeReq := Ctrl_HeliumAPA.Cmd.FreezeReq OR FALSE,
    PauseReq := Ctrl_HeliumAPA.Cmd.PauseReq OR FALSE,
    StepReq := Ctrl_HeliumAPA.Cmd.StepReq OR FALSE,
    InitReq := Ctrl_HeliumAPA.Cmd.InitReq OR FALSE,
    ResetInitialReq := Ctrl_HeliumAPA.Cmd.ResetInitialReq OR FALSE,
    ResetAllReq := Ctrl_HeliumAPA.Cmd.ResetAllReq OR FALSE,
    ForceBackReq := Ctrl_HeliumAPA.Cmd.ForceBackReq OR FALSE,
    ForceNextReq := Ctrl_HeliumAPA.Cmd.ForceNextReq OR FALSE,
    ForceStepFromId := Ctrl_HeliumAPA.Cmd.ForceStepFromId,
    ForceStepToId := Ctrl_HeliumAPA.Cmd.ForceStepToId,
    TsNow := TsSys,
    NtpcNow := NtpcNow,
    Steps := Steps_HeliumAPA,
    Transitions := Trans_HeliumAPA,
    Actions := Acts_HeliumAPA
);

(* Retour statut *)
Ctrl_HeliumAPA.Stat.Cycle := Gc_HeliumAPA.Runtime.Cycle;
Ctrl_HeliumAPA.Stat.Phase := Gc_HeliumAPA.Runtime.Phase;
Ctrl_HeliumAPA.Stat.Mode := Gc_HeliumAPA.Runtime.Mode;
Ctrl_HeliumAPA.Stat.ActiveStepCount := Gc_HeliumAPA.Debug.ActiveStepCount;
Ctrl_HeliumAPA.Stat.LastTransitionFiredId := Gc_HeliumAPA.Debug.LastTransitionFiredId;
Ctrl_HeliumAPA.Stat.ConfigFault := Gc_HeliumAPA.Debug.ConfigFault;
Ctrl_HeliumAPA.Stat.WatchdogDetected := Gc_HeliumAPA.Debug.WatchdogDetected;
Ctrl_HeliumAPA.Stat.NoActiveStepFault := Gc_HeliumAPA.Debug.NoActiveStepFault;

(* Reset des commandes impulsionnelles après l'appel *)
Ctrl_HeliumAPA.Cmd.StepReq := FALSE;
Ctrl_HeliumAPA.Cmd.InitReq := FALSE;
Ctrl_HeliumAPA.Cmd.ResetInitialReq := FALSE;
Ctrl_HeliumAPA.Cmd.ResetAllReq := FALSE;
Ctrl_HeliumAPA.Cmd.ForceBackReq := FALSE;
Ctrl_HeliumAPA.Cmd.ForceNextReq := FALSE;
</STSource>
		</program>
		<program activationCondition="configuree" logicCondition="standard">
			<identProgram name="SFC_ChangementA_Actions" type="section" SectionOrder="11"></identProgram>
			<STSource>(* ____________________________________________________________________ *)
(* CHGTA_X0 *)


(* ____________________________________________________________________ *)
(* CHGTA_X1 *)

IF Acts_ChangementA[1].Out THEN
	Close(arm:=armoires[0]);
	
	Ctrl_DetoxalA.Cmd.ModeReq := 0;
	Ctrl_DetoxalA.Cmd.InitReq := TRUE;
	Ctrl_PurgeA.Cmd.ModeReq := 0;
	Ctrl_PurgeA.Cmd.InitReq := TRUE;
	Ctrl_PompageA.Cmd.ModeReq := 0;
	Ctrl_PompageA.Cmd.InitReq := TRUE;
	Ctrl_HeliumAVA.Cmd.ModeReq := 0;
	Ctrl_HeliumAVA.Cmd.InitReq := TRUE;
	Ctrl_HeliumAPA.Cmd.ModeReq := 0;
	Ctrl_HeliumAPA.Cmd.InitReq := TRUE;

	DEBUG_DETOXAL_0 := 0;
	DEBUG_PURGE_0 := 0;
	DEBUG_POMPAGE_0 := 0;
	DEBUG_HELIUM_0 := 0;
	DEBUG_CHGT := 0;
	DEBUG_DETOXAL_1 := 0;
	DEBUG_PURGE_1 := 0;
	DEBUG_POMPAGE_1 := 0;
	DEBUG_HELIUM_1 := 0;

	index_purge_A := 0;
	index_pompage_A := 0;

	armoires[0].bouteille_presque_vide := false;
	armoires[0].bouteille_vide := false;
	if not(modification_majeure) and not(armoires[0].retour_sur_chgt) and not(armoires[0].retour_sur_chgt_ap_decl) then
		armoires[0].en_cours_de_chgt := false;
		armoires[0].en_cours_de_chgt_avant := false;
		armoires[0].en_cours_de_chgt_apres := false;
	end_if;

END_IF;

(* ____________________________________________________________________ *)
(* CHGTA_X2 *)

IF Acts_ChangementA[2].Out THEN
	InitDone_DetoxalA := FALSE;

	Ctrl_DetoxalA.Cmd.ModeReq := 1;
	Ctrl_DetoxalA.Cmd.InitReq := TRUE;
	Ctrl_PurgeA.Cmd.ModeReq := 0;
	Ctrl_PurgeA.Cmd.InitReq := TRUE;
	Ctrl_PompageA.Cmd.ModeReq := 0;
	Ctrl_PompageA.Cmd.InitReq := TRUE;
	Ctrl_HeliumAVA.Cmd.ModeReq := 0;
	Ctrl_HeliumAVA.Cmd.InitReq := TRUE;
	Ctrl_HeliumAPA.Cmd.ModeReq := 0;
	Ctrl_HeliumAPA.Cmd.InitReq := TRUE;

