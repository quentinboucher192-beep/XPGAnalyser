	<programUnit name="Logigrammes_B">
		<inOutParameters>
			<variables name="armoires" typeName="ARRAY[0..1] OF armoire">
				<attribute name="EffectiveParameter" value="Armoires"></attribute>
			</variables>
			<variables name="config_utilisee" typeName="config_gaz">
				<attribute name="EffectiveParameter" value="ConfigGazUtilisee"></attribute>
			</variables>
			<variables name="generalites" typeName="config_armoire">
				<attribute name="EffectiveParameter" value="ConfigArmoireUtilisee"></attribute>
			</variables>
			<variables name="chgt_valider" typeName="ARRAY[0..1] OF EBOOL">
				<attribute name="EffectiveParameter" value="chgt_validerB"></attribute>
				<instanceElementDesc name="[0]">
					<comment>oui</comment>
				</instanceElementDesc>
				<instanceElementDesc name="[1]">
					<comment>non</comment>
				</instanceElementDesc>
			</variables>
			<variables name="NtpcNow" typeName="Display_NTPC">
				<attribute name="EffectiveParameter" value="NTPCInfos"></attribute>
			</variables>
			<variables name="TsSys" typeName="TIME">
				<attribute name="EffectiveParameter" value="TsSys"></attribute>
