	<FBSource nameOfFBType="DFB_GRAFCETENGINE" version="1.48" dateTime="dt#2026-07-02-14:58:38">
		<attribute name="TypeCodeCheckSumString" value="7D5B"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="0D61"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="Enable" typeName="BOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="ModeReq" typeName="INT">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="FreezeReq" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="PauseReq" typeName="BOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="StepReq" typeName="BOOL">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="InitReq" typeName="BOOL">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="ResetInitialReq" typeName="BOOL">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="ResetAllReq" typeName="BOOL">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="TsNow" typeName="TIME">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="NtpcNow" typeName="Display_NTPC">
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="ForceBackReq" typeName="BOOL">
				<attribute name="PositionPin" value="14"></attribute>
			</variables>
			<variables name="ForceNextReq" typeName="BOOL">
				<attribute name="PositionPin" value="15"></attribute>
			</variables>
			<variables name="ForceStepFromId" typeName="INT">
				<attribute name="PositionPin" value="16"></attribute>
			</variables>
			<variables name="ForceStepToId" typeName="INT">
				<attribute name="PositionPin" value="17"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Steps" typeName="ARRAY[0..27] OF ST_GC_Step">
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="Transitions" typeName="ARRAY[0..27] OF ST_GC_Transition">
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="Actions" typeName="ARRAY[0..27] OF ST_GC_Action">
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="Debug" typeName="ST_GC_Debug">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Finished" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="InternalInitDone" typeName="BOOL"></variables>
			<variables name="Runtime" typeName="ST_GC_Runtime"></variables>
			<variables name="ModeReqOut" typeName="INT"></variables>
			<variables name="NeedToResetPause" typeName="BOOL"></variables>
			<variables name="pauseToReevaluateCondition" typeName="BOOL"></variables>
			<variables name="howManyResets" typeName="INT"></variables>
			<variables name="i" typeName="INT"></variables>
			<variables name="j" typeName="INT"></variables>
			<variables name="k" typeName="INT"></variables>
			<variables name="srcId" typeName="INT"></variables>
			<variables name="dstId" typeName="INT"></variables>
			<variables name="allSrcActive" typeName="BOOL"></variables>
			<variables name="anySrcActive" typeName="BOOL"></variables>
			<variables name="sIdx" typeName="INT"></variables>
			<variables name="aIdx" typeName="INT"></variables>
			<variables name="tIdx" typeName="INT"></variables>
			<variables name="sid" typeName="INT"></variables>
			<variables name="isFromStep" typeName="BOOL"></variables>
			<variables name="doneBack" typeName="BOOL"></variables>
			<variables name="doneNext" typeName="BOOL"></variables>
			<variables name="isDest" typeName="BOOL"></variables>
			<variables name="focusStep" typeName="INT"></variables>
			<variables name="ConfigChecked" typeName="BOOL"></variables>
			<variables name="HistFill" typeName="INT"></variables>
			<variables name="activeStepQty" typeName="INT"></variables>
			<variables name="firstStepId" typeName="INT"></variables>
			<variables name="firstStepName" typeName="string[4]"></variables>
			<variables name="h" typeName="INT"></variables>
			<variables name="finalSrcOnValidatedTr" typeName="BOOL"></variables>
			<variables name="isInitState" typeName="BOOL"></variables>
			<variables name="PrevInitState" typeName="BOOL"></variables>
			<variables name="InitPulse" typeName="BOOL"></variables>
			<variables name="InitPulseCount" typeName="INT"></variables>
			<variables name="SectionsAuthorized" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="stepIdStr" typeName="STRING"></variables>
			<variables name="actionIdStr" typeName="STRING"></variables>
		</privateLocalVariables>
		<FBProgram name="Init">
			<STSource>SectionsAuthorized := TRUE;
ModeReqOut := ModeReq;

IF NOT Enable THEN

    (* reset complet des étapes *)
    FOR i := 0 TO Runtime.GC_MAX_STEPS - 1 DO
        Steps[i].Active := FALSE;
        Steps[i].PrevActive := FALSE;
        Steps[i].Rising := FALSE;
        Steps[i].Falling := FALSE;
        Steps[i].ActiveTime := T#0ms;
        Steps[i].InactiveTime := T#0ms;
    END_FOR;

    (* reset complet des transitions *)
    FOR i := 0 TO Runtime.GC_MAX_TRANSITIONS - 1 DO
        Transitions[i].Validated := FALSE;
        Transitions[i].SnapshotValid := FALSE;
        Transitions[i].TonStarted := FALSE;
        Transitions[i].TonElapsed := T#0ms;
        Transitions[i].TimedConditionValid := FALSE;
    END_FOR;

    (* reset complet des actions *)
    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS - 1 DO
        Actions[aIdx].Started := FALSE;
        Actions[aIdx].Finished := FALSE;
        Actions[aIdx].Out := FALSE;
        Actions[aIdx].PrevOut := FALSE;
        Actions[aIdx].OnPulseDone := FALSE;
        Actions[aIdx].OffPulseDone := FALSE;
        Actions[aIdx].EnableDone := FALSE;
        Actions[aIdx].EnablePulseDone := FALSE;
        Actions[aIdx].TonStarted := FALSE;
        Actions[aIdx].TonElapsed := T#0ms;
        Actions[aIdx].PrevEnableCond := FALSE;
    END_FOR;

    (* reset état global *)
    Finished := FALSE;
    InitPulse := FALSE;
    PrevInitState := FALSE;
    FinalSrcOnValidatedTr := FALSE;
    InternalInitDone := FALSE;   (* très important *)

    SectionsAuthorized := FALSE;
    RETURN;
END_IF;

IF NOT(pauseToReevaluateCondition) THEN

	(* Init auto 1er scan: active TOUTES les étapes initiales *)
	IF NOT InternalInitDone THEN
	    FOR i := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        Steps[i].Active := Steps[i].IsInitial;   (* toutes les initiales à TRUE *)
	        Steps[i].PrevActive := FALSE;
	        Steps[i].ActiveTime := T#0ms;
	        Steps[i].InactiveTime := T#0ms;
	    END_FOR;
	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
	        Actions[aIdx].Started := FALSE;
		Actions[aIdx].Finished := FALSE;
		Actions[aIdx].Out := FALSE;
	        Actions[aIdx].OnPulseDone := FALSE;
	        Actions[aIdx].OffPulseDone := FALSE;
		Actions[aIdx].EnableDone := FALSE;
	        Actions[aIdx].EnablePulseDone := FALSE;
		Actions[aIdx].TonStarted := FALSE;
	        Actions[aIdx].TonElapsed := T#0ms;
	        Actions[aIdx].PrevEnableCond := FALSE;
	    END_FOR;
	    InternalInitDone := TRUE;
	    Finished := FALSE;
	END_IF;

	Runtime.Mode := ModeReq;
	Runtime.TsPrev := Runtime.TsNow;
	Runtime.TsNow := TsNow;
	Runtime.NtpcNow := NtpcNow;
	Runtime.DateTime := Runtime.TsNow - Runtime.TsPrev;
	Runtime.Cycle := Runtime.Cycle + 1;

	IF NOT ConfigChecked THEN
	    Debug.ConfigFault := FALSE;

	    (* check steps id *)
	    FOR i := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        IF (Steps[i].Id &lt; 0) THEN
	            Debug.ConfigFault := TRUE;
	        END_IF;
	    END_FOR;

	    (* check transitions *)
	    FOR i := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
	        IF Transitions[i].Enabled THEN
	            IF (Transitions[i].SourceCount &lt; 1) OR (Transitions[i].DestCount &lt; 1) THEN
	                Debug.ConfigFault := TRUE;
	            END_IF;

	            FOR j := 0 TO Transitions[i].SourceCount-1 DO
	                srcId := Transitions[i].Sources[j];
	                IF (srcId &lt; 0) OR (srcId &gt;= Runtime.GC_MAX_STEPS) THEN
	                    Debug.ConfigFault := TRUE;
	                END_IF;
	            END_FOR;

	            FOR j := 0 TO Transitions[i].DestCount-1 DO
	                dstId := Transitions[i].Destinations[j];
	                IF (dstId &lt; 0) OR (dstId &gt;= Runtime.GC_MAX_STEPS) THEN
	                    Debug.ConfigFault := TRUE;
	                END_IF;
	            END_FOR;
	        END_IF;
	    END_FOR;

	    (* check actions *)
	    FOR i := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
	        sid := Actions[i].BoundStepId;
	        IF (sid &lt; -1) OR (sid &gt;= Runtime.GC_MAX_STEPS) THEN
	            Debug.ConfigFault := TRUE;
	        END_IF;
	    END_FOR;    

	    ConfigChecked := TRUE;
	END_IF;

	IF Debug.ConfigFault THEN
	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

	IF InitReq OR ResetAllReq THEN
	    FOR i := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        Steps[i].Active := Steps[i].IsInitial;
	        Steps[i].PrevActive := FALSE;
	        Steps[i].ActiveTime := T#0ms;
	    END_FOR;
	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
	        Actions[aIdx].Started := FALSE;
		Actions[aIdx].Finished := FALSE;
		Actions[aIdx].Out := FALSE;
	        Actions[aIdx].OnPulseDone := FALSE;
	        Actions[aIdx].OffPulseDone := FALSE;
		Actions[aIdx].EnableDone := FALSE;
	        Actions[aIdx].EnablePulseDone := FALSE;
		Actions[aIdx].TonStarted := FALSE;
	        Actions[aIdx].TonElapsed := T#0ms;
	        Actions[aIdx].PrevEnableCond := FALSE;
	    END_FOR;
	    Finished := FALSE;
	END_IF;

	IF ResetInitialReq THEN
	    FOR i := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        Steps[i].Active := Steps[i].IsInitial;
	    END_FOR;
	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
	        Actions[aIdx].Started := FALSE;
		Actions[aIdx].Finished := FALSE;
		Actions[aIdx].Out := FALSE;
	        Actions[aIdx].OnPulseDone := FALSE;
	        Actions[aIdx].OffPulseDone := FALSE;
		Actions[aIdx].EnableDone := FALSE;
	        Actions[aIdx].EnablePulseDone := FALSE;
		Actions[aIdx].TonStarted := FALSE;
	        Actions[aIdx].TonElapsed := T#0ms;
	        Actions[aIdx].PrevEnableCond := FALSE;
	    END_FOR;
	    Finished := FALSE;
	END_IF;

	IF FreezeReq OR PauseReq THEN RETURN; END_IF;
	IF (Runtime.Mode = 2) AND (NOT StepReq) THEN RETURN; END_IF; (* MANUAL *)

	(* 1) Force direct From -&gt; To *)
	IF (ForceStepFromId &gt;= 0) AND (ForceStepToId &gt;= 0) AND
	   (ForceStepFromId &lt; Runtime.GC_MAX_STEPS) AND (ForceStepToId &lt; Runtime.GC_MAX_STEPS) THEN

	    Steps[ForceStepFromId].Active := FALSE;
	    Steps[ForceStepToId].Active := TRUE;

	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO

	        sid := Actions[aIdx].BoundStepId;

	        IF (sid = ForceStepToId) THEN

	            Actions[aIdx].Started := FALSE;
		    Actions[aIdx].Finished := FALSE;
		    Actions[aIdx].Out := FALSE;
	            Actions[aIdx].OnPulseDone := FALSE;
	            Actions[aIdx].OffPulseDone := FALSE;
		    Actions[aIdx].EnableDone := FALSE;
	            Actions[aIdx].EnablePulseDone := FALSE;
		    Actions[aIdx].TonStarted := FALSE;
	            Actions[aIdx].TonElapsed := T#0ms;
	            Actions[aIdx].PrevEnableCond := FALSE;

	        END_IF;

	    END_FOR;

	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

	(* 2) Force Back: étape active -&gt; source de la transition entrante *)
	IF ForceBackReq THEN
	    doneBack := FALSE;

	    FOR sIdx := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        IF Steps[sIdx].Active AND (NOT doneBack) THEN
	            FOR tIdx := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
	                IF Transitions[tIdx].Enabled THEN
	                    isDest := FALSE;

	                    FOR k := 0 TO Transitions[tIdx].DestCount-1 DO
	                        IF Transitions[tIdx].Destinations[k] = sIdx THEN
	                            isDest := TRUE;
	                        END_IF;
	                    END_FOR;

	                    IF isDest THEN
	                        Steps[sIdx].Active := FALSE;

	                        FOR j := 0 TO Transitions[tIdx].SourceCount-1 DO
	                            srcId := Transitions[tIdx].Sources[j];
	                            IF (srcId &gt;= 0) AND (srcId &lt; Runtime.GC_MAX_STEPS) THEN
	                                Steps[srcId].Active := TRUE;
	                            END_IF;
	                        END_FOR;

	                        doneBack := TRUE;
	                        EXIT;
	                    END_IF;
	                END_IF;
	            END_FOR;
	        END_IF;
	    END_FOR;

	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO

	        sid := Actions[aIdx].BoundStepId;

	        IF (sid &gt;= 0) AND (sid &lt; Runtime.GC_MAX_STEPS) THEN

	            (* reset uniquement sur entrée réelle du step source *)
	            IF Steps[sid].Active THEN

	                Actions[aIdx].Started := FALSE;
			Actions[aIdx].Finished := FALSE;
			Actions[aIdx].Out := FALSE;
	                Actions[aIdx].OnPulseDone := FALSE;
	                Actions[aIdx].OffPulseDone := FALSE;
			Actions[aIdx].EnableDone := FALSE;
	                Actions[aIdx].EnablePulseDone := FALSE;
			Actions[aIdx].TonStarted := FALSE;
	                Actions[aIdx].TonElapsed := T#0ms;
	                Actions[aIdx].PrevEnableCond := FALSE;

	            END_IF;

	        END_IF;

	    END_FOR;

	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

	(* 3) Force Next: étape active -&gt; destination de la transition sortante *)
	IF ForceNextReq THEN
	    doneNext := FALSE;

	    FOR sIdx := 0 TO Runtime.GC_MAX_STEPS-1 DO
	        IF Steps[sIdx].Active AND (NOT doneNext) THEN
	            FOR tIdx := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
	                IF Transitions[tIdx].Enabled THEN
	                    isFromStep := FALSE;

	                    FOR j := 0 TO Transitions[tIdx].SourceCount-1 DO
	                        IF Transitions[tIdx].Sources[j] = sIdx THEN
	                            isFromStep := TRUE;
	                        END_IF;
	                    END_FOR;

	                    IF isFromStep THEN
	                        Steps[sIdx].Active := FALSE;

	                        IF Transitions[tIdx].SplitKind = 1 THEN
	                            FOR k := 0 TO Transitions[tIdx].DestCount-1 DO
	                                dstId := Transitions[tIdx].Destinations[k];
	                                IF (dstId &gt;= 0) AND (dstId &lt; Runtime.GC_MAX_STEPS) THEN
	                                    Steps[dstId].Active := TRUE;
	                                END_IF;
	                            END_FOR;
	                        ELSE
	                            dstId := Transitions[tIdx].Destinations[0];
	                            IF (dstId &gt;= 0) AND (dstId &lt; Runtime.GC_MAX_STEPS) THEN
	                                Steps[dstId].Active := TRUE;
	                            END_IF;
	                        END_IF;

	                        doneNext := TRUE;
	                        EXIT;
	                    END_IF;
	                END_IF;
	            END_FOR;
	        END_IF;
	    END_FOR;

	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO

	        sid := Actions[aIdx].BoundStepId;

	        IF (sid &gt;= 0) AND (sid &lt; Runtime.GC_MAX_STEPS) THEN

	            (* uniquement si action appartient à une étape nouvellement activée *)
	            IF Steps[sid].Active THEN

	                Actions[aIdx].Started := FALSE;
			Actions[aIdx].Finished := FALSE;
			Actions[aIdx].Out := FALSE;
	                Actions[aIdx].OnPulseDone := FALSE;
	                Actions[aIdx].OffPulseDone := FALSE;
			Actions[aIdx].EnableDone := FALSE;
			Actions[aIdx].EnablePulseDone := FALSE;
			Actions[aIdx].TonStarted := FALSE;
	                Actions[aIdx].TonElapsed := T#0ms;
	                Actions[aIdx].PrevEnableCond := FALSE;

	            END_IF;

	        END_IF;

	    END_FOR;

	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

	IF Finished THEN
	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

	(* 0 DETECTION RETOUR CYCLE INITIALE *)
	isInitState := TRUE;

	FOR i := 0 TO Runtime.GC_MAX_STEPS-1 DO
	    IF Steps[i].Active &lt;&gt; Steps[i].IsInitial THEN
	        isInitState := FALSE;
	    END_IF;
	END_FOR;

	InitPulse := isInitState AND NOT PrevInitState;
	PrevInitState := isInitState;

	IF InitPulse THEN
	    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO

	        sid := Actions[aIdx].BoundStepId;
        
	        IF (sid &gt;= 0) AND (sid &lt; Runtime.GC_MAX_STEPS) THEN
		    IF NOT (Steps[sid].IsInitial AND Actions[aIdx].Kind = 1) THEN
	                Actions[aIdx].Started := FALSE;
	                Actions[aIdx].Finished := FALSE;
	                Actions[aIdx].Out := FALSE;
	                Actions[aIdx].OnPulseDone := FALSE;
	                Actions[aIdx].OffPulseDone := FALSE;
	                Actions[aIdx].EnableDone := FALSE;
	                Actions[aIdx].EnablePulseDone := FALSE;
			Actions[aIdx].TonStarted := FALSE;
	                Actions[aIdx].TonElapsed := T#0ms;
	                Actions[aIdx].PrevEnableCond := FALSE;
		    END_IF;
		END_IF;
	    END_FOR;

	    InitPulseCount := InitPulseCount + 1;
	    SectionsAuthorized := FALSE; 
	    RETURN;
	END_IF;

END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="Main" activationCondition="SectionsAuthorized" logicCondition="standard">
			<STSource>IF pauseToReevaluateCondition THEN
	NeedToResetPause := TRUE;
END_IF;

IF NOT(pauseToReevaluateCondition) THEN

	(* 1 SCAN_TRANS *)
	Runtime.Phase := 1;
	FinalSrcOnValidatedTr := FALSE;

	FOR i := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO

	    Transitions[i].Validated := FALSE;

	    IF Transitions[i].Enabled THEN

	        allSrcActive := TRUE;
	        anySrcActive := FALSE;

	        FOR j := 0 TO Transitions[i].SourceCount-1 DO
	            srcId := Transitions[i].Sources[j];

	            IF (srcId &gt;= 0) AND (srcId &lt; Runtime.GC_MAX_STEPS) THEN

	                anySrcActive := anySrcActive OR Steps[srcId].Active;
	                allSrcActive := allSrcActive AND Steps[srcId].Active;

	            END_IF;
	        END_FOR;

	        (* =========================
	           FILTRE TEMPOREL CONDITION
	           ========================= *)

	        IF Transitions[i].Condition THEN

	            IF NOT Transitions[i].TonStarted THEN
	                Transitions[i].TonStarted := TRUE;
	                Transitions[i].TonElapsed := T#0ms;
	            END_IF;

	            Transitions[i].TonElapsed := Transitions[i].TonElapsed + Runtime.DateTime;

	            IF Transitions[i].TonElapsed &gt;= Transitions[i].ConditionTime THEN
	                Transitions[i].TimedConditionValid := TRUE;
	            END_IF;

	        ELSE

	            IF Transitions[i].ResetOnFall THEN
	                Transitions[i].TonStarted := FALSE;
	                Transitions[i].TonElapsed := T#0ms;
	                Transitions[i].TimedConditionValid := FALSE;
	            END_IF;

	        END_IF;


	        (* =========================
	           VALIDATION TRANSITION
	           ========================= *)

	        IF Transitions[i].JoinKind = 1 THEN

	            Transitions[i].Validated :=
	                allSrcActive AND
	                (
	                    Transitions[i].TimedConditionValid AND
	                    Transitions[i].Condition
	                );

		    IF NOT(allSrcActive) THEN
		        Transitions[i].TonStarted := FALSE;
		        Transitions[i].TonElapsed := T#0ms;
		        Transitions[i].TimedConditionValid := FALSE;
	    	    END_IF;

	        ELSE

	            Transitions[i].Validated :=
	                anySrcActive AND
	                (
	                    Transitions[i].TimedConditionValid AND
	                    Transitions[i].Condition
	                );

		    IF NOT(anySrcActive) THEN
		        Transitions[i].TonStarted := FALSE;
		        Transitions[i].TonElapsed := T#0ms;
		        Transitions[i].TimedConditionValid := FALSE;
	    	    END_IF;
	        END_IF;

	    END_IF;

	    (* =========================
	       FINISH DETECTION
	       ========================= *)

	    IF Transitions[i].Validated THEN

	        finalSrcOnValidatedTr := FALSE;

	        FOR j := 0 TO Transitions[i].SourceCount-1 DO

	            srcId := Transitions[i].Sources[j];

	            IF (srcId &gt;= 0) AND (srcId &lt; Runtime.GC_MAX_STEPS) THEN

	                IF Steps[srcId].Active AND Steps[srcId].IsFinal THEN
	                    finalSrcOnValidatedTr := TRUE;
	                END_IF;

	            END_IF;

	        END_FOR;

	        IF finalSrcOnValidatedTr THEN
	            Finished := TRUE;
	        END_IF;

	    END_IF;
    
	    IF NOT Transitions[i].Enabled OR NOT Transitions[i].Condition THEN
	        Transitions[i].TonStarted := FALSE;
	        Transitions[i].TonElapsed := T#0ms;
	        Transitions[i].TimedConditionValid := FALSE;
	    END_IF;

	END_FOR;

	(* 2 SNAPSHOT *)
	Runtime.Phase := 2;
	FOR i := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
	    Transitions[i].SnapshotValid := Transitions[i].Validated;
	    IF Transitions[i].Validated THEN
		    Transitions[i].TonStarted := FALSE;
		    Transitions[i].TonElapsed := T#0ms;
		    Transitions[i].TimedConditionValid := FALSE;
	    END_IF;
	END_FOR;

	(* 3 COMMIT *)
	Runtime.Phase := 3;
	FOR i := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
	    IF Transitions[i].SnapshotValid THEN
	        FOR j := 0 TO Transitions[i].SourceCount-1 DO
	            srcId := Transitions[i].Sources[j];
	            IF (srcId &gt;= 0) AND (srcId &lt; Runtime.GC_MAX_STEPS) THEN
	                Steps[srcId].Active := FALSE;
	            END_IF;
	        END_FOR;

	        IF Transitions[i].SplitKind = 1 THEN
		    howManyResets := 0;
		    pauseToReevaluateCondition := true;
	            FOR k := 0 TO Transitions[i].DestCount-1 DO
	                dstId := Transitions[i].Destinations[k];
	                IF (dstId &gt;= 0) AND (dstId &lt; Runtime.GC_MAX_STEPS) THEN
		
			    IF NOT(Steps[dstId].Active) THEN   
			        Steps[dstId].Active := TRUE; 

			        FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS - 1 DO
		                    IF Actions[aIdx].BoundStepId = dstId THEN
				        howManyResets := howManyResets + 1;
				
		                        Actions[aIdx].Finished         := FALSE;
		                        Actions[aIdx].Started          := FALSE;
		                        Actions[aIdx].Out              := FALSE;
		                        Actions[aIdx].OnPulseDone      := FALSE;
		                        Actions[aIdx].OffPulseDone     := FALSE;
		                        Actions[aIdx].EnableDone       := FALSE;
		                        Actions[aIdx].EnablePulseDone  := FALSE;
		                        Actions[aIdx].TonStarted       := FALSE;
		                        Actions[aIdx].TonElapsed       := T#0ms;
		                        Actions[aIdx].PrevEnableCond   := FALSE;
		                        Actions[aIdx].PrevOut          := FALSE;
		                    END_IF;
		                END_FOR;
			    END_IF;

			END_IF;
	            END_FOR;
	        ELSE
	            dstId := Transitions[i].Destinations[0];
	            IF (dstId &gt;= 0) AND (dstId &lt; Runtime.GC_MAX_STEPS) THEN 
	        
			IF NOT(Steps[dstId].Active) THEN
			    howManyResets := 0;
			    pauseToReevaluateCondition := true;
			    Steps[dstId].Active := TRUE;
		            FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS - 1 DO
		                IF Actions[aIdx].BoundStepId = dstId THEN
				    howManyResets := howManyResets + 1;
		                    Actions[aIdx].Finished         := FALSE;
		                    Actions[aIdx].Started          := FALSE;
	        	            Actions[aIdx].Out              := FALSE;
		                    Actions[aIdx].OnPulseDone      := FALSE;
		                    Actions[aIdx].OffPulseDone     := FALSE;
		                    Actions[aIdx].EnableDone       := FALSE;
		                    Actions[aIdx].EnablePulseDone  := FALSE;
		                    Actions[aIdx].TonStarted       := FALSE;
		                    Actions[aIdx].TonElapsed       := T#0ms;
	        	            Actions[aIdx].PrevEnableCond   := FALSE;
		                    Actions[aIdx].PrevOut          := FALSE;
		                END_IF;
		            END_FOR;
			END_IF;

	            END_IF;
	        END_IF;

	        Debug.LastTransitionFiredId := Transitions[i].Id;
	        Debug.TotalTransitionsFired := Debug.TotalTransitionsFired + 1;
	    END_IF;
	END_FOR;

END_IF;

IF NeedToResetPause THEN
	NeedToResetPause := FALSE;
	pauseToReevaluateCondition := FALSE;
END_IF;

IF NOT(pauseToReevaluateCondition) THEN

	(* 4 UPDATE_STEPS *)
	Runtime.Phase := 4;
	Debug.ActiveStepCount := 0;
	FOR i := 0 TO Runtime.GC_MAX_STEPS - 1 DO

	    Steps[i].Rising  := Steps[i].Active AND (NOT Steps[i].PrevActive);
	    Steps[i].Falling := (NOT Steps[i].Active) AND Steps[i].PrevActive;

	    IF Steps[i].Active THEN
	        Steps[i].ActiveTime   := Steps[i].ActiveTime + Runtime.DateTime;
	        Steps[i].InactiveTime := T#0ms;
	        Debug.ActiveStepCount := Debug.ActiveStepCount + 1;
	    ELSE
	        Steps[i].InactiveTime := Steps[i].InactiveTime + Runtime.DateTime;
	        Steps[i].ActiveTime   := T#0ms;
	    END_IF;

	    Steps[i].PrevActive := Steps[i].Active;

	END_FOR;

	(* 5 SCAN_ACTIONS *)
	Runtime.Phase := 5;
	FOR i := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
	    Actions[i].PrevOut := Actions[i].Out;
	    Actions[i].Out := FALSE;

	    sid := Actions[i].BoundStepId;

	    IF (sid &gt;= 0) AND (sid &lt; Runtime.GC_MAX_STEPS) THEN
        
		(* démarrage sur front montant de la condition *)
	        IF Steps[sid].Active THEN

	            IF Actions[i].EnableCond AND (NOT Actions[i].PrevEnableCond) THEN
	                Actions[i].TonStarted := TRUE;
	                Actions[i].TonElapsed := T#0ms;
	            END_IF;

	        END_IF;

		IF Actions[i].Kind &lt;&gt; 11 THEN
		        IF Actions[i].EnableCond AND Steps[sid].Active AND NOT(Actions[i].Finished) THEN
		            IF NOT Actions[i].EnableDone THEN
		                Actions[i].EnableDone := TRUE;
		                Actions[i].TonElapsed := T#0ms;
		            END_IF;
		            Actions[i].TonElapsed := Actions[i].TonElapsed + Runtime.DateTime;
		        ELSE
		            Actions[i].EnableDone := FALSE;
		            Actions[i].TonElapsed := T#0ms;
		            Actions[i].EnablePulseDone := FALSE;
		        END_IF;
		END_IF;

		IF Actions[i].Kind = 11 THEN
		        IF Actions[i].TonStarted AND NOT(Actions[i].Finished) THEN

		            Actions[i].TonElapsed := Actions[i].TonElapsed + Runtime.DateTime;

		            IF Actions[i].TonElapsed &gt;= Actions[i].Delay THEN
		                Actions[i].TonStarted := FALSE;
		                Actions[i].TonElapsed := T#0ms;
		            END_IF;

		        END_IF;
		END_IF;

	        IF Actions[i].EnableCond THEN

	            IF Steps[sid].Active THEN
	                Actions[i].OffPulseDone := FALSE;
	            END_IF;
    
	            IF Steps[sid].Falling THEN
	                Actions[i].OnPulseDone := FALSE;
	            END_IF;

	            IF Actions[i].Kind = 0 THEN
	                Actions[i].Out := Steps[sid].Active;

	            ELSIF Actions[i].Kind = 1 THEN
	                Actions[i].Out := Steps[sid].Rising;

	            ELSIF Actions[i].Kind = 2 THEN
	                Actions[i].Out := Steps[sid].Active AND (Steps[sid].ActiveTime &gt;= Actions[i].Delay);

	            ELSIF Actions[i].Kind = 3 THEN
	                IF Steps[sid].Active AND (NOT Actions[i].OnPulseDone) AND (Steps[sid].ActiveTime &gt;= Actions[i].Delay) THEN
	                    Actions[i].Out := TRUE;
	                    Actions[i].OnPulseDone := TRUE;
	            END_IF;

	            ELSIF Actions[i].Kind = 4 THEN
	                Actions[i].Out := Steps[sid].Active AND (Steps[sid].ActiveTime &lt;= Actions[i].Delay);

	            ELSIF Actions[i].Kind = 5 THEN
	                Actions[i].Out := Steps[sid].Falling;

	            ELSIF Actions[i].Kind = 6 THEN
	                IF (NOT Steps[sid].Active) AND (NOT Actions[i].OffPulseDone) AND (Steps[sid].InactiveTime &gt;= Actions[i].Delay) THEN
	                    Actions[i].Out := TRUE;
	                    Actions[i].OffPulseDone := TRUE;
	                END_IF;

	            ELSIF Actions[i].Kind = 7 THEN
	                Actions[i].Out := (NOT Steps[sid].Active) AND (Steps[sid].InactiveTime &gt; T#0ms) AND (Steps[sid].InactiveTime &lt;= Actions[i].Delay);
	            ELSIF Actions[i].Kind = 8 THEN
	                Actions[i].Out :=
	                    Steps[sid].Active AND
	                    (Actions[i].TonElapsed &gt;= Actions[i].Delay);
		    ELSIF Actions[i].Kind = 9 THEN
	                IF Steps[sid].Active THEN
	                    IF (NOT Actions[i].EnablePulseDone) AND (Actions[i].TonElapsed &gt;= Actions[i].Delay) THEN

	                        Actions[i].Out := TRUE;
	                        Actions[i].EnablePulseDone := TRUE;

	                    END_IF;
	                END_IF;
	            ELSIF Actions[i].Kind = 10 THEN
	                Actions[i].Out :=
	                    Steps[sid].Active AND
	                    (Actions[i].TonElapsed &lt;= Actions[i].Delay);
	            END_IF;
	        END_IF;

	        IF Actions[i].Kind = 11 THEN
	            Actions[i].Out := Actions[i].TonStarted;
	        END_IF;

	        IF (NOT(Actions[i].Started) AND Actions[i].Out) THEN Actions[i].Started := TRUE; END_IF;

	        IF Actions[i].Started AND NOT(Actions[i].Finished) THEN
	            CASE Actions[i].Kind OF

	                0: Actions[i].Finished := NOT Steps[sid].Active;
	                1: Actions[i].Finished := Steps[sid].Rising;
	                2: Actions[i].Finished := Steps[sid].Active AND (Steps[sid].ActiveTime &gt;= Actions[i].Delay);
	                3: Actions[i].Finished := Actions[i].OnPulseDone;
	                4: Actions[i].Finished := Steps[sid].Active AND (Steps[sid].ActiveTime &gt; Actions[i].Delay);
	                5: Actions[i].Finished := Steps[sid].Falling;
	                6: Actions[i].Finished := Actions[i].OffPulseDone;
	                7: Actions[i].Finished := (NOT Steps[sid].Active) AND (Steps[sid].InactiveTime &gt; Actions[i].Delay);
		        8: Actions[i].Finished := (NOT Steps[sid].Active);
	                9: Actions[i].Finished := Actions[i].EnablePulseDone;
		        10: Actions[i].Finished := (NOT Actions[i].EnableCond) OR (Actions[i].TonElapsed &gt; Actions[i].Delay) OR (NOT Steps[sid].Active);
	                11: Actions[i].Finished := NOT Actions[i].TonStarted;

		    END_CASE;
	        END_IF;

		Actions[i].PrevEnableCond := Actions[i].EnableCond;
	    END_IF;
	END_FOR;

END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="Debug">
			<STSource>(* 5b HISTO ETAPES ACTIVES (glissant sur MAX_HIST) *)
activeStepQty := 0;
firstStepId := -1;
firstStepName := '';

FOR i := 0 TO Runtime.GC_MAX_STEPS - 1 DO
    IF Steps[i].Rising THEN
        activeStepQty := activeStepQty + 1;
        IF firstStepId = -1 THEN
            firstStepId := Steps[i].Id;
            firstStepName := Steps[i].Name;
        END_IF;
    END_IF;
END_FOR;

IF activeStepQty &gt; 0 THEN

    FOR h := Runtime.GC_MAX_HIST - 1 TO 1 BY -1 DO
        Debug.HistSteps[h].Line := Debug.HistSteps[h - 1].Line;
	Debug.HistSteps[h].NtpcNow := Debug.HistSteps[h - 1].NtpcNow;
    END_FOR;
    Debug.HistSteps[0].Line := firstStepName;
    Debug.HistSteps[0].NtpcNow := Runtime.NtpcNow;

    IF HistFill &lt; Runtime.GC_MAX_HIST THEN
        HistFill := HistFill + 1;
    END_IF;
END_IF;

FOR i := 0 TO Runtime.GC_MAX_ACTIONS - 1 DO

    IF (Actions[i].Out AND NOT Actions[i].PrevOut) THEN

        FOR h := Runtime.GC_MAX_HIST - 1 TO 1 BY -1 DO
            Debug.HistActions[h].Line := Debug.HistActions[h-1].Line;
            Debug.HistActions[h].NtpcNow := Debug.HistActions[h-1].NtpcNow;
        END_FOR;

        IF Actions[i].Out AND NOT Actions[i].PrevOut THEN
            Debug.HistActions[0].Line := '1';
        END_IF;

        stepIdStr := INT_TO_STRING(Steps[Actions[i].BoundStepId].Id);
        actionIdStr := INT_TO_STRING(Actions[i].Id);

        IF LEFT_INT(stepIdStr, 1) = '+' THEN
            stepIdStr := RIGHT_INT(stepIdStr, LEN_INT(stepIdStr) - 1);
        END_IF;

        WHILE (LEN_INT(stepIdStr) &gt; 1) AND (LEFT_INT(stepIdStr, 1) = '0') DO
            stepIdStr := RIGHT_INT(stepIdStr, LEN_INT(stepIdStr) - 1);
        END_WHILE;

        IF LEFT_INT(actionIdStr, 1) = '+' THEN
            actionIdStr := RIGHT_INT(actionIdStr, LEN_INT(actionIdStr) - 1);
        END_IF;

        WHILE (LEN_INT(actionIdStr) &gt; 1) AND (LEFT_INT(actionIdStr, 1) = '0') DO
            actionIdStr := RIGHT_INT(actionIdStr, LEN_INT(actionIdStr) - 1);
        END_WHILE;

        Debug.HistActions[0].Line :=
            CONCAT_STR(
                CONCAT_STR(
                    CONCAT_STR('[',
                        CONCAT_STR(Steps[Actions[i].BoundStepId].Name, ':')
                    ),
                    CONCAT_STR(stepIdStr, ']')
                ),
                CONCAT_STR(
                    Debug.HistActions[0].Line,
                    CONCAT_STR('-&gt;',
                        CONCAT_STR(
                            CONCAT_STR(Actions[i].Name, ':'),
                            actionIdStr
                        )
                    )
                )
            );

        Debug.HistActions[0].NtpcNow := Runtime.NtpcNow;

    END_IF;

END_FOR;

(* =========================================================
   DEBUG FOCUS : 1 seule étape active affichée
   ========================================================= *)

Debug.NoActiveStepFault := (Debug.ActiveStepCount = 0);

(* Reset focus *)
Debug.StepFocus.StepId := -1;
Debug.StepFocus.StepName := '';

Debug.StepFocus.Kind1Line := 'K1 : ';
Debug.StepFocus.Kind2Line := 'K2 : ';
Debug.StepFocus.Kind3Line := 'K3 : ';
Debug.StepFocus.Kind4Line := 'K4 : ';
Debug.StepFocus.Kind5Line := 'K5 : ';
Debug.StepFocus.Kind6Line := 'K6 : ';
Debug.StepFocus.Kind7Line := 'K7 : ';
Debug.StepFocus.Kind8Line := 'K8 : ';
Debug.StepFocus.Kind9Line := 'K9 : ';
Debug.StepFocus.Kind10Line := 'K10 : ';
Debug.StepFocus.Kind11Line := 'K11 : ';
Debug.StepFocus.TransitionsLine := 'TRS : ';

focusStep := -1;

(* première étape active *)
FOR sIdx := 0 TO Runtime.GC_MAX_STEPS-1 DO
    IF Steps[sIdx].Active THEN
        focusStep := sIdx;
    END_IF;
END_FOR;

IF focusStep &lt;&gt; -1 THEN
    Debug.StepFocus.StepId := Steps[focusStep].Id;
    Debug.StepFocus.StepName := Steps[focusStep].Name;

    (* Actions de cette étape, groupées par Kind *)
    FOR aIdx := 0 TO Runtime.GC_MAX_ACTIONS-1 DO
        IF Actions[aIdx].BoundStepId = focusStep THEN

            IF Actions[aIdx].Kind = 1 THEN
                Debug.StepFocus.Kind1Line := CONCAT_STR(Debug.StepFocus.Kind1Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind1Line := CONCAT_STR(Debug.StepFocus.Kind1Line, ', ');

            ELSIF Actions[aIdx].Kind = 2 THEN
                Debug.StepFocus.Kind2Line := CONCAT_STR(Debug.StepFocus.Kind2Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind2Line := CONCAT_STR(Debug.StepFocus.Kind2Line, '), ');

            ELSIF Actions[aIdx].Kind = 3 THEN
                Debug.StepFocus.Kind3Line := CONCAT_STR(Debug.StepFocus.Kind3Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind3Line := CONCAT_STR(Debug.StepFocus.Kind3Line, ', ');

            ELSIF Actions[aIdx].Kind = 4 THEN
                Debug.StepFocus.Kind4Line := CONCAT_STR(Debug.StepFocus.Kind4Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind4Line := CONCAT_STR(Debug.StepFocus.Kind4Line, '), ');

            ELSIF Actions[aIdx].Kind = 5 THEN
                Debug.StepFocus.Kind5Line := CONCAT_STR(Debug.StepFocus.Kind5Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind5Line := CONCAT_STR(Debug.StepFocus.Kind5Line, ', ');

            ELSIF Actions[aIdx].Kind = 6 THEN
                Debug.StepFocus.Kind6Line := CONCAT_STR(Debug.StepFocus.Kind6Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind6Line := CONCAT_STR(Debug.StepFocus.Kind6Line, '), ');

            ELSIF Actions[aIdx].Kind = 7 THEN
                Debug.StepFocus.Kind7Line := CONCAT_STR(Debug.StepFocus.Kind7Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind7Line := CONCAT_STR(Debug.StepFocus.Kind7Line, '), ');

            ELSIF Actions[aIdx].Kind = 8 THEN
                Debug.StepFocus.Kind8Line := CONCAT_STR(Debug.StepFocus.Kind8Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind8Line := CONCAT_STR(Debug.StepFocus.Kind8Line, '), ');

            ELSIF Actions[aIdx].Kind = 9 THEN
                Debug.StepFocus.Kind9Line := CONCAT_STR(Debug.StepFocus.Kind9Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind9Line := CONCAT_STR(Debug.StepFocus.Kind9Line, '), ');

            ELSIF Actions[aIdx].Kind = 10 THEN
                Debug.StepFocus.Kind10Line := CONCAT_STR(Debug.StepFocus.Kind10Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind10Line := CONCAT_STR(Debug.StepFocus.Kind10Line, '), ');

	    ELSIF Actions[aIdx].Kind = 11 THEN
                Debug.StepFocus.Kind11Line := CONCAT_STR(Debug.StepFocus.Kind11Line, Actions[aIdx].Name);
                Debug.StepFocus.Kind11Line := CONCAT_STR(Debug.StepFocus.Kind11Line, '), ');
            END_IF;

        END_IF;
    END_FOR;

    (* Transitions sortantes + destination + CondText *)
    FOR tIdx := 0 TO Runtime.GC_MAX_TRANSITIONS-1 DO
        isFromStep := FALSE;

        IF Transitions[tIdx].Enabled THEN
            FOR j := 0 TO Transitions[tIdx].SourceCount-1 DO
                IF Transitions[tIdx].Sources[j] = focusStep THEN
                    isFromStep := TRUE;
                END_IF;
            END_FOR;

            IF isFromStep THEN
                IF (Transitions[tIdx].Destinations[0] &gt;= 0) AND (Transitions[tIdx].Destinations[0] &lt; Runtime.GC_MAX_STEPS) THEN
                    srcId := Transitions[tIdx].Sources[0];
		    dstId := Transitions[tIdx].Destinations[0];

                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, 'TR{');
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, Steps[srcId].Name);
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, '-&gt;');
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, Steps[dstId].Name);
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, '}');
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, ' [');
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, Transitions[tIdx].CondText);
                    Debug.StepFocus.TransitionsLine := CONCAT_STR(Debug.StepFocus.TransitionsLine, '] ');
                END_IF;
            END_IF;
        END_IF;
    END_FOR;
END_IF;

Runtime.Phase := 0;
Debug.CurrentCycle := Runtime.Cycle;
Debug.Mode := Runtime.Mode;
Debug.Phase := Runtime.Phase;

</STSource>
		</FBProgram>
	</FBSource>
