			</variables>
			<variables name="DEBUG_ACT3_SURP_A" typeName="WORD">
				<attribute name="EffectiveParameter" value="DEBUG_ACT3_SURP[0]"></attribute>
			</variables>
			<variables name="DEBUG_NOM_ETAPE_SURP_A" typeName="WORD">
