			<variables name="Ctrl_ChangementB" typeName="ST_GC_CTRL"></variables>
			<variables name="Gc_ChangementB" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="Steps_ChangementB" typeName="ARRAY[0..27] OF ST_GC_Step"></variables>
			<variables name="Trans_ChangementB" typeName="ARRAY[0..27] OF ST_GC_Transition"></variables>
			<variables name="Acts_ChangementB" typeName="ARRAY[0..27] OF ST_GC_Action"></variables>
			<variables name="InitDone_ChangementB" typeName="EBOOL"></variables>
			<variables name="Gc_DetoxalB" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="Gc_PurgeB" typeName="DFB_GRAFCETENGINE"></variables>
			<variables name="Gc_PompageB" typeName="DFB_GRAFCETENGINE"></variables>
