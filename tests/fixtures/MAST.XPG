	<FBSource nameOfFBType="CAPTEUR" version="0.02" dateTime="dt#2026-05-23-15:42:27">
		<attribute name="TypeCodeCheckSumString" value="8A90"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="740C"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="IW_Raw" typeName="REAL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Raw_Min" typeName="REAL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Raw_Max" typeName="REAL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="Eng_Min" typeName="REAL">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="Eng_Max" typeName="REAL">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="SimEnable" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="SimValue" typeName="REAL">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="DeadBand" typeName="REAL">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
		</inputParameters>
		<publicLocalVariables>
			<variables name="ScaledValue" typeName="REAL"></variables>
			<variables name="AverageValue" typeName="REAL"></variables>
			<variables name="StableValue" typeName="REAL"></variables>
			<variables name="RawInput" typeName="REAL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="Index" typeName="INT"></variables>
			<variables name="i" typeName="INT"></variables>
			<variables name="Buffer" typeName="ARRAY[0..9] OF REAL"></variables>
			<variables name="Sum" typeName="REAL"></variables>
			<variables name="WorkingValue" typeName="REAL"></variables>
			<variables name="FirstScan" typeName="BOOL"></variables>
		</privateLocalVariables>
		<FBProgram name="main">
			<STSource>(* ===================================================== *)
(* ACQUISITION / SIMULATION *)
(* ===================================================== *)

IF SimEnable THEN

    RawInput := SimValue;

ELSE

    RawInput := IW_Raw;

END_IF;

(* ===================================================== *)
(* MISE A L'ECHELLE *)
(* ===================================================== *)

IF Raw_Max &lt;&gt; Raw_Min THEN

    WorkingValue :=
        ((RawInput - Raw_Min)
        * (Eng_Max - Eng_Min)
        / (Raw_Max - Raw_Min))
        + Eng_Min;

ELSE

    WorkingValue := 0.0;

END_IF;

ScaledValue := WorkingValue;

(* ===================================================== *)
(* INITIALISATION *)
(* ===================================================== *)

IF FirstScan THEN

    FOR i := 0 TO 9 DO

        Buffer[i] := WorkingValue;

    END_FOR;

    Sum := WorkingValue * 10.0;

    StableValue := WorkingValue;

    FirstScan := FALSE;

END_IF;

(* ===================================================== *)
(* MOYENNE GLISSANTE *)
(* ===================================================== *)

(* Retire ancienne valeur *)
Sum := Sum - Buffer[Index];

(* Ajoute nouvelle valeur *)
Buffer[Index] := WorkingValue;

Sum := Sum + Buffer[Index];

(* Calcul moyenne *)
AverageValue := Sum / 10.0;

(* Incrémente index *)
Index := Index + 1;

IF Index &gt; 9 THEN
    Index := 0;
END_IF;

(* ===================================================== *)
(* DEADBAND *)
(* ===================================================== *)

IF ABS(AverageValue - StableValue) &gt;= DeadBand THEN

    StableValue := AverageValue;

END_IF;
</STSource>
		</FBProgram>
	</FBSource>
