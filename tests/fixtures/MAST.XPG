	DEBUG_POMPAGE_0 := 2;
	DEBUG_HELIUM_0 := 2;
	DEBUG_CHGT := 2;
	DEBUG_DETOXAL_1 := 2;
	DEBUG_PURGE_1 := 1;
	DEBUG_POMPAGE_1 := 0;
	DEBUG_HELIUM_1 := 0;

	index_purge_B := 1;
	index_pompage_B := 1;
END_IF;

IF Acts_ChangementB[20].Out THEN
