// =============================================================================
//  outils/web/compat/future - 1.12.31 : <future> pour la page web (un seul fil)
// -----------------------------------------------------------------------------
//  std::async / std::future servent, dans l'application, a lancer un travail en
//  fond (le scan IP, l'outil Modbus, l'import). Rien de cela n'est compile pour
//  la page. Ce fichier existe pour que les rares en-tetes qui nomment un
//  std::future comme membre se compilent ; s'en servir reellement est une erreur
//  a l'edition des liens.
// =============================================================================
#ifndef XPG_WEB_COMPAT_FUTURE
#define XPG_WEB_COMPAT_FUTURE

#include <chrono>

namespace std {

enum class future_status { ready, timeout, deferred };
enum class launch { async = 1, deferred = 2 };

template <class T>
class future {
public:
    future() noexcept = default;
    future(future&&) noexcept = default;
    future& operator=(future&&) noexcept = default;
    future(const future&) = delete;
    future& operator=(const future&) = delete;
    [[nodiscard]] bool valid() const noexcept { return false; }
    T get();                                  // non defini : ne pas s'en servir sur la page
    void wait() const {}
    template <class Rep, class Period>
    future_status wait_for(const chrono::duration<Rep, Period>&) const { return future_status::timeout; }
    template <class Clock, class Duration>
    future_status wait_until(const chrono::time_point<Clock, Duration>&) const { return future_status::timeout; }
};

template <class F, class... Args>
auto async(F&&, Args&&...);                    // non defini : erreur a l'edition des liens
template <class F, class... Args>
auto async(launch, F&&, Args&&...);            // idem

} // namespace std

#endif
