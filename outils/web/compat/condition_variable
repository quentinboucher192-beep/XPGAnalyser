// =============================================================================
//  outils/web/compat/condition_variable - 1.12.31 : pour la page web (un seul fil)
// -----------------------------------------------------------------------------
//  Un seul fil sur la page : personne d'autre ne peut reveiller une attente, donc
//  attendre n'aurait pas de sens. Les rares boucles du moteur qui attendent une
//  condition (la liaison Modbus sur son fil, le passage de main d'un script
//  detache) sont REECRITES pour la page (src/web) et ne se servent pas de cette
//  variable. Celle-ci existe pour que les en-tetes qui la declarent comme membre
//  (hmi::comm::Link, modbus::Server...) se compilent ; ses attentes rendent la
//  main tout de suite (jamais de blocage).
// =============================================================================
#ifndef XPG_WEB_COMPAT_CONDITION_VARIABLE
#define XPG_WEB_COMPAT_CONDITION_VARIABLE

#include <chrono>
#include <mutex>

namespace std {

enum class cv_status { no_timeout, timeout };

class condition_variable {
public:
    condition_variable() noexcept = default;
    condition_variable(const condition_variable&) = delete;
    condition_variable& operator=(const condition_variable&) = delete;

    void notify_one() noexcept {}
    void notify_all() noexcept {}

    template <class Lock>
    void wait(Lock&) {}
    template <class Lock, class Pred>
    void wait(Lock&, Pred pred) { (void)pred; }     // la page ne bloque pas : on rend la main

    template <class Lock, class Rep, class Period>
    cv_status wait_for(Lock&, const chrono::duration<Rep, Period>&) { return cv_status::timeout; }
    template <class Lock, class Rep, class Period, class Pred>
    bool wait_for(Lock&, const chrono::duration<Rep, Period>&, Pred pred) { return static_cast<bool>(pred()); }

    template <class Lock, class Clock, class Duration>
    cv_status wait_until(Lock&, const chrono::time_point<Clock, Duration>&) { return cv_status::timeout; }
    template <class Lock, class Clock, class Duration, class Pred>
    bool wait_until(Lock&, const chrono::time_point<Clock, Duration>&, Pred pred) { return static_cast<bool>(pred()); }
};

using condition_variable_any = condition_variable;

} // namespace std

#endif
