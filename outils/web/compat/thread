// =============================================================================
//  outils/web/compat/thread - 1.12.31 : <thread> pour la page web (un seul fil)
// -----------------------------------------------------------------------------
//  La libc++ wasm32-wasi d'ici refuse <thread> (un #error : pas de fils). La page
//  web n'a qu'un fil : tout avance a chaque image. Les parties du moteur qui
//  lancaient un fil (la liaison Modbus, un script detache, le serveur de
//  demonstration) sont REECRITES pour la page (src/web) : elles n'en creent plus.
//  Ce <thread> donne un std::thread vide (jamais demarre : joinable() faux) pour
//  que les en-tetes qui en declarent un comme membre se compilent. Construire un
//  std::thread avec une fonction est une ERREUR a l'edition des liens (un symbole
//  absent) : rien sur la page ne doit en creer un.
// =============================================================================
#ifndef XPG_WEB_COMPAT_THREAD
#define XPG_WEB_COMPAT_THREAD

#include <chrono>
#include <cstddef>

namespace std {

class thread {
public:
    class id {
    public:
        id() noexcept = default;
        explicit id(unsigned long v) noexcept : v_(v) {}
        friend bool operator==(id a, id b) noexcept { return a.v_ == b.v_; }
        friend bool operator!=(id a, id b) noexcept { return a.v_ != b.v_; }
        friend bool operator<(id a, id b) noexcept { return a.v_ < b.v_; }
    private:
        unsigned long v_{0};
    };

    using native_handle_type = void*;

    thread() noexcept = default;
    // Un fil ne tourne pas sur la page (un seul fil). Le constructeur NE LANCE RIEN
    // et ne garde pas la fonction : le fil reste "non demarre" (joinable() faux).
    // Les en-tetes qui ecrivent "thread_ = std::thread([]{ boucle(); })" (la liaison
    // Modbus, le serveur de demonstration) se compilent et se lient donc ; leur
    // boucle ne part jamais - la page les fait avancer elle-meme, image par image.
    template <class F, class... Args>
    explicit thread(F&&, Args&&...) noexcept {}
    thread(thread&& o) noexcept : id_(o.id_) { o.id_ = id{}; }
    thread& operator=(thread&& o) noexcept { id_ = o.id_; o.id_ = id{}; return *this; }
    thread(const thread&) = delete;
    thread& operator=(const thread&) = delete;
    ~thread() = default;

    [[nodiscard]] bool joinable() const noexcept { return false; }
    void join() {}
    void detach() {}
    [[nodiscard]] id get_id() const noexcept { return id_; }
    [[nodiscard]] native_handle_type native_handle() { return nullptr; }
    static unsigned hardware_concurrency() noexcept { return 1; }

private:
    id id_{};
};

namespace this_thread {
inline thread::id get_id() noexcept { return thread::id{1}; }
inline void yield() noexcept {}
template <class Rep, class Period>
inline void sleep_for(const chrono::duration<Rep, Period>&) noexcept {}
template <class Clock, class Duration>
inline void sleep_until(const chrono::time_point<Clock, Duration>&) noexcept {}
} // namespace this_thread

} // namespace std

#endif
